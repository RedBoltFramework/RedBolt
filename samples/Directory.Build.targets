<Project>
  <Import Project="$(MSBuildThisFileDirectory)../Directory.Build.targets" />

  <ItemGroup Condition="'$(RedBoltPlatform)' == 'linux-gcc-x64-dll'">
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt.Platform.Linux/RedBolt.Platform.Linux.csproj" />
  </ItemGroup>

  <Target Name="RedBoltKeepSharedAssembliesInParent"
          BeforeTargets="_CopyFilesMarkedCopyLocal"
          Condition="'$(RedBoltPlatform)' == 'linux-gcc-x64-dll'">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
                               Condition="$([System.String]::Copy('%(Filename)').StartsWith('RedBolt')) or '%(Filename)' == 'SharpCpp.Support'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Compile Include="$(RedBoltRoot)/src/RedBolt/GlobalAliases.cs"
             Link="GlobalAliases.cs"
             Visible="false" />
  </ItemGroup>
</Project>
