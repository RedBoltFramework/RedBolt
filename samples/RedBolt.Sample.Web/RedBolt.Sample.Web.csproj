<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <EmccExtraLDFlags>-sFULL_ES3 -sDEFAULT_LIBRARY_FUNCS_TO_INCLUDE=$dynCall</EmccExtraLDFlags>
    <EmccLinkOptimizationFlag>-O0</EmccLinkOptimizationFlag>
    <PublishTrimmed>false</PublishTrimmed>
    <WasmBuildNative>true</WasmBuildNative>
    <WasmEnableThreads>false</WasmEnableThreads>
    <WasmNativeStrip>false</WasmNativeStrip>
    <WasmRunWasmOpt>false</WasmRunWasmOpt>
    <RedBoltWebEngineArchive Condition="'$(RedBoltWebEngineArchive)' == ''">$(RedBoltNativeBuildDir)/lib/Release/wasm/RedBolt.Native.a</RedBoltWebEngineArchive>
    <RedBoltWebResourcesManifest Condition="'$(RedBoltWebResourcesManifest)' == ''">$(RedBoltNativeBuildDir)/generated/web/resources.manifest.json</RedBoltWebResourcesManifest>
  </PropertyGroup>

  <ItemGroup>
    <WasmOptConfigurationFlags Include="--enable-threads" />
    <NativeFileReference Include="$(RedBoltWebEngineArchive)" />
    <ProjectReference Include="../../src/RedBolt/RedBolt.csproj"
                      RedBoltProperties="Configuration=$(Configuration)" />
    <ProjectReference Include="../../src/RedBolt.Platform.Web/RedBolt.Platform.Web.csproj"
                      RedBoltProperties="Configuration=$(Configuration)" />
    <ProjectReference Include="../../src/RedBolt.DearImGui/RedBolt.DearImGui.csproj"
                      RedBoltProperties="Configuration=$(Configuration)" />
    <ProjectReference Include="../../native/RedBolt.Native/RedBolt.Native.Web.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      RedBoltProperties="Configuration=$(Configuration);RedBoltPlatform=web-emscripten-wasm;RedBoltNativePreset=web-emscripten-wasm" />
    <Compile Include="../RedBolt.Sample.MultipleViewports/Program.cs" Link="MultipleViewportsApplication.cs" />
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj"
                      PrivateAssets="all"
                      RedBoltProperties="$(RedBoltSharpCppManagedProperties)" />
  </ItemGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);REDBOLT_WEB_SAMPLE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="../../bin/CoreData/**/*" Link="wwwroot/resources/CoreData/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../bin/Data/**/*" Link="wwwroot/resources/Data/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RedBoltWebResourcesManifest)" Link="wwwroot/resources.manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
