{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-x64",
      "displayName": "Linux GCC x64 DLL",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/native/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "browser-wasm",
      "displayName": "Web Emscripten WASM",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/Toolchains/DotNetEmscripten.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-x64-debug",
      "configurePreset": "linux-x64",
      "configuration": "Debug",
      "targets": [
        "redbolt-native-all"
      ]
    },
    {
      "name": "linux-x64-release",
      "configurePreset": "linux-x64",
      "configuration": "Release",
      "targets": [
        "redbolt-native-all"
      ]
    },
    {
      "name": "browser-wasm-release",
      "configurePreset": "browser-wasm",
      "targets": [
        "redbolt-wasm-native"
      ]
    }
  ]
}
