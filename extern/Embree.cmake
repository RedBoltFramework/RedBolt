set(EMBREE_ISPC_SUPPORT OFF CACHE BOOL "Disable Embree ISPC support" FORCE)
set(EMBREE_TUTORIALS OFF CACHE BOOL "Disable Embree tutorials" FORCE)
set(EMBREE_STATIC_LIB ON CACHE BOOL "Build Embree statically" FORCE)
set(EMBREE_TASKING_SYSTEM "INTERNAL" CACHE STRING "Use Embree internal tasking" FORCE)
set(EMBREE_LIBRARY_NAME "embree" CACHE STRING "Embree library name" FORCE)
set(EMBREE_MAX_ISA "NONE" CACHE STRING "Build portable Embree binaries" FORCE)
set(EMBREE_RAY_MASK ON CACHE BOOL "Enable Embree ray masks" FORCE)
set(EMBREE_FILTER_FUNCTION ON CACHE BOOL "Enable Embree filter functions" FORCE)
set(EMBREE_RAY_PACKETS OFF CACHE BOOL "Disable unused Embree ray packets" FORCE)
set(EMBREE_ISA_SSE2 ON CACHE BOOL "Enable Embree SSE2" FORCE)
set(EMBREE_ISA_SSE42 OFF CACHE BOOL "Disable Embree SSE4.2" FORCE)
set(EMBREE_ISA_AVX OFF CACHE BOOL "Disable Embree AVX" FORCE)
set(EMBREE_ISA_AVX2 OFF CACHE BOOL "Disable Embree AVX2" FORCE)
set(EMBREE_ISA_AVX512 OFF CACHE BOOL "Disable Embree AVX512" FORCE)
set(EMBREE_GEOMETRY_CURVE OFF CACHE BOOL "Disable unused Embree curves" FORCE)
set(EMBREE_GEOMETRY_GRID OFF CACHE BOOL "Disable unused Embree grids" FORCE)
set(EMBREE_GEOMETRY_INSTANCE OFF CACHE BOOL "Disable unused Embree instances" FORCE)
set(EMBREE_GEOMETRY_INSTANCE_ARRAY OFF CACHE BOOL "Disable unused Embree instance arrays" FORCE)
set(EMBREE_GEOMETRY_POINT OFF CACHE BOOL "Disable unused Embree points" FORCE)
set(EMBREE_GEOMETRY_QUAD OFF CACHE BOOL "Disable unused Embree quads" FORCE)
set(EMBREE_GEOMETRY_SUBDIVISION OFF CACHE BOOL "Disable unused Embree subdivisions" FORCE)
set(EMBREE_GEOMETRY_USER OFF CACHE BOOL "Disable unused Embree user geometry" FORCE)
set(EMBREE_API_NAMESPACE "" CACHE STRING "Use the Embree C API namespace" FORCE)
set(EMBREE_CMAKEEXPORT_DIR "${CMAKE_INSTALL_LIBDIR}" CACHE STRING "Embree CMake export directory" FORCE)

CPMAddPackage(
    NAME Embree
    GIT_REPOSITORY https://github.com/RenderKit/embree.git
    GIT_TAG v4.4.1
    CUSTOM_CACHE_KEY "."
    EXCLUDE_FROM_ALL YES)
set(REDBOLT_EMBREE_SOURCE_ROOT "${Embree_SOURCE_DIR}" CACHE INTERNAL "Embree source root")
redbolt_require_path("${REDBOLT_EMBREE_SOURCE_ROOT}/CMakeLists.txt" "Embree build")
if(MINGW)
    foreach(_redbolt_embree_target IN ITEMS embree lexers math simd sys tasking)
        target_compile_definitions(${_redbolt_embree_target} PRIVATE _USE_MATH_DEFINES)
    endforeach()
endif()
set_target_properties(embree PROPERTIES POSITION_INDEPENDENT_CODE ON)
set(REDBOLT_EMBREE_INCLUDE_DIR "${REDBOLT_EMBREE_SOURCE_ROOT}/include" CACHE INTERNAL "Embree source include directory")
set(REDBOLT_EMBREE_BUILD_INCLUDE_DIR "${Embree_BINARY_DIR}/include" CACHE INTERNAL "Embree generated include directory")
set(REDBOLT_EMBREE_LIBRARY embree CACHE INTERNAL "RedBolt Embree target")
