set(TINYGLTF_BUILD_LOADER_EXAMPLE OFF)
set(TINYGLTF_BUILD_GL_EXAMPLES OFF)
set(TINYGLTF_BUILD_VALIDATOR_EXAMPLE OFF)
set(TINYGLTF_BUILD_BUILDER_EXAMPLE OFF)
set(TINYGLTF_HEADER_ONLY ON)
set(TINYGLTF_INSTALL OFF)
set(TINYGLTF_INSTALL_VENDOR OFF)

redbolt_cpm_add_package(
    NAME tinygltf
    GIT_REPOSITORY https://github.com/syoyo/tinygltf.git
    GIT_TAG v2.9.7
    CUSTOM_CACHE_KEY "."
    EXCLUDE_FROM_ALL YES)
set(REDBOLT_TINYGLTF_SOURCE_ROOT "${tinygltf_SOURCE_DIR}" CACHE INTERNAL "TinyGLTF source root")
set(REDBOLT_TINYGLTF_INCLUDE_DIR "${REDBOLT_TINYGLTF_SOURCE_ROOT}" CACHE INTERNAL "TinyGLTF include directory")
redbolt_require_path("${REDBOLT_TINYGLTF_INCLUDE_DIR}/tiny_gltf.h" "TinyGLTF header")
