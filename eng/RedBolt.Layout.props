<Project>
  <!-- The layout root is the parent directory of the engine. A workspace file or the monorepo root file is there. -->
  <Import Project="$(RedBoltRoot)/../RedBolt.Workspace.props"
          Condition="'$(RedBoltWorkspaceRoot)' == '' and Exists('$(RedBoltRoot)/../RedBolt.Workspace.props')" />
  <Import Project="$(RedBoltRoot)/../Directory.Build.props"
          Condition="'$(RedBoltMonorepoRoot)' == '' and Exists('$(RedBoltRoot)/../RedBolt.slnx') and Exists('$(RedBoltRoot)/../Directory.Build.props')" />
  <PropertyGroup>
    <RedBoltBuildRoot Condition="'$(RedBoltBuildRoot)' == ''">$([System.IO.Path]::GetFullPath('$(RedBoltRoot)/../build'))</RedBoltBuildRoot>
  </PropertyGroup>
</Project>
