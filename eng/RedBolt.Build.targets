<Project>
  <UsingTask TaskName="RedBoltUseParentRuntimeAssemblies"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <DependencyFile ParameterType="System.String" Required="true" />
      <MainProjectName ParameterType="System.String" Required="true" />
      <NativeRuntimeDirectory ParameterType="System.String" Required="true" />
      <RelocateAllProjectLibraries ParameterType="System.Boolean" Required="true" />
      <RuntimeIdentifier ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var contents = File.ReadAllText(DependencyFile);
        var expression = new Regex(
            "^(?<prefix>\\s*\\\"(?<name>[^\\\"]+)/[^\\\"]+\\\": \\{\\r?\\n(?<indent>\\s*))\\\"type\\\": \\\"(?:project|reference)\\\",",
            RegexOptions.Multiline);
        var transformed = expression.Replace(
            contents,
            match => match.Groups["name"].Value == MainProjectName
                || (!RelocateAllProjectLibraries && match.Groups["name"].Value != "RedBolt")
                ? match.Value
                : match.Groups["prefix"].Value
                    + "\"type\": \"package\","
                    + Environment.NewLine
                    + match.Groups["indent"].Value
                    + "\"path\": \".\",");

        var runtimeTargetIndex = transformed.IndexOf("/" + RuntimeIdentifier + "\": {");
        var redBoltIndex = transformed.IndexOf("\"RedBolt/", runtimeTargetIndex);
        var objectStart = transformed.IndexOf('{', redBoltIndex);
        var objectEnd = -1;
        var depth = 0;
        var inString = false;
        var escaped = false;
        for (var index = objectStart; index < transformed.Length; ++index)
        {
            var character = transformed[index];
            if (inString)
            {
                if (escaped)
                    escaped = false;
                else if (character == '\\')
                    escaped = true;
                else if (character == '"')
                    inString = false;
            }
            else if (character == '"')
            {
                inString = true;
            }
            else if (character == '{')
            {
                ++depth;
            }
            else if (character == '}' && --depth == 0)
            {
                objectEnd = index;
                break;
            }
        }

        if (transformed.IndexOf("\"native\": {", objectStart, objectEnd - objectStart) < 0)
        {
            var closingLineStart = transformed.LastIndexOf('\n', objectEnd) + 1;
            transformed = transformed.Insert(closingLineStart - 1, ",");
            ++closingLineStart;
            var nativeEntries = string.Join(
                "," + Environment.NewLine,
                Directory.GetFiles(NativeRuntimeDirectory, "*.so")
                    .OrderBy(path => Path.GetFileName(path))
                    .Select(path => "        \"runtimes/" + RuntimeIdentifier + "/native/"
                        + Path.GetFileName(path) + "\": {}"));
            transformed = transformed.Insert(
                closingLineStart,
                "      \"native\": {" + Environment.NewLine
                    + nativeEntries + Environment.NewLine
                    + "      }" + Environment.NewLine);
        }

        File.WriteAllText(DependencyFile, transformed);
      ]]></Code>
    </Task>
  </UsingTask>

  <PropertyGroup Condition="'$(OutputType)' == 'Library'">
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <PropertyGroup>
    <RedBoltGlobalAliasesFile>$(RedBoltRoot)/src/RedBolt/GlobalAliases.cs</RedBoltGlobalAliasesFile>
    <RedBoltIsBindingProject>$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('RedBolt.Bindings.'))</RedBoltIsBindingProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(RedBoltPlatform)' == 'linux-gcc-x64-dll' and ('$(RedBoltIsSampleProject)' == 'true' or '$(MSBuildProjectName)' == 'RedBolt.Tests')">
    <AdditionalProbingPath Include="$(RedBoltOutputRoot)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(RedBoltPlatform)' == 'linux-gcc-x64-dll' and ('$(RedBoltIsSampleProject)' == 'true' or '$(MSBuildProjectName)' == 'RedBolt.Tests')">
    <GenerateRuntimeConfigDevFile>true</GenerateRuntimeConfigDevFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(RedBoltIsBindingProject)' == 'true'">
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj"
                      PrivateAssets="all"
                      RedBoltProperties="$(RedBoltSharpCppManagedProperties)" />
    <ProjectReference Include="$(RedBoltRoot)/native/RedBolt.Native/RedBolt.Native.csproj"
                      Condition="'$(RedBoltPlatform)' != 'web-emscripten-wasm'"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      RedBoltProperties="Configuration=$(Configuration)" />
    <ProjectReference Include="$(RedBoltRoot)/native/RedBolt.Native/RedBolt.Native.Web.csproj"
                      Condition="'$(RedBoltPlatform)' == 'web-emscripten-wasm'"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      RedBoltProperties="Configuration=$(Configuration)" />
  </ItemGroup>

  <Target Name="RedBoltPropagateProjectReferenceProperties"
          BeforeTargets="AssignProjectConfiguration;_SplitProjectReferencesByFileExistence">
    <ItemGroup>
      <ProjectReference Update="@(ProjectReference)"
                        Condition="'%(ProjectReference.RedBoltProperties)' == ''"
                        RedBoltProperties="Configuration=$(Configuration);RedBoltPlatform=$(RedBoltPlatform);RedBoltNativePreset=$(RedBoltNativePreset)" />
    </ItemGroup>
  </Target>

  <Target Name="RedBoltSetProjectReferenceProperties"
          AfterTargets="_SplitProjectReferencesByFileExistence"
          BeforeTargets="_GetProjectReferenceTargetFrameworkProperties;ResolveProjectReferences">
    <ItemGroup>
      <_MSBuildProjectReferenceExistent Update="@(_MSBuildProjectReferenceExistent)"
                                        Condition="'%(_MSBuildProjectReferenceExistent.RedBoltProperties)' != ''">
        <SetConfiguration>%(_MSBuildProjectReferenceExistent.SetConfiguration);%(_MSBuildProjectReferenceExistent.RedBoltProperties)</SetConfiguration>
        <GlobalPropertiesToRemove>TargetFramework;RuntimeIdentifier;SelfContained;Platform</GlobalPropertiesToRemove>
      </_MSBuildProjectReferenceExistent>
      <_MSBuildProjectReferenceExistent Update="@(_MSBuildProjectReferenceExistent)"
                                        Condition="'%(_MSBuildProjectReferenceExistent.RedBoltProperties)' == ''">
        <SetConfiguration>%(_MSBuildProjectReferenceExistent.SetConfiguration);Configuration=$(Configuration);RedBoltPlatform=$(RedBoltPlatform);RedBoltNativePreset=$(RedBoltNativePreset)</SetConfiguration>
        <GlobalPropertiesToRemove>TargetFramework;RuntimeIdentifier;SelfContained;Platform</GlobalPropertiesToRemove>
      </_MSBuildProjectReferenceExistent>
    </ItemGroup>
  </Target>

  <Target Name="RedBoltConfigureRestoreGraph"
          BeforeTargets="_GenerateRestoreProjectPathItems;_GenerateProjectRestoreGraphPerFramework">
    <PropertyGroup>
      <_GenerateRestoreGraphProjectEntryInputProperties>
        $(_GenerateRestoreGraphProjectEntryInputProperties);
        SharpCppBuildRoot=$(RedBoltBuildRoot);
        SharpCppOutputDir=$(SharpCppOutputDir);
        SharpCppIntermediateRoot=$(SharpCppIntermediateRoot)
      </_GenerateRestoreGraphProjectEntryInputProperties>
    </PropertyGroup>
  </Target>

  <Target Name="RedBoltIncludeGeneratedBindings"
          BeforeTargets="CoreCompile"
          Condition="'$(RedBoltIsBindingProject)' == 'true'">
    <ItemGroup>
      <Compile Include="$(RedBoltGeneratedBindingsDir)/sdl/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.Sdl'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/diligent/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.Diligent'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/dearimgui/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.DearImGui'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/stb/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.Stb'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/lz4/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.Lz4'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/webp/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.WebP'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/glslang/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.Glslang'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/spirv-cross/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.SpirVCross'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/spirv-tools/**/*.g.cs;$(RedBoltGeneratedBindingsDir)/spirv-optimizer/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.SpirVTools'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/shader-compiler/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.ShaderCompiler'" />
    </ItemGroup>
  </Target>

  <Target Name="RedBoltIncludeGlobalAliases"
          BeforeTargets="CoreCompile"
          Condition="Exists('$(RedBoltGlobalAliasesFile)') and ('@(ProjectReference->WithMetadataValue(&quot;Filename&quot;, &quot;RedBolt&quot;))' != '' or '@(ReferencePath->WithMetadataValue(&quot;Filename&quot;, &quot;RedBolt&quot;))' != '')">
    <ItemGroup>
      <Compile Include="$(RedBoltGlobalAliasesFile)"
               Exclude="@(Compile)"
               Link="GlobalAliases.cs"
               Visible="false" />
    </ItemGroup>
  </Target>

  <Target Name="RedBoltConfigureParentRuntimeAssemblies"
          AfterTargets="GenerateBuildDependencyFile"
          Condition="'$(RedBoltPlatform)' == 'linux-gcc-x64-dll' and ('$(RedBoltIsSampleProject)' == 'true' or '$(MSBuildProjectName)' == 'RedBolt.Tests') and Exists('$(ProjectDepsFilePath)')">
    <RedBoltUseParentRuntimeAssemblies DependencyFile="$(ProjectDepsFilePath)"
                                       MainProjectName="$(AssemblyName)"
                                       NativeRuntimeDirectory="$(RedBoltNativeOutputRoot)"
                                       RelocateAllProjectLibraries="$(RedBoltIsSampleProject)"
                                       RuntimeIdentifier="$(RedBoltRuntimeIdentifier)" />
  </Target>

</Project>
