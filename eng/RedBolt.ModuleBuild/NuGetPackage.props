<Project>
  <!--
    Shared properties for the NuGet package projects (the core and every module's
    packaging/nuget/RedBolt.Package.csproj). Imported from a Directory.Build.props beside the project, so
    these are evaluated before Microsoft.Common.props reads BaseOutputPath, BaseIntermediateOutputPath and
    MSBuildProjectExtensionsPath; setting them in the project body would be too late for a plain
    dotnet build / dotnet pack.
  -->

  <PropertyGroup>
    <RedBoltRoot Condition="'$(RedBoltRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</RedBoltRoot>
  </PropertyGroup>
  <Import Project="$(RedBoltRoot)/eng/RedBolt.Layout.props" />

  <!-- Only the package project: the package.cs script beside it is a project of its own and keeps the
       SDK's per-file output paths. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'RedBolt.Package'">
    <!-- The package project's own bin/ and obj/ live under the active build root. -->
    <RedBoltPackageWorkName>$(RedBoltPackageId)</RedBoltPackageWorkName>
    <RedBoltPackageWorkName Condition="'$(RedBoltPackageWorkName)' == ''">$(MSBuildProjectName)</RedBoltPackageWorkName>
    <BaseOutputPath>$(RedBoltBuildRoot)/bin/package/nuget/$(RedBoltPackageWorkName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(RedBoltBuildRoot)/obj/package/nuget/$(RedBoltPackageWorkName)/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <!-- The project only packs staged files. Its package references exist to become nuspec dependencies,
         so their build assets (such as the runtime identifier check in RedBolt.Core.targets) stay out. -->
    <ImportProjectExtensionProps>false</ImportProjectExtensionProps>
    <ImportProjectExtensionTargets>false</ImportProjectExtensionTargets>
  </PropertyGroup>
</Project>
