<Project>
  <Import Project="$(RedBoltRoot)/src/Directory.Build.targets" />

  <PropertyGroup>
    <RedBoltModuleBuildTasksProject>$(RedBoltRoot)/eng/RedBolt.ModuleBuild/Tasks/RedBolt.ModuleBuild.Tasks.csproj</RedBoltModuleBuildTasksProject>
    <RedBoltModuleBuildTasksAssembly>$(RedBoltBuildRoot)/bin/tools/module-build-tasks/$(Configuration)/net10.0/RedBolt.ModuleBuild.Tasks.dll</RedBoltModuleBuildTasksAssembly>
  </PropertyGroup>

  <UsingTask TaskName="RedBolt.ModuleBuild.Tasks.EnsureDirectoryLink"
             AssemblyFile="$(RedBoltModuleBuildTasksAssembly)" />

  <ItemGroup>
    <RedBoltModuleBuildTasksInput Include="$(RedBoltRoot)/eng/RedBolt.ModuleBuild/Tasks/*.cs;$(RedBoltRoot)/eng/RedBolt.ModuleBuild/Tasks/*.csproj;$(RedBoltRoot)/eng/RedBolt.ModuleBuild/Tasks/Directory.Build.*" />
  </ItemGroup>

  <!-- Rebuilt when a task source is newer than the assembly. A node that already loaded the assembly
       keeps the old one until it exits. The per-platform global properties are removed so that callers
       of different platforms ask for the same instance of the tasks project. -->
  <Target Name="RedBoltBuildModuleBuildTasks"
          Inputs="@(RedBoltModuleBuildTasksInput)"
          Outputs="$(RedBoltModuleBuildTasksAssembly)">
    <MSBuild Projects="$(RedBoltModuleBuildTasksProject)" Targets="Restore;Build" Properties="Configuration=$(Configuration);RedBoltBuildRoot=$(RedBoltBuildRoot)"
             RemoveProperties="$(RedBoltHostProjectGlobalPropertiesToRemove)" />
  </Target>

  <ItemGroup>
    <ProjectReference Update="@(ProjectReference->WithMetadataValue('Filename', '$(RedBoltExternalGeneratorProjectName)'))">
      <GlobalPropertiesToRemove>%(ProjectReference.GlobalPropertiesToRemove);$(RedBoltHostProjectGlobalPropertiesToRemove)</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition="'$(RedBoltPlatform)' == 'browser-wasm'">
    <ProjectReference Update="$(RedBoltExternalModuleRoot)/../RedBolt.*/src/RedBolt/**/*.csproj">
      <AdditionalProperties>%(ProjectReference.AdditionalProperties);RedBoltPlatform=browser-wasm</AdditionalProperties>
      <SetTargetFramework>TargetFramework=net10.0;RedBoltPlatform=browser-wasm</SetTargetFramework>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <GlobalPropertiesToRemove>%(ProjectReference.GlobalPropertiesToRemove);RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishSelfContained</GlobalPropertiesToRemove>
    </ProjectReference>
    <ProjectReference Update="@(ProjectReference->WithMetadataValue('Filename', 'RedBolt.Generator.Dependencies'));@(ProjectReference->WithMetadataValue('Filename', 'RedBolt.Generator.Reflection'));@(ProjectReference->WithMetadataValue('Filename', '$(RedBoltExternalGeneratorProjectName)'))">
      <AdditionalProperties></AdditionalProperties>
      <SetTargetFramework></SetTargetFramework>
      <SkipGetTargetFrameworkProperties>false</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition="$([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-'))">
    <ProjectReference Update="$(RedBoltExternalModuleRoot)/../RedBolt.*/src/RedBolt/**/*.csproj">
      <GlobalPropertiesToRemove>%(ProjectReference.GlobalPropertiesToRemove);$(RedBoltInnerBuildGlobalPropertiesToRemove)</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>

  <!-- Module host tools, executables, and tests probe the core's shared output buckets (plus module-specific paths)
       so they resolve the parent-built assemblies at runtime. -->
  <ItemGroup Condition="'$(RedBoltExternalModuleRoot)' != '' and ('$(RedBoltPlatform)' == 'tools' or '$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64') and ('$(OutputType)' == 'Exe' or '$(IsTestProject)' == 'true')">
    <AdditionalProbingPath Include="$(RedBoltBuildRoot)/bin/$(Configuration)/$(RedBoltPlatform)/core" />
    <AdditionalProbingPath Include="$(RedBoltBuildRoot)/bin/$(Configuration)/$(RedBoltPlatform)/extern" />
    <AdditionalProbingPath Include="$(RedBoltBuildRoot)/bin/$(Configuration)/host/extern" />
    <AdditionalProbingPath Include="$(RedBoltBuildRoot)/bin/$(Configuration)/host/tools" />
    <AdditionalProbingPath Include="$(RedBoltExternalAdditionalProbingPaths)" Condition="'$(RedBoltExternalAdditionalProbingPaths)' != ''" />
  </ItemGroup>

  <!--
    Module counterpart of RedBoltConfigureRuntimeAssemblies: rewrite the deps.json for module
    executables/tests to consume parent-built assemblies and the module's own native assets.
    Runs just before the core target so the core's post-processing still applies.
  -->
  <Target Name="RedBoltExternalConfigureBaseRuntimeAssemblies"
          BeforeTargets="RedBoltConfigureRuntimeAssemblies"
      Condition="'$(RedBoltExternalModuleRoot)' != '' and ('$(RedBoltPlatform)' == 'tools' or '$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64') and ('$(OutputType)' == 'Exe' or '$(IsTestProject)' == 'true') and Exists('$(ProjectDepsFilePath)')">
    <RedBoltUseParentRuntimeAssemblies
        DependencyFile="$(ProjectDepsFilePath)"
        MainProjectName="$(AssemblyName)"
        NativeRuntimeDirectory="$(RedBoltRuntimeNativeOutputRoot)"
        NativeModuleManifestDirectory="$(RedBoltRuntimeNativeModuleManifestDirectory)"
        RuntimeIdentifier="$(RuntimeIdentifier)">
      <Output TaskParameter="NativeAssets" ItemName="_RedBoltNativeAssets" />
    </RedBoltUseParentRuntimeAssemblies>
  </Target>

  <!-- Desktop samples use identity-qualified module resources from the common output root. -->
  <Target Name="RedBoltStageExternalNativeResources"
          DependsOnTargets="RedBoltBuildModuleBuildTasks"
          Condition="'$(RedBoltExternalDesktopResourceRoot)' != '' and '$(RedBoltExternalDesktopResourceName)' != '' and ('$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64')">
    <MakeDir Directories="$(RedBoltOutputRoot)" />
    <EnsureDirectoryLink Source="$(RedBoltRoot)/bin/CoreData" Link="$(RedBoltOutputRoot)/CoreData" />
    <EnsureDirectoryLink Source="$(RedBoltRoot)/bin/SampleData" Link="$(RedBoltOutputRoot)/SampleData" />
    <EnsureDirectoryLink Source="$(RedBoltRoot)/bin/EditorData" Link="$(RedBoltOutputRoot)/EditorData" />
    <EnsureDirectoryLink Source="$(RedBoltExternalDesktopResourceRoot)/bin/CoreData.$(RedBoltExternalDesktopResourceName)"
                         Link="$(RedBoltOutputRoot)/CoreData.$(RedBoltExternalDesktopResourceName)"
                         Condition="Exists('$(RedBoltExternalDesktopResourceRoot)/bin/CoreData.$(RedBoltExternalDesktopResourceName)')" />
    <EnsureDirectoryLink Source="$(RedBoltExternalDesktopResourceRoot)/bin/SampleData.$(RedBoltExternalDesktopResourceName)"
                         Link="$(RedBoltOutputRoot)/SampleData.$(RedBoltExternalDesktopResourceName)"
                         Condition="Exists('$(RedBoltExternalDesktopResourceRoot)/bin/SampleData.$(RedBoltExternalDesktopResourceName)')" />
  </Target>

  <Target Name="RedBoltExternalStageDesktopResources"
          AfterTargets="Build"
          DependsOnTargets="RedBoltStageExternalNativeResources"
      Condition="'$(RedBoltExternalDesktopResourceRoot)' != '' and '$(RedBoltExternalDesktopResourceName)' != '' and ('$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64') and '$(RedBoltProjectBuildEnabled)' == 'true'" />

  <!--
    Standalone layout (no monorepo root): core projects referenced from a module project evaluate on their own and
    would default to the core's build/. Pass this project's build root down every ProjectReference that leaves
    this repository, in the resolved reference set, and in the restore graph, so the whole graph shares one
    build root. References inside this repository already share the root; extra global properties would build
    them a second time. The monorepo needs none of this: its root Directory.Build.props selects the same root
    everywhere. A workspace (RedBolt.Workspace.props) needs none of it either: every repository imports the
    same file, and the extra global properties would build a project a second time when a solution also
    lists it.
  -->
  <PropertyGroup Condition="'$(RedBoltMonorepoRoot)' == '' and '$(RedBoltWorkspaceRoot)' == ''">
    <_RedBoltStandaloneRepositoryPrefix>$([MSBuild]::EnsureTrailingSlash('$([System.IO.Path]::GetFullPath('$(RedBoltExternalModuleRoot)'))'))</_RedBoltStandaloneRepositoryPrefix>
  </PropertyGroup>
  <ItemGroup Condition="'$(RedBoltMonorepoRoot)' == '' and '$(RedBoltWorkspaceRoot)' == ''">
    <ProjectReference Update="@(ProjectReference)">
      <AdditionalProperties Condition="!$([System.String]::Copy('%(FullPath)').StartsWith('$(_RedBoltStandaloneRepositoryPrefix)'))">%(ProjectReference.AdditionalProperties);RedBoltBuildRoot=$(RedBoltBuildRoot);RedBoltExpectedBuildRoot=$(RedBoltExpectedBuildRoot)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
  <Target Name="RedBoltConfigureStandaloneProjectReferences"
          AfterTargets="_SplitProjectReferencesByFileExistence"
          BeforeTargets="_GetProjectReferenceTargetFrameworkProperties;ResolveProjectReferences"
          Condition="'$(RedBoltMonorepoRoot)' == '' and '$(RedBoltWorkspaceRoot)' == ''">
    <ItemGroup>
      <_MSBuildProjectReferenceExistent Update="@(_MSBuildProjectReferenceExistent)">
        <SetConfiguration Condition="!$([System.String]::Copy('%(FullPath)').StartsWith('$(_RedBoltStandaloneRepositoryPrefix)'))">%(_MSBuildProjectReferenceExistent.SetConfiguration);RedBoltBuildRoot=$(RedBoltBuildRoot);RedBoltExpectedBuildRoot=$(RedBoltExpectedBuildRoot)</SetConfiguration>
      </_MSBuildProjectReferenceExistent>
    </ItemGroup>
  </Target>
  <Target Name="RedBoltConfigureStandaloneRestoreGraph"
          BeforeTargets="_FilterRestoreGraphProjectInputItems;_GenerateRestoreProjectPathWalk;_GenerateRestoreProjectPathItemsPerFramework;_GenerateProjectRestoreGraphPerFramework"
          Condition="'$(RedBoltMonorepoRoot)' == '' and '$(RedBoltWorkspaceRoot)' == ''">
    <PropertyGroup>
      <_GenerateRestoreGraphProjectEntryInputProperties>$(_GenerateRestoreGraphProjectEntryInputProperties);RedBoltBuildRoot=$(RedBoltBuildRoot);RedBoltExpectedBuildRoot=$(RedBoltExpectedBuildRoot)</_GenerateRestoreGraphProjectEntryInputProperties>
    </PropertyGroup>
  </Target>
</Project>
