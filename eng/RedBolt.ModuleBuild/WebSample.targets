<Project>
  <!--
    Web (browser-wasm) sample build wiring. Configures the .NET wasm SDK for a RedBolt sample app,
    declares the wasm-specific outputs (engine archive, packaged resources, P/Invoke modules), and
    builds the .pak resource packages via the PackageTool before the wasm publish.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <StartupObject>RedBolt.Sample.Web.WebProgram</StartupObject>
    <CompressionEnabled>false</CompressionEnabled>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Emscripten linker flags: request full ES3, dynamic calls, the IDBFS filesystem, and the FS /
         run-dependency helpers used by the engine's virtual filesystem. -->
    <EmccExtraLDFlags>-sFULL_ES3 -sDEFAULT_LIBRARY_FUNCS_TO_INCLUDE=$dynCall -lidbfs.js -sEXPORTED_RUNTIME_METHODS+=FS -sEXPORTED_RUNTIME_METHODS+=addRunDependency -sEXPORTED_RUNTIME_METHODS+=removeRunDependency</EmccExtraLDFlags>
    <EmccLinkOptimizationFlag Condition="'$(Configuration)' == 'Release'">-Oz</EmccLinkOptimizationFlag>
    <EmccLinkOptimizationFlag Condition="'$(Configuration)' != 'Release'">-O0</EmccLinkOptimizationFlag>
    <PublishTrimmed>true</PublishTrimmed>
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
    <RunAOTCompilation Condition="'$(Configuration)' != 'Release'">false</RunAOTCompilation>
    <WasmBuildNative>true</WasmBuildNative>
    <WasmNativeDebugSymbols Condition="'$(Configuration)' == 'Release'">false</WasmNativeDebugSymbols>
    <WasmNativeDebugSymbols Condition="'$(Configuration)' != 'Release'">true</WasmNativeDebugSymbols>
    <WasmNativeStrip Condition="'$(Configuration)' == 'Release'">true</WasmNativeStrip>
    <WasmNativeStrip Condition="'$(Configuration)' != 'Release'">false</WasmNativeStrip>
    <WasmRunWasmOpt Condition="'$(Configuration)' == 'Release'">true</WasmRunWasmOpt>
    <WasmRunWasmOpt Condition="'$(Configuration)' != 'Release'">false</WasmRunWasmOpt>
    <WasmStripILAfterAOT Condition="'$(Configuration)' == 'Release'">true</WasmStripILAfterAOT>
    <PublishDir>$(RedBoltWebOutputDir)/</PublishDir>
    <RedBoltWebEngineArchive>$(RedBoltBaseNativeBuildDir)/lib/Release/wasm/RedBolt.Native.Web.a</RedBoltWebEngineArchive>
    <RedBoltWebResourcesManifest>$(BaseIntermediateOutputPath)resources.manifest.json</RedBoltWebResourcesManifest>
    <RedBoltWebPackageDirectory>$(BaseIntermediateOutputPath)packages</RedBoltWebPackageDirectory>
    <RedBoltPackageToolAssembly>$(RedBoltBuildRoot)/bin/$(Configuration)/host/tools/linux-x64/RedBolt.PackageTool.dll</RedBoltPackageToolAssembly>
    <RedBoltPackageToolNativeOutput>$(RedBoltBuildRoot)/bin/$(Configuration)/linux-x64/extern/runtimes/linux-x64/native</RedBoltPackageToolNativeOutput>
    <RedBoltWebExtensionScript Condition="'$(RedBoltWebExtensionScript)' == ''">$(RedBoltRoot)/src/RedBolt/Sample/Web/wwwroot/extension.js</RedBoltWebExtensionScript>
    <RedBoltCMakeTarget Condition="'$(RedBoltExternalWebNativeEnabled)' == 'true'">$(RedBoltExternalNativeTargetPrefix)-wasm-native</RedBoltCMakeTarget>
    <RedBoltCMakeTarget Condition="'$(RedBoltExternalHasNative)' != 'true'">redbolt-wasm-native</RedBoltCMakeTarget>
    <RedBoltCoreCMakeTarget Condition="'$(RedBoltExternalHasNative)' == 'true'">redbolt-wasm-native</RedBoltCoreCMakeTarget>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <WasmOptConfigurationFlags Include="--enable-threads;--strip-debug" />
  </ItemGroup>
  <ItemGroup>
    <!-- Keep the SharpCpp runtime types from being trimmed away, and link the engine's wasm archive. -->
    <TrimmerRootAssembly Include="$(AssemblyName);SharpCpp.Std" />
    <NativeFileReference Include="$(RedBoltWebEngineArchive)" />
    <NativeFileReference Include="$(RedBoltExternalWebArchive)" Condition="'$(RedBoltExternalWebArchive)' != ''" />
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/Core/RedBolt.Core.csproj" />
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/Native/**/*.csproj" />
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/Tools/PackageTool/RedBolt.PackageTool.csproj"
                      ReferenceOutputAssembly="false" Private="false" PrivateAssets="all">
      <AdditionalProperties Condition="'$(RedBoltFull)' != 'true'">RedBoltIgnoreBuildSelection=true</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj"
                      PrivateAssets="all" AdditionalProperties="$(RedBoltSharpCppManagedProperties)"
                      GlobalPropertiesToRemove="$(RedBoltHostProjectGlobalPropertiesToRemove)" />
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Std/SharpCpp.Std.csproj"
                      PrivateAssets="all" AdditionalProperties="$(RedBoltSharpCppManagedProperties)"
                      GlobalPropertiesToRemove="$(RedBoltHostProjectGlobalPropertiesToRemove)" />
    <ProjectReference Include="$(RedBoltExternalModuleRoot)/src/RedBolt/Native/**/$(RedBoltExternalBindingsProjectName).csproj"
                      Condition="'$(RedBoltExternalWebNativeEnabled)' == 'true'" />
    <Content Remove="$(RedBoltRoot)/src/RedBolt/Sample/Web/wwwroot/main.js" />
    <Content Include="$(RedBoltRoot)/src/RedBolt/Sample/Web/wwwroot/main.js" Link="wwwroot/main.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="$(RedBoltWebExtensionScript)" />
    <Content Include="$(RedBoltWebExtensionScript)" Link="wwwroot/extension.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <RedBoltWebResourcePackage Include="RedBolt.CoreData" SourceDirectory="$(RedBoltRoot)/bin/CoreData" />
    <RedBoltWebResourcePackage Include="RedBolt.SampleData" SourceDirectory="$(RedBoltRoot)/bin/SampleData" />
    <RedBoltWebResourceFile Include="@(RedBoltWebResourcePackage->'%(SourceDirectory)/**/*')" />
    <Content Include="@(RedBoltWebResourcePackage->'$(RedBoltWebPackageDirectory)/%(Identity).pak')" Link="wwwroot/resources/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RedBoltWebResourcesManifest)" Link="wwwroot/resources.manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Builds one .pak for each module data folder before static web assets are resolved. -->
  <Target Name="RedBoltCreateWebPackages" BeforeTargets="ResolveProjectStaticWebAssets;GetCopyToOutputDirectoryItems"
          Inputs="@(RedBoltWebResourceFile);$(RedBoltPackageToolAssembly);$(MSBuildProjectFullPath)"
          Outputs="@(RedBoltWebResourcePackage->'$(RedBoltWebPackageDirectory)/%(Identity).pak');$(RedBoltWebResourcesManifest)">
    <RemoveDir Directories="$(RedBoltWebPackageDirectory)" />
    <MakeDir Directories="$(RedBoltWebPackageDirectory)" />
    <Exec Command="dotnet &quot;$(RedBoltPackageToolAssembly)&quot; &quot;%(RedBoltWebResourcePackage.SourceDirectory)&quot; &quot;$(RedBoltWebPackageDirectory)/%(RedBoltWebResourcePackage.Identity).pak&quot; -q -c" EnvironmentVariables="LD_LIBRARY_PATH=$(RedBoltPackageToolNativeOutput)" />
    <PropertyGroup>
      <RedBoltWebResourcesManifestContent>[@(RedBoltWebResourcePackage->'{&quot;name&quot;:&quot;../resources/%(Identity).pak&quot;,&quot;virtualPath&quot;:&quot;%(Identity).pak&quot;}', ',')]</RedBoltWebResourcesManifestContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(RedBoltWebResourcesManifest)"
                      Lines="$(RedBoltWebResourcesManifestContent)"
                      Overwrite="true" />
  </Target>
  <Target Name="RedBoltBuildWebNativeArchive"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveReferences;RedBoltConfigureNative;RedBoltBuildCMakeTarget" />
  <!-- Declares the native P/Invoke modules that must be linked into the wasm module. -->
  <Target Name="RedBoltConfigureWebPInvokeModules" BeforeTargets="_GenerateManagedToNative">
    <ItemGroup>
      <_WasmPInvokeModules Include="RedBolt.Native.Sdl;RedBolt.Native.Diligent;RedBolt.Native.Stb;RedBolt.Native.Lz4;RedBolt.Native.HarfBuzz;RedBolt.Native.WebP;RedBolt.Native.Glslang;RedBolt.Native.SpirVCross;RedBolt.Native.SpirVTools;RedBolt.Native.ShaderCompiler;$(RedBoltExternalWebPInvokeModules)" />
    </ItemGroup>
  </Target>
  <Import Project="$(RedBoltRoot)/src/RedBolt/Native/NativeBuild.targets" />
</Project>
