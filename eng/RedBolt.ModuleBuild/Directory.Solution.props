<Project>
  <!-- A module solution builds into the module's build/, or into the monorepo root's build/ when the
       module sits beside the monorepo's RedBolt.slnx (the same selection as the project-level props). -->
  <PropertyGroup>
    <RedBoltExpectedBuildRoot Condition="'$(RedBoltExpectedBuildRoot)' == '' and '$(RedBoltBuildRoot)' != ''">$([System.IO.Path]::GetFullPath('$(RedBoltBuildRoot)'))</RedBoltExpectedBuildRoot>
    <RedBoltExpectedBuildRoot Condition="'$(RedBoltExpectedBuildRoot)' == ''">$([System.IO.Path]::GetFullPath('$(RedBoltExternalModuleRoot)/build'))</RedBoltExpectedBuildRoot>
  </PropertyGroup>
  <Import Project="$(RedBoltExternalModuleRoot)/../Directory.Build.props"
          Condition="'$(RedBoltMonorepoRoot)' == ''
                     and Exists('$(RedBoltExternalModuleRoot)/../Directory.Build.props')
                     and Exists('$(RedBoltExternalModuleRoot)/../RedBolt.slnx')" />
  <Import Project="$(RedBoltRoot)/Directory.Solution.props" />
</Project>
