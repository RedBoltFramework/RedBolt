<Project>
  <!-- CustomAfterDirectoryBuildProps is a global property during solution restore. Import the SDK
       default it replaces so projects keep the same artifacts-path behavior. -->
  <Import Project="$(MSBuildToolsPath)/Sdks/Microsoft.NET.Sdk/Sdk/UseArtifactsOutputPath.props"
          Condition="Exists('$(MSBuildToolsPath)/Sdks/Microsoft.NET.Sdk/Sdk/UseArtifactsOutputPath.props')" />
  <PropertyGroup Condition="'$(SharpCppBuildPropsImported)' == 'true'">
    <MSBuildProjectExtensionsPath>$(SharpCppBuildRoot)/obj/restore/$(Configuration)/$(MSBuildProjectName)/</MSBuildProjectExtensionsPath>
  </PropertyGroup>
</Project>
