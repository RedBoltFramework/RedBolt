<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EnableDefaultItems>false</EnableDefaultItems>
    <BuildInParallel>false</BuildInParallel>
    <CopyBuildOutputToOutputDirectory>false</CopyBuildOutputToOutputDirectory>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="samples/RedBolt.Sample.HelloGUI/RedBolt.Sample.HelloGUI.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="samples/RedBolt.Sample.MultipleViewports/RedBolt.Sample.MultipleViewports.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="samples/RedBolt.Sample.HelloWorld/RedBolt.Sample.HelloWorld.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="samples/RedBolt.Sample.AnimatingScene/RedBolt.Sample.AnimatingScene.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="samples/RedBolt.Sample.RenderToTexture/RedBolt.Sample.RenderToTexture.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="samples/RedBolt.Sample.WindowSettings/RedBolt.Sample.WindowSettings.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="samples/RedBolt.Sample.StaticScene/RedBolt.Sample.StaticScene.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="samples/RedBolt.Sample.DynamicGeometry/RedBolt.Sample.DynamicGeometry.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="samples/RedBolt.Sample.CameraShake/RedBolt.Sample.CameraShake.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="samples/RedBolt.Sample.Billboards/RedBolt.Sample.Billboards.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="samples/RedBolt.Sample.MaterialAnimation/RedBolt.Sample.MaterialAnimation.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="samples/RedBolt.Sample.HugeObjectCount/RedBolt.Sample.HugeObjectCount.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="samples/RedBolt.Sample.CameraOperator/RedBolt.Sample.CameraOperator.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="samples/RedBolt.Sample.SkeletalAnimation/RedBolt.Sample.SkeletalAnimation.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="samples/RedBolt.Sample.SoundEffects/RedBolt.Sample.SoundEffects.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="samples/RedBolt.Sample.SoundSynthesis/RedBolt.Sample.SoundSynthesis.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="samples/RedBolt.Sample.Decals/RedBolt.Sample.Decals.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="samples/RedBolt.Sample.PointerAdapter/RedBolt.Sample.PointerAdapter.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="samples/RedBolt.Sample.TextureFormats/RedBolt.Sample.TextureFormats.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="samples/RedBolt.Sample.LightAnimation/RedBolt.Sample.LightAnimation.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="samples/RedBolt.Sample.AggregatedInput/RedBolt.Sample.AggregatedInput.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="samples/RedBolt.Sample.InputLogger/RedBolt.Sample.InputLogger.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="samples/RedBolt.Sample.VirtualFileSystem/RedBolt.Sample.VirtualFileSystem.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="tests/RedBolt.Tests/RedBolt.Tests.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Update="@(ProjectReference)" Private="false" />
  </ItemGroup>

  <Target Name="RedBoltPublishWeb" AfterTargets="Build">
    <MSBuild Projects="samples/RedBolt.Sample.Web/RedBolt.Sample.Web.csproj"
             Targets="Restore"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);RedBoltPlatform=web-emscripten-wasm;RedBoltNativePreset=web-emscripten-wasm" />
    <MSBuild Projects="samples/RedBolt.Sample.Web/RedBolt.Sample.Web.csproj"
             Targets="Publish"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);RedBoltPlatform=web-emscripten-wasm;RedBoltNativePreset=web-emscripten-wasm" />
  </Target>
</Project>
