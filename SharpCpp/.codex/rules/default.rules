prefix_rule(
    pattern = ["./make.sh"],
    decision = "allow",
    justification = "Utility commands"
)

prefix_rule(
    pattern = ["cmake"],
    decision = "allow",
    justification = "CMake build system"
)

prefix_rule(
    pattern = ["ctest"],
    decision = "allow",
    justification = "CTest test system"
)

prefix_rule(
    pattern = ["dotnet"],
    decision = "allow",
    justification = ".NET build system"
)
