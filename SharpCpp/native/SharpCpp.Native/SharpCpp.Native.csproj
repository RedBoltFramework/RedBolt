<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AssemblyName>SharpCpp.Native.Build</AssemblyName>
    <SharpCppRbfxSdkRoot Condition="'$(SharpCppRbfxSdkRoot)' == '' and '$(RBFX_SDK_ROOT)' != ''">$(RBFX_SDK_ROOT)</SharpCppRbfxSdkRoot>
    <SharpCppRbfxSdkRootArgument Condition="'$(SharpCppRbfxSdkRoot)' != ''">-DRBFX_SDK_ROOT=&quot;$(SharpCppRbfxSdkRoot)&quot;</SharpCppRbfxSdkRootArgument>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SharpCpp.Tool/SharpCpp.Tool.csproj"
                      Condition="'$(SharpCppBuildE2E)' == 'true'"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      PrivateAssets="all" />
    <ProjectReference Include="../../rbfx/SharpCpp.Rbfx.Generator/SharpCpp.Rbfx.Generator.csproj"
                      Condition="'$(SharpCppBuildRbfx)' == 'true'"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      PrivateAssets="all" />
    <ProjectReference Include="../../rbfx/Rbfx.UserCode/Rbfx.UserCode.Generator/Rbfx.UserCode.Generator.csproj"
                      Condition="'$(SharpCppBuildRbfx)' == 'true'"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <Target Name="SharpCppBuildNative" AfterTargets="Build">
    <Error Condition="'$(SharpCppNativePreset)' == ''"
           Text="SharpCppNativePreset is not configured." />
    <Error Condition="'$(SharpCppNativeTarget)' == ''"
           Text="SharpCppNativeTarget is not configured." />
    <Error Condition="'$(SharpCppCMakeSourceDir)' == ''"
           Text="SharpCppCMakeSourceDir is not configured." />
    <MakeDir Directories="$(SharpCppBuildRoot);$(SharpCppOutputDir);$(SharpCppIntermediateRoot)" />
    <Exec WorkingDirectory="$(SharpCppCMakeSourceDir)"
          Command="cmake -DSHARPCPP_SOURCE_DIR=&quot;$(SharpCppCMakeSourceDir)&quot; -DSHARPCPP_NATIVE_PRESET=&quot;$(SharpCppNativePreset)&quot; -DSHARPCPP_NATIVE_BUILD_DIR=&quot;$(SharpCppNativeBuildDir)&quot; -DSHARPCPP_NATIVE_TARGET=&quot;$(SharpCppNativeTarget)&quot; -DSHARPCPP_CONFIGURATION=&quot;$(Configuration)&quot; -DSHARPCPP_CONFIGURE_NATIVE=$(SharpCppConfigureNative) -DSHARPCPP_BUILD_E2E=$(SharpCppBuildE2E) -DSHARPCPP_BUILD_RBFX=$(SharpCppBuildRbfx) -DSHARPCPP_MANAGED_OUTPUT_ROOT=&quot;$(SharpCppManagedOutputRoot)&quot; -DSHARPCPP_NATIVE_OUTPUT_ROOT=&quot;$(SharpCppNativeOutputRoot)&quot; -DSHARPCPP_NATIVE_LOCK_FILE=&quot;$(SharpCppNativeLockFile)&quot; -DSHARPCPP_RBFX_SDK_ROOT=&quot;$(SharpCppRbfxSdkRoot)&quot; -DSHARPCPP_NATIVE_CONFIGURE_ARGUMENTS=&quot;$(SharpCppNativeConfigureArguments)&quot; -P &quot;$(MSBuildThisFileDirectory)BuildNative.cmake&quot;" />
  </Target>
</Project>
