<Project>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\content\EditorData\**\*">
      <Link>EditorData/%(RecursiveDir)%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>EditorData/%(RecursiveDir)%(FileName)%(Extension)</TargetPath>
    </None>
  </ItemGroup>
</Project>
