<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(SharpCppPackageTargetFramework)' != ''">$(SharpCppPackageTargetFramework)</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <PackageId>SharpCpp.Rbfx.Data</PackageId>
    <Title>SharpCpp.Rbfx.Data</Title>
    <Version>$(PackageVersion)</Version>
    <Authors>rbfx contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/rbfx/rbfx</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rbfx/SharpCpp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>Data resource package for rbfx applications.</Description>
    <PackageTags>rbfx SharpCpp Urho3D Data resources</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultItems>false</EnableDefaultItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(SharpCppNuGetStageRoot)/data/Data/**" Pack="true" PackagePath="content/Data/%(RecursiveDir)%(FileName)%(Extension)" />
    <None Include="buildTransitive/SharpCpp.Rbfx.Data.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
