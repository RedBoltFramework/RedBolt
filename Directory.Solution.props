<Project>
  <!--
    Solution-scoped roots.
    Resolves the single shared build output root (RedBoltBuildRoot) and the path to the persisted
    build configuration, then imports the platform/module selection logic.

    RedBoltBuildRoot is the one directory every project in the solution writes into, so managed
    assemblies, native libraries, and intermediate artifacts stay co-located and discoverable
    across the solution graph (probed via AdditionalProbingPath). The selection is static and
    mirrors the project-level Directory.Build.props: a global RedBoltBuildRoot, else the optional
    workspace file's build/ (RedBolt.Workspace.props beside this repository), else the monorepo
    root's build/ when this repository sits beside the monorepo's RedBolt.slnx, else this
    repository's build/.
  -->
  <!-- Optional workspace file; a global property still wins. RedBoltWorkspaceRoot reports it so it is
       not imported twice. -->
  <Import Project="$(MSBuildThisFileDirectory)../RedBolt.Workspace.props"
          Condition="'$(RedBoltWorkspaceRoot)' == '' and Exists('$(MSBuildThisFileDirectory)../RedBolt.Workspace.props')" />
  <Import Project="$(MSBuildThisFileDirectory)../Directory.Build.props"
          Condition="'$(RedBoltMonorepoRoot)' == ''
                     and Exists('$(MSBuildThisFileDirectory)../Directory.Build.props')
                     and Exists('$(MSBuildThisFileDirectory)../RedBolt.slnx')" />
  <Import Project="$(MSBuildThisFileDirectory)eng/RedBolt.SharpCppRoot.props" />
  <PropertyGroup>
    <RedBoltExpectedBuildRoot Condition="'$(RedBoltExpectedBuildRoot)' == '' and '$(RedBoltBuildRoot)' != ''">$([System.IO.Path]::GetFullPath('$(RedBoltBuildRoot)'))</RedBoltExpectedBuildRoot>
    <RedBoltExpectedBuildRoot Condition="'$(RedBoltExpectedBuildRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)build'))</RedBoltExpectedBuildRoot>
    <RedBoltBuildRoot Condition="'$(RedBoltBuildRoot)' == ''">$(RedBoltExpectedBuildRoot)</RedBoltBuildRoot>
    <RedBoltBuildConfigPath Condition="'$(RedBoltBuildConfigPath)' == ''">$(RedBoltBuildRoot)/BuildConfig.props</RedBoltBuildConfigPath>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <RedBoltSharpCppRestoreProps>$(MSBuildThisFileDirectory)eng/RedBolt.ModuleBuild/SharpCpp.Restore.props</RedBoltSharpCppRestoreProps>
    <AddSyntheticProjectReferencesForSolutionDependencies>false</AddSyntheticProjectReferencesForSolutionDependencies>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)eng/RedBolt.ModuleBuild/SharpCpp.Host.props" />
  <Import Project="$(MSBuildThisFileDirectory)RedBolt.BuildConfig.props" />
</Project>
