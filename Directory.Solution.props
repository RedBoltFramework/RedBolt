<Project>
  <!--
    Solution-scoped roots.
    Resolves the single shared build output root (RedBoltBuildRoot) and the path to the persisted
    build configuration, then imports the platform/module selection logic.

    RedBoltBuildRoot is the one directory every project in the solution writes into, so managed
    assemblies, native libraries, and intermediate artifacts stay co-located and discoverable
    across the solution graph (probed via AdditionalProbingPath). The selection is static and
    shared with the project-level Directory.Build.props through eng/RedBolt.Layout.props.
  -->
  <PropertyGroup>
    <RedBoltRoot Condition="'$(RedBoltRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory).'))</RedBoltRoot>
  </PropertyGroup>
  <Import Project="$(RedBoltRoot)/eng/RedBolt.Layout.props" />
  <Import Project="$(MSBuildThisFileDirectory)eng/RedBolt.SharpCppRoot.props" />
  <PropertyGroup>
    <RedBoltBuildConfigPath Condition="'$(RedBoltBuildConfigPath)' == ''">$(RedBoltBuildRoot)/BuildConfig.props</RedBoltBuildConfigPath>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <RedBoltSharpCppRestoreProps>$(MSBuildThisFileDirectory)eng/RedBolt.ModuleBuild/SharpCpp.Restore.props</RedBoltSharpCppRestoreProps>
    <AddSyntheticProjectReferencesForSolutionDependencies>false</AddSyntheticProjectReferencesForSolutionDependencies>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)eng/RedBolt.ModuleBuild/SharpCpp.Host.props" />
  <Import Project="$(MSBuildThisFileDirectory)RedBolt.BuildConfig.props" />
</Project>
