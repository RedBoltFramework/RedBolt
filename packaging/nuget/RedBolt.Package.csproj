<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsPackable>true</IsPackable>
    <PackageId>$(RedBoltPackageId)</PackageId>
    <Title>$(RedBoltPackageId)</Title>
    <Version>$(RedBoltPackageVersion)</Version>
    <Authors>RedBolt contributors</Authors>
    <Description>$(RedBoltPackageDescription)</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/RedBoltFramework/RedBolt</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RedBoltFramework/RedBolt.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryCommit>$(RedBoltRepositoryCommit)</RepositoryCommit>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>RedBolt game-engine csharp dotnet</PackageTags>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU5100;NU5119;NU5128</NoWarn>
    <!-- The package project's own bin/ and obj/ live under the active build root: a global RedBoltBuildRoot
         wins, then the monorepo root's build/ (RedBoltExpectedBuildRoot from the root Directory.Build.props),
         then this repository's build/. -->
    <RedBoltPackageBuildRoot>$(RedBoltBuildRoot)</RedBoltPackageBuildRoot>
    <RedBoltPackageBuildRoot Condition="'$(RedBoltPackageBuildRoot)' == ''">$(RedBoltExpectedBuildRoot)</RedBoltPackageBuildRoot>
    <RedBoltPackageBuildRoot Condition="'$(RedBoltPackageBuildRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../build'))</RedBoltPackageBuildRoot>
    <RedBoltPackageWorkName>$(RedBoltPackageId)</RedBoltPackageWorkName>
    <RedBoltPackageWorkName Condition="'$(RedBoltPackageWorkName)' == ''">$(MSBuildProjectName)</RedBoltPackageWorkName>
    <BaseOutputPath>$(RedBoltPackageBuildRoot)/bin/package/nuget/$(RedBoltPackageWorkName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(RedBoltPackageBuildRoot)/obj/package/nuget/$(RedBoltPackageWorkName)/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>

  <Import Project="$(RedBoltPackageSpec)" Condition="Exists('$(RedBoltPackageSpec)')" />

  <ItemGroup Condition="'$(RedBoltPackageStage)' != ''">
    <None Include="$(RedBoltPackageStage)/**/*"
          Exclude="$(RedBoltPackageStage)/obj/**/*;$(RedBoltPackageSpec)"
          Pack="true"
          PackagePath="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="ValidateRedBoltPackage" BeforeTargets="Pack">
    <Error Condition="'$(RedBoltPackageId)' == ''" Text="RedBoltPackageId must be set." />
    <Error Condition="'$(RedBoltPackageVersion)' == ''" Text="RedBoltPackageVersion must be set." />
    <Error Condition="'$(RedBoltPackageStage)' == '' or !Exists('$(RedBoltPackageStage)')"
           Text="RedBoltPackageStage must point to staged package files." />
    <Error Condition="!Exists('$(RedBoltPackageStage)/README.md')" Text="The package README is missing." />
  </Target>
</Project>
