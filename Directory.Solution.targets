<Project>
  <!--
    Solution-scoped targets.
    Defines the inline persistence tasks and the targets that bootstrap dependencies, expose the
    IDE-only web sample entry point, and persist the effective platform selection and build root
    after a solution build.
  -->
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <RedBoltDependencyConfigurePreset Condition="'$(Configuration)' == 'Release'">linux-x64-release</RedBoltDependencyConfigurePreset>
    <RedBoltDependencyConfigurePreset Condition="'$(RedBoltDependencyConfigurePreset)' == ''">linux-x64</RedBoltDependencyConfigurePreset>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Directory.Solution.SharpCpp.targets" />

  <!--
    Inline C# task that writes the effective platform and architecture lists back to
    BuildConfig.props. It only rewrites the file when the computed values differ from the
    saved ones, so an unchanged incremental build does not dirty the config file.
  -->
  <UsingTask TaskName="RedBoltSaveBuildConfig"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ConfigFile ParameterType="System.String" Required="true" />
      <EnablePlatforms ParameterType="System.String" />
      <DisablePlatforms ParameterType="System.String" />
      <EnableArchitectures ParameterType="System.String" />
      <DisableArchitectures ParameterType="System.String" />
      <SavedEnablePlatforms ParameterType="System.String" />
      <SavedDisablePlatforms ParameterType="System.String" />
      <SavedEnableArchitectures ParameterType="System.String" />
      <SavedDisableArchitectures ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Xml" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string Canonical(string value) => string.Join(",",
            (value ?? "")
                .Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(key => key.Trim().ToLowerInvariant())
                .Where(key => key.Length != 0)
                .Distinct(StringComparer.OrdinalIgnoreCase));

        var names = new[]
        {
            "EnablePlatforms", "DisablePlatforms",
            "EnableArchitectures", "DisableArchitectures",
        };
        var values = new[]
        {
            Canonical(EnablePlatforms), Canonical(DisablePlatforms),
            Canonical(EnableArchitectures), Canonical(DisableArchitectures)
        };
        var saved = new[]
        {
            Canonical(SavedEnablePlatforms), Canonical(SavedDisablePlatforms),
            Canonical(SavedEnableArchitectures), Canonical(SavedDisableArchitectures)
        };

        if (values.SequenceEqual(saved, StringComparer.Ordinal))
            return true;

        var group = new XElement("PropertyGroup");
        for (var index = 0; index < names.Length; ++index)
        {
            group.Add(new XElement("_RedBoltSaved" + names[index], values[index]));
            group.Add(new XElement(
                "RedBolt" + names[index],
                new XAttribute("Condition", "'" + "$" + "(RedBolt" + names[index] + ")' == ''"),
                values[index]));
        }
        var document = new XDocument(new XElement("Project", group));
        var directory = Path.GetDirectoryName(ConfigFile);
        if (!string.IsNullOrEmpty(directory))
            Directory.CreateDirectory(directory);
        var temporaryFile = ConfigFile + "." + Guid.NewGuid().ToString("N") + ".tmp";
        try
        {
            var settings = new XmlWriterSettings
            {
                Encoding = new UTF8Encoding(false),
                Indent = true,
                OmitXmlDeclaration = true,
                NewLineChars = Environment.NewLine
            };
            using (var writer = XmlWriter.Create(temporaryFile, settings))
                document.Save(writer);
            if (File.Exists(ConfigFile))
                File.Replace(temporaryFile, ConfigFile, null);
            else
                File.Move(temporaryFile, ConfigFile);
        }
        finally
        {
            if (File.Exists(temporaryFile))
                File.Delete(temporaryFile);
        }
        Log.LogMessage(MessageImportance.High, "Saved RedBolt build configuration to '{0}'.", ConfigFile);
      ]]></Code>
    </Task>
  </UsingTask>

  <UsingTask TaskName="RedBoltSaveBuildRoot"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ConfigFile ParameterType="System.String" Required="true" />
      <BuildRoot ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Xml" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (string.IsNullOrWhiteSpace(ConfigFile) || string.IsNullOrWhiteSpace(BuildRoot))
        {
            Log.LogError("Build root persistence requires non-empty file and build-root paths.");
            return false;
        }

        var configPath = Path.GetFullPath(ConfigFile);
        var configDirectory = Path.GetDirectoryName(configPath);
        if (string.IsNullOrEmpty(configDirectory))
        {
            Log.LogError("Build root configuration path has no parent directory: '{0}'.", configPath);
            return false;
        }

        var fullBuildRoot = Path.GetFullPath(BuildRoot);
        var configDirectoryUri = new Uri(configDirectory.TrimEnd(Path.DirectorySeparatorChar) + Path.DirectorySeparatorChar);
        var buildRootUri = new Uri(fullBuildRoot.TrimEnd(Path.DirectorySeparatorChar) + Path.DirectorySeparatorChar);
        var relativeBuildRootUri = configDirectoryUri.MakeRelativeUri(buildRootUri);
        var relativeBuildRoot = relativeBuildRootUri.IsAbsoluteUri
            ? fullBuildRoot
            : Uri.UnescapeDataString(relativeBuildRootUri.ToString()).TrimEnd('/');
        if (relativeBuildRoot.Length == 0)
            relativeBuildRoot = ".";
        var persistedBuildRoot = relativeBuildRootUri.IsAbsoluteUri
            ? relativeBuildRoot
            : "$" + "(MSBuildThisFileDirectory)" + relativeBuildRoot;
        persistedBuildRoot = persistedBuildRoot
            .Replace(Path.DirectorySeparatorChar, '/')
            .Replace(Path.AltDirectorySeparatorChar, '/');

        var document = new XDocument(
            new XElement("Project",
                new XElement("PropertyGroup",
                    new XElement(
                        "RedBoltPersistedBuildRoot",
                        new XAttribute("Condition", "'" + "$" + "(RedBoltPersistedBuildRoot)' == ''"),
                        persistedBuildRoot))));

        Directory.CreateDirectory(configDirectory);
        var temporaryFile = configPath + "." + Guid.NewGuid().ToString("N") + ".tmp";
        try
        {
            var settings = new XmlWriterSettings
            {
                Encoding = new UTF8Encoding(false),
                Indent = true,
                OmitXmlDeclaration = true,
                NewLineChars = Environment.NewLine
            };
            using (var writer = XmlWriter.Create(temporaryFile, settings))
                document.Save(writer);

            if (File.Exists(configPath)
                && File.ReadAllBytes(configPath).SequenceEqual(File.ReadAllBytes(temporaryFile)))
            {
                File.Delete(temporaryFile);
                return true;
            }

            if (File.Exists(configPath))
                File.Replace(temporaryFile, configPath, null);
            else
                File.Move(temporaryFile, configPath);
        }
        finally
        {
            if (File.Exists(temporaryFile))
                File.Delete(temporaryFile);
        }
        Log.LogMessage(MessageImportance.High, "Saved RedBolt build root to '{0}'.", configPath);
      ]]></Code>
    </Task>
  </UsingTask>

  <!--
    Refreshes third-party source dependencies before every restore. These dependencies are pulled
    in by CMake/CPM, so the configure preset must run even when the source trees already exist: CPM
    declarations and pinned revisions can change between builds. The checks below keep failures
    explicit when the configure step cannot populate a required dependency.
  -->
  <Target Name="RedBoltEnsureDependencies"
          BeforeTargets="Restore">
    <Exec Command="cmake --preset $(RedBoltDependencyConfigurePreset)" WorkingDirectory="$(MSBuildThisFileDirectory)" />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)extern/SharpCpp/src/SharpCpp.Support/SharpCpp.Support.csproj')"
           Text="CPM did not populate SharpCpp below '$(MSBuildThisFileDirectory)extern/SharpCpp'." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)extern/IconFontCppHeaders/IconsFontAwesome6.cs')"
           Text="CPM did not populate IconFontCppHeaders below '$(MSBuildThisFileDirectory)extern/IconFontCppHeaders'." />
  </Target>

  <!-- C# Dev Kit addresses an IDE-selected project through its solution target,
       even when that project is intentionally excluded from solution-wide builds. -->
  <Target Name="src\RedBolt\Sample\RedBolt_Sample_Web">
    <MSBuild Projects="$(MSBuildThisFileDirectory)src/RedBolt/Sample/Web/RedBolt.Sample.Web.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=$(Platform)" />
  </Target>

  <!--
    Persists the effective platform selection after a successful solution build.
    The save is gated to a single representative project per solution (RedBolt.Core for the core
    solution, or the external module project itself for module solutions) so the file is written
    exactly once per build even though the target is imported by every project.
  -->
  <Target Name="RedBoltPersistBuildConfiguration"
          AfterTargets="Build;Rebuild"
          Condition="'$(BuildingSolutionFile)' == 'true'
                     and '$(RedBoltPlatform)' == 'linux-x64'
                     and '$(SolutionName)' == 'RedBolt'
                     and '$(MSBuildProjectName)' == 'RedBolt.Core'">
    <RedBoltSaveBuildConfig ConfigFile="$(RedBoltBuildConfigPath)"
                            EnablePlatforms="$(RedBoltEnablePlatforms)"
                            DisablePlatforms="$(RedBoltDisablePlatforms)"
                            EnableArchitectures="$(RedBoltEnableArchitectures)"
                            DisableArchitectures="$(RedBoltDisableArchitectures)"
                            SavedEnablePlatforms="$(_RedBoltSavedEnablePlatforms)"
                            SavedDisablePlatforms="$(_RedBoltSavedDisablePlatforms)"
                            SavedEnableArchitectures="$(_RedBoltSavedEnableArchitectures)"
                            SavedDisableArchitectures="$(_RedBoltSavedDisableArchitectures)" />
  </Target>

  <Target Name="RedBoltPersistBuildRoot"
          AfterTargets="Build;Rebuild"
          Condition="'$(BuildingSolutionFile)' == 'true'
                     and '$(SolutionName)' == 'RedBolt'
                     and '$(MSBuildProjectName)' == 'RedBolt.Core'">
    <ItemGroup>
      <_RedBoltBuildRootConfig Include="$(RedBoltRoot)/build/BuildRoot.props" />
      <!-- Include disabled sibling modules so their next direct build follows the monorepo root. -->
      <_RedBoltModuleSolutionProps Include="$(SolutionDir)RedBolt.*/Directory.Solution.props" />
      <_RedBoltBuildRootConfig Include="@(_RedBoltModuleSolutionProps->'%(RootDir)%(Directory)build/BuildRoot.props')" />
    </ItemGroup>
    <RedBoltSaveBuildRoot ConfigFile="%(_RedBoltBuildRootConfig.Identity)"
                          BuildRoot="$(RedBoltBuildRoot)" />
  </Target>
</Project>
