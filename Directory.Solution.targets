<Project>
  <!--
    Solution-scoped targets.
    Defines the targets that bootstrap dependencies, expose the
    IDE-only web sample entry point, and persist the effective platform selection and build root
    after a solution build.
  -->
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <RedBoltDependencyConfigurePreset Condition="'$(Configuration)' == 'Release'">linux-x64-release</RedBoltDependencyConfigurePreset>
    <RedBoltDependencyConfigurePreset Condition="'$(RedBoltDependencyConfigurePreset)' == ''">linux-x64</RedBoltDependencyConfigurePreset>
    <!-- The solution and the one project that save the selection: see RedBoltPersistBuildConfiguration. -->
    <RedBoltBuildConfigSolutionName>RedBolt</RedBoltBuildConfigSolutionName>
    <RedBoltBuildConfigProjectName>RedBolt.Core</RedBoltBuildConfigProjectName>
    <RedBoltBuildConfigSolutionName Condition="'$(RedBoltExternalModuleName)' != ''">$(RedBoltExternalModuleName)</RedBoltBuildConfigSolutionName>
    <RedBoltBuildConfigProjectName Condition="'$(RedBoltExternalModuleName)' != ''">$(RedBoltExternalModuleName)</RedBoltBuildConfigProjectName>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Directory.Solution.SharpCpp.targets" />

  <!-- The projects report an unknown RedBoltEnable item themselves, but only after the solution has
       restored. Fail the solution first, so that a bad selection does not run the dependency configure. -->
  <Target Name="RedBoltValidateEnableSelection"
          BeforeTargets="_LoadRestoreGraphEntryPoints;Restore;Build;Rebuild"
          Condition="'$(_RedBoltEnableUnknownItems)' != ''">
    <Error Text="$(_RedBoltEnableInvalidMessage)" />
  </Target>

  <!--
    Refreshes third-party source dependencies before every restore. These dependencies are pulled
    in by CMake/CPM, so the configure preset must run even when the source trees already exist: CPM
    declarations and pinned revisions can change between builds. The checks below keep failures
    explicit when the configure step cannot populate a required dependency. The preset's own binary
    directory and default output directories are below this repository, so the configure tree and
    its output directories are redirected below the build root.
  -->
  <Target Name="RedBoltEnsureDependencies"
          DependsOnTargets="RedBoltValidateEnableSelection"
          BeforeTargets="_LoadRestoreGraphEntryPoints;Restore">
    <PropertyGroup>
      <_RedBoltCpmSharpCppRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)extern/SharpCpp'))</_RedBoltCpmSharpCppRoot>
    </PropertyGroup>
    <Error Condition="'$(RedBoltMonorepoRoot)' != '' and '$(RedBoltSharpCppRoot)' == '$(_RedBoltCpmSharpCppRoot)'"
           Text="Monorepo checkout '$(RedBoltMonorepoRoot)' has no extern/SharpCpp; check it out there." />
    <Exec Command="cmake --preset $(RedBoltDependencyConfigurePreset) -B &quot;$(RedBoltBuildRoot)/native/$(RedBoltDependencyConfigurePreset)&quot; &quot;-DREDBOLT_SHARPCPP_ROOT=$(RedBoltSharpCppRoot)&quot; &quot;-DREDBOLT_RUNTIME_OUTPUT_DIR=$(RedBoltBuildRoot)/bin/$&lt;CONFIG&gt;/linux-x64/extern/runtimes/linux-x64/native&quot; &quot;-DREDBOLT_PDB_OUTPUT_DIR=$(RedBoltBuildRoot)/bin/$&lt;CONFIG&gt;/linux-x64/extern/pdb&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" />
    <Error Condition="!Exists('$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj')"
           Text="SharpCpp is missing at '$(RedBoltSharpCppRoot)'." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)extern/IconFontCppHeaders/IconsFontAwesome6.cs')"
           Text="CPM did not populate IconFontCppHeaders below '$(MSBuildThisFileDirectory)extern/IconFontCppHeaders'." />
  </Target>

  <!-- C# Dev Kit addresses an IDE-selected project through its solution target,
       even when that project is intentionally excluded from solution-wide builds. -->
  <Target Name="src\RedBolt\Sample\RedBolt_Sample_Web">
    <MSBuild Projects="$(MSBuildThisFileDirectory)src/RedBolt/Sample/Web/RedBolt.Sample.Web.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=$(Platform)" />
  </Target>

  <!--
    Persists the effective RedBoltEnable selection after a successful solution build.
    The save is gated to a single representative project per solution (RedBolt.Core for the core
    solution, or the external module project itself for module solutions) so the file is written
    exactly once per build even though the target is imported by every project.
  -->
  <Target Name="RedBoltPersistBuildConfiguration"
          AfterTargets="Build;Rebuild"
          Condition="'$(BuildingSolutionFile)' == 'true'
                     and '$(RedBoltPlatform)' == 'linux-x64'
                     and '$(SolutionName)' == '$(RedBoltBuildConfigSolutionName)'
                     and '$(MSBuildProjectName)' == '$(RedBoltBuildConfigProjectName)'">
    <!-- The canonical form: lowercase items with single comma separators. The order stays (the last
         matching item wins). The file is written only when the selection changes, so an unchanged
         build keeps its modification time. WriteLinesToFile writes a temporary file and renames it, so a
         concurrent reader sees the old file or the new file. -->
    <PropertyGroup>
      <_RedBoltEnableCanonical>$([System.Text.RegularExpressions.Regex]::Replace(`$([System.String]::Copy('$(_RedBoltEnableInput)').ToLowerInvariant())`, `[\s;,]+`, `,`).Trim(','))</_RedBoltEnableCanonical>
      <_RedBoltSavedEnableCanonical>$([System.Text.RegularExpressions.Regex]::Replace(`$([System.String]::Copy('$(_RedBoltSavedEnable)').ToLowerInvariant())`, `[\s;,]+`, `,`).Trim(','))</_RedBoltSavedEnableCanonical>
    </PropertyGroup>
    <!-- The lines are a task parameter and not an item: an item Include expands a '*' selection as a wildcard. -->
    <WriteLinesToFile File="$(RedBoltBuildConfigPath)" Overwrite="true"
                      Lines="&lt;Project&gt;;&lt;PropertyGroup&gt;;&lt;_RedBoltSavedEnable&gt;$(_RedBoltEnableCanonical)&lt;/_RedBoltSavedEnable&gt;;&lt;RedBoltEnable Condition=&quot;'%24(RedBoltEnable)' == ''&quot;&gt;$(_RedBoltEnableCanonical)&lt;/RedBoltEnable&gt;;&lt;/PropertyGroup&gt;;&lt;/Project&gt;"
                      Condition="'$(_RedBoltEnableCanonical)' != '$(_RedBoltSavedEnableCanonical)'" />
    <Message Importance="high" Text="Saved RedBolt build configuration to '$(RedBoltBuildConfigPath)'."
             Condition="'$(_RedBoltEnableCanonical)' != '$(_RedBoltSavedEnableCanonical)'" />
  </Target>
</Project>
