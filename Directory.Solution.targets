<Project>
  <PropertyGroup>
    <RedBoltSolutionBuildRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)build'))</RedBoltSolutionBuildRoot>
    <RedBoltWebSampleProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src/RedBolt/Sample/Web/RedBolt.Sample.Web.csproj'))</RedBoltWebSampleProject>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
  </PropertyGroup>

  <Target Name="RedBoltConfigureSolutionRestore"
          BeforeTargets="_FilterRestoreGraphProjectInputItems">
    <PropertyGroup>
      <_GenerateRestoreGraphProjectEntryInputProperties>
        $(_GenerateRestoreGraphProjectEntryInputProperties);
        SharpCppBuildRoot=$(RedBoltSolutionBuildRoot);
        SharpCppOutputDir=$(RedBoltSolutionBuildRoot)/bin/$(Configuration)/tools;
        SharpCppIntermediateRoot=$(RedBoltSolutionBuildRoot)/obj/managed/tools
      </_GenerateRestoreGraphProjectEntryInputProperties>
    </PropertyGroup>
  </Target>

  <Target Name="RedBoltRestoreBrowserProjects"
          AfterTargets="Restore">
    <MSBuild Projects="$(RedBoltWebSampleProject)"
             Targets="Restore"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);RedBoltPlatform=browser-wasm;RedBoltNativePreset=browser-wasm" />
  </Target>

</Project>
