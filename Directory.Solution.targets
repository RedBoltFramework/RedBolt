<Project>
  <PropertyGroup>
    <RedBoltSolutionBuildRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)build'))</RedBoltSolutionBuildRoot>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <RedBoltWebProject>$(MSBuildThisFileDirectory)src/RedBolt/Sample/Web/RedBolt.Sample.Web.csproj</RedBoltWebProject>
  </PropertyGroup>

  <Target Name="RedBoltConfigureSolutionProjectProperties" BeforeTargets="Build">
    <ItemGroup>
      <ProjectReference Update="@(ProjectReference)">
        <AdditionalProperties>%(ProjectReference.AdditionalProperties);ShouldUnsetParentConfigurationAndPlatform=false</AdditionalProperties>
      </ProjectReference>
    </ItemGroup>
  </Target>

  <Target Name="RedBoltConfigureSolutionRestore"
          BeforeTargets="_FilterRestoreGraphProjectInputItems">
    <PropertyGroup>
      <_GenerateRestoreGraphProjectEntryInputProperties>
        $(_GenerateRestoreGraphProjectEntryInputProperties);
        SharpCppBuildRoot=$(RedBoltSolutionBuildRoot);
        SharpCppOutputDir=$(RedBoltSolutionBuildRoot)/bin/$(Configuration)/tools;
        SharpCppIntermediateRoot=$(RedBoltSolutionBuildRoot)/obj/managed/tools
      </_GenerateRestoreGraphProjectEntryInputProperties>
    </PropertyGroup>
  </Target>

  <Target Name="RedBoltBuildWeb" AfterTargets="Build">
    <MSBuild Projects="$(RedBoltWebProject)"
             Targets="Restore;Build"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);RedBoltPlatform=browser-wasm;RedBoltNativePreset=browser-wasm;ShouldUnsetParentConfigurationAndPlatform=false" />
  </Target>
</Project>
