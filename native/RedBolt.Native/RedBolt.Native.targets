<Project>
  <PropertyGroup>
    <RedBoltCMakeTarget Condition="'$(RedBoltPlatform)' == 'linux-gcc-x64-dll'">RedBolt.Native</RedBoltCMakeTarget>
    <RedBoltCMakeTarget Condition="'$(RedBoltPlatform)' == 'web-emscripten-wasm'">redbolt-wasm-native</RedBoltCMakeTarget>
    <RedBoltCMakeConfigurationArguments Condition="'$(RedBoltPlatform)' == 'linux-gcc-x64-dll'">--config &quot;$(Configuration)&quot;</RedBoltCMakeConfigurationArguments>
  </PropertyGroup>

  <Target Name="RedBoltBuildNative" AfterTargets="Build">
    <Error Condition="'$(RedBoltNativePreset)' == ''"
           Text="RedBoltNativePreset is not configured for RedBoltPlatform '$(RedBoltPlatform)'." />
    <Error Condition="'$(RedBoltCMakeTarget)' == ''"
           Text="No CMake target is configured for RedBoltPlatform '$(RedBoltPlatform)'." />
    <Error Condition="!Exists('$(RedBoltSharpCppRoot)')"
           Text="SharpCpp was not found at '$(RedBoltSharpCppRoot)'." />
    <Error Condition="!Exists('$(SharpCppOutputDir)/RedBolt.Dependencies.Generator.dll')"
           Text="The RedBolt dependency generator was not built at '$(SharpCppOutputDir)/RedBolt.Dependencies.Generator.dll'." />
    <MakeDir Directories="$(RedBoltBuildRoot);$(RedBoltOutputDir);$(RedBoltIntermediateRoot)" />
    <Exec WorkingDirectory="$(RedBoltRoot)"
          Command="cmake -DREDBOLT_SOURCE_DIR=&quot;$(RedBoltRoot)&quot; -DREDBOLT_NATIVE_PRESET=&quot;$(RedBoltNativePreset)&quot; -DREDBOLT_NATIVE_BUILD_DIR=&quot;$(RedBoltNativeBuildDir)&quot; -DREDBOLT_NATIVE_TARGET=&quot;$(RedBoltCMakeTarget)&quot; -DREDBOLT_CONFIGURATION=&quot;$(Configuration)&quot; -DREDBOLT_SHARPCPP_ROOT=&quot;$(RedBoltSharpCppRoot)&quot; -DREDBOLT_GENERATOR_DLL=&quot;$(SharpCppOutputDir)/RedBolt.Dependencies.Generator.dll&quot; -DREDBOLT_RUNTIME_OUTPUT_DIR=&quot;$(RedBoltNativeOutputRoot)&quot; -P &quot;$(MSBuildThisFileDirectory)BuildNative.cmake&quot;" />
    <Exec Condition="'$(RedBoltPlatform)' == 'linux-gcc-x64-dll' and !Exists('$(RedBoltNativeOutputRoot)/CoreData')"
          Command="cmake -E create_symlink &quot;$(RedBoltRoot)/bin/CoreData&quot; &quot;$(RedBoltNativeOutputRoot)/CoreData&quot;" />
    <Exec Condition="'$(RedBoltPlatform)' == 'linux-gcc-x64-dll' and !Exists('$(RedBoltNativeOutputRoot)/Data')"
          Command="cmake -E create_symlink &quot;$(RedBoltRoot)/bin/Data&quot; &quot;$(RedBoltNativeOutputRoot)/Data&quot;" />
  </Target>

  <Target Name="RedBoltCleanNative" AfterTargets="Clean">
    <Exec WorkingDirectory="$(RedBoltRoot)"
          Condition="Exists('$(RedBoltNativeBuildDir)/CMakeCache.txt')"
          Command="cmake -E env REDBOLT_MSBUILD_BUILD=1 cmake --build &quot;$(RedBoltNativeBuildDir)&quot; $(RedBoltCMakeConfigurationArguments) --target clean" />
  </Target>
</Project>
