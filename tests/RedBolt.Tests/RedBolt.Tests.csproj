<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RedBolt.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RedBolt.Bindings.Diligent/RedBolt.Bindings.Diligent.csproj" />
    <ProjectReference Include="../../src/RedBolt.Bindings.Glslang/RedBolt.Bindings.Glslang.csproj" />
    <ProjectReference Include="../../src/RedBolt.Bindings.SpirVCross/RedBolt.Bindings.SpirVCross.csproj" />
    <ProjectReference Include="../../src/RedBolt.Bindings.SpirVTools/RedBolt.Bindings.SpirVTools.csproj" />
    <ProjectReference Include="../../src/RedBolt/RedBolt.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SharpCpp.Support">
      <HintPath>$(SharpCppOutputDir)/SharpCpp.Support.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="TestData\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
