<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RedBolt.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(RedBoltRoot)/src/RedBolt/GlobalAliases.cs"
             Link="GlobalAliases.cs"
             Visible="false" />
    <ProjectReference Include="../../src/RedBolt.Bindings.Diligent/RedBolt.Bindings.Diligent.csproj" />
    <ProjectReference Include="../../src/RedBolt.Bindings.Glslang/RedBolt.Bindings.Glslang.csproj" />
    <ProjectReference Include="../../src/RedBolt.Bindings.SpirVCross/RedBolt.Bindings.SpirVCross.csproj" />
    <ProjectReference Include="../../src/RedBolt.Bindings.SpirVTools/RedBolt.Bindings.SpirVTools.csproj" />
    <ProjectReference Include="../../src/RedBolt/RedBolt.csproj" />
    <ProjectReference Include="../../src/RedBolt.Platform.Linux/RedBolt.Platform.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj"
                      PrivateAssets="all"
                      RedBoltProperties="$(RedBoltSharpCppManagedProperties)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="xunit.runner.json" />
    <Content Include="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
