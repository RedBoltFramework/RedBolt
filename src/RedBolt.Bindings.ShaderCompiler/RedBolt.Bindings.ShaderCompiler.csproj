<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RedBolt.Bindings.ShaderCompiler</AssemblyName>
    <EnableLibraryImportGenerator>true</EnableLibraryImportGenerator>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>

  <ItemGroup Condition="'$(RedBoltGeneratedBindingsDir)' != '' and Exists('$(RedBoltGeneratedBindingsDir)/shader-compiler')">
    <Compile Include="$(RedBoltGeneratedBindingsDir)/shader-compiler/**/*.g.cs" LinkBase="Generated" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SharpCpp.Support">
      <HintPath>$(SharpCppOutputDir)/SharpCpp.Support.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
