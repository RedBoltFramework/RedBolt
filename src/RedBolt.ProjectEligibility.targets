<Project>
  <!--
    Per-project build eligibility. Imported via CustomAfterMicrosoftCommonTargets so that projects
    excluded by the current RedBoltEnable/module selection short-circuit their Build/Rebuild
    with a message instead of compiling. The three inputs (_RedBoltProjectPlatformEnabled,
    _RedBoltProjectModuleEnabled, _RedBoltProjectPlatformSupported) are combined into
    RedBoltProjectBuildEnabled.
  -->
  <PropertyGroup>
    <!-- A project is platform-enabled when its RedBoltPlatform is one of the RIDs selected by RedBoltEnable. -->
    <_RedBoltProjectPlatformEnabled>false</_RedBoltProjectPlatformEnabled>
    <_RedBoltProjectPlatformEnabled Condition="'$(RedBoltPlatform)' == 'tools'">true</_RedBoltProjectPlatformEnabled>
    <_RedBoltProjectPlatformEnabled Condition="'$(RedBoltPlatform)' == 'linux-x64' and '$(RedBoltLinuxX64Enabled)' == 'true'">true</_RedBoltProjectPlatformEnabled>
    <_RedBoltProjectPlatformEnabled Condition="'$(RedBoltPlatform)' == 'win-x64' and '$(RedBoltWinX64Enabled)' == 'true'">true</_RedBoltProjectPlatformEnabled>
    <_RedBoltProjectPlatformEnabled Condition="'$(RedBoltPlatform)' == 'android-x64' and '$(RedBoltAndroidX64Enabled)' == 'true'">true</_RedBoltProjectPlatformEnabled>
    <_RedBoltProjectPlatformEnabled Condition="'$(RedBoltPlatform)' == 'android-arm64' and '$(RedBoltAndroidArm64Enabled)' == 'true'">true</_RedBoltProjectPlatformEnabled>
    <_RedBoltProjectPlatformEnabled Condition="'$(RedBoltPlatform)' == 'browser-wasm' and '$(RedBoltBrowserWasmEnabled)' == 'true'">true</_RedBoltProjectPlatformEnabled>

    <!-- Modules are always enabled in this setup; only platform rules can block a project build. -->
    <_RedBoltProjectModuleEnabled>true</_RedBoltProjectModuleEnabled>

    <!-- A project is platform-supported only if its platform-specific variants (Native/Sample
         Android/Web) match RedBoltPlatform; desktop-only projects are unsupported on wasm/android. -->
    <_RedBoltProjectPlatformSupported>true</_RedBoltProjectPlatformSupported>
    <_RedBoltProjectPlatformSupported Condition="'$(MSBuildProjectName)' == 'RedBolt.Sample.Android' and !$([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-'))">false</_RedBoltProjectPlatformSupported>
    <_RedBoltProjectPlatformSupported Condition="'$(MSBuildProjectName)' == 'RedBolt.Sample.Web' and '$(RedBoltPlatform)' != 'browser-wasm'">false</_RedBoltProjectPlatformSupported>
    <_RedBoltProjectPlatformSupported Condition="(('$(MSBuildProjectName)' != 'RedBolt.Sample.Android' and '$(MSBuildProjectName)' != 'RedBolt.Sample.Web' and $([System.String]::Copy('$(MSBuildProjectName)').StartsWith('RedBolt.Sample.'))) or '$(MSBuildProjectName)' == 'RedBolt.Editor' or '$(MSBuildProjectName)' == 'RedBolt.UserCode.Desktop' or '$(MSBuildProjectName)' == 'RedBolt.Tests') and '$(RedBoltPlatform)' != 'linux-x64' and '$(RedBoltPlatform)' != 'win-x64'">false</_RedBoltProjectPlatformSupported>
    <_RedBoltProjectPlatformSupported Condition="('$(MSBuildProjectName)' == 'RedBolt.Utility' or '$(MSBuildProjectName)' == 'RedBolt.Bindings.TinyGltf') and '$(RedBoltPlatform)' == 'browser-wasm'">false</_RedBoltProjectPlatformSupported>
    <_RedBoltProjectPlatformSupported Condition="$([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-')) and '$(RedBoltAndroidSupported)' == 'false'">false</_RedBoltProjectPlatformSupported>
    <_RedBoltProjectPlatformSupported Condition="'$(MSBuildProjectName)' == '$(RedBoltExternalBindingsProjectName)' and '$(RedBoltPlatform)' == 'browser-wasm' and '$(RedBoltExternalWebNativeEnabled)' != 'true'">false</_RedBoltProjectPlatformSupported>

    <!-- Final decision. RedBoltIgnoreBuildSelection force-builds a project regardless of selection
         (used by bootstrap targets that must build a tool/generator on demand). -->
    <RedBoltProjectBuildEnabled Condition="'$(_RedBoltProjectPlatformEnabled)' == 'true' and '$(_RedBoltProjectPlatformSupported)' == 'true' and '$(_RedBoltProjectModuleEnabled)' == 'true'">true</RedBoltProjectBuildEnabled>
    <RedBoltProjectBuildEnabled Condition="'$(RedBoltIgnoreBuildSelection)' == 'true'">true</RedBoltProjectBuildEnabled>
    <RedBoltProjectBuildEnabled Condition="'$(RedBoltProjectBuildEnabled)' == ''">false</RedBoltProjectBuildEnabled>
    <!-- Wasm apps defer their real build to publish; a disabled wasm project still needs this flag so
         the SDK does not try to build it during the normal build phase. -->
    <WasmBuildOnlyAfterPublish Condition="'$(RedBoltProjectBuildEnabled)' != 'true' and '$(RedBoltPlatform)' == 'browser-wasm'">true</WasmBuildOnlyAfterPublish>
    <!-- Android projects re-evaluate eligibility after the .NET Android SDK targets load (they
         override BuildDependsOn), hence the chained AndroidProjectEligibility targets. -->
    <AfterMicrosoftNETSdkTargets>$(AfterMicrosoftNETSdkTargets);$(MSBuildThisFileDirectory)RedBolt.AndroidProjectEligibility.targets</AfterMicrosoftNETSdkTargets>
  </PropertyGroup>

  <!-- Short-circuit Build/Rebuild for excluded projects. -->
  <PropertyGroup Condition="'$(RedBoltProjectBuildEnabled)' != 'true'">
    <BuildDependsOn>RedBoltReportSkippedProject</BuildDependsOn>
    <RebuildDependsOn>RedBoltReportSkippedProject</RebuildDependsOn>
  </PropertyGroup>

  <!-- An unknown RedBoltEnable item fails every project, enabled or skipped, before any real work
       starts (the property is computed during evaluation, which must not throw). -->
  <Target Name="RedBoltReportInvalidEnable"
          BeforeTargets="RedBoltReportSkippedProject;BeforeBuild;BeforeRebuild;_LoadRestoreGraphEntryPoints;Restore"
          Condition="'$(_RedBoltEnableUnknownItems)' != ''">
    <Error Text="Invalid RedBoltEnable item(s) '$(_RedBoltEnableUnknownItems)' in '$(_RedBoltEnableInput)'. Valid items are 'all', '*', the RIDs linux-x64, win-x64, android-x64, android-arm64 and browser-wasm, and the tokens linux, win, android, browser, x64, arm64 and wasm, each optionally prefixed with '+' or '-'." />
  </Target>

  <Target Name="RedBoltReportSkippedProject">
    <Message Importance="high"
             Text="Skipping $(MSBuildProjectName): it is disabled for RedBolt platform '$(RedBoltPlatform)'." />
  </Target>
</Project>
