<Project>
  <!-- Import solution-level targets (config persistence, dependency bootstrap) when this build is a
       solution traversal rather than a single project. -->
  <Import Project="$(RedBoltRoot)/Directory.Solution.targets"
          Condition="'$(BuildingSolutionFile)' == 'true'" />

  <!--
    Generator projects always build as host net10.0 tools. Force that target framework and strip
    platform/restore global properties that would otherwise leak from the parent project and make
    the generator restore against the wrong TFM.
  -->
  <ItemGroup>
    <!-- Editor extensions load RedBolt.Editor from the host process. Copying its exe and deps.json
         into every extension's shared core output creates concurrent writes to the same files. -->
    <ProjectReference Update="$(RedBoltRoot)/src/RedBolt/Editor/RedBolt.Editor.csproj">
      <Private>false</Private>
    </ProjectReference>

    <ProjectReference Update="@(ProjectReference->WithMetadataValue('Filename', 'RedBolt.Generator.Dependencies'));@(ProjectReference->WithMetadataValue('Filename', 'RedBolt.Generator.Reflection'))">
      <GlobalPropertiesToRemove>%(ProjectReference.GlobalPropertiesToRemove);$(RedBoltHostProjectGlobalPropertiesToRemove)</GlobalPropertiesToRemove>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Update="@(ProjectReference->WithMetadataValue('Filename', 'RedBolt.PackageTool'))"
                      SetTargetFramework="TargetFramework=net10.0"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="RedBoltPlatform;RedBoltTargetFramework;TargetFramework;TargetFrameworks;RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishSelfContained" />
  </ItemGroup>

  <!-- The SDK adds transitive project references after evaluation. Normalize only SharpCpp edges at
       that point so platform and Android outer-build globals cannot create duplicate host builds.
       SharpCpp's own references pass Configuration as a global property. In a solution that does not
       list the SharpCpp projects the SDK removes it on these edges instead, which builds the SharpCpp
       projects reached both ways twice; RedBoltKeepConfigurationOnOutOfSolutionReferences keeps it, and
       this target passes it the same way also when the SDK did not remove it. -->
  <Target Name="RedBoltNormalizeSharpCppProjectReferences"
          AfterTargets="_SplitProjectReferencesByFileExistence"
          BeforeTargets="_GetProjectReferenceTargetFrameworkProperties;ResolveProjectReferences">
    <ItemGroup>
      <_MSBuildProjectReferenceExistent Update="@(_MSBuildProjectReferenceExistent)"
          Condition="$([System.String]::Copy('%(_MSBuildProjectReferenceExistent.FullPath)').StartsWith('$(RedBoltSharpCppRoot)/src/'))">
        <GlobalPropertiesToRemove>%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove);$(RedBoltHostProjectGlobalPropertiesToRemove)</GlobalPropertiesToRemove>
        <AdditionalProperties Condition="!$([System.String]::Copy('%(_MSBuildProjectReferenceExistent.AdditionalProperties)').Contains('CustomAfterDirectoryBuildProps='))">%(_MSBuildProjectReferenceExistent.AdditionalProperties);$(RedBoltSharpCppManagedProperties)</AdditionalProperties>
        <SetConfiguration Condition="!$([System.String]::Copy(';%(_MSBuildProjectReferenceExistent.SetConfiguration)').Contains(';Configuration='))">%(_MSBuildProjectReferenceExistent.SetConfiguration);Configuration=$(Configuration)</SetConfiguration>
      </_MSBuildProjectReferenceExistent>
    </ItemGroup>
  </Target>

  <!-- References that leave a solution lose Configuration (the SDK removes it); a Release solution
       build then builds the referenced RedBolt projects as Debug. Keep it and pass it explicitly, as the
       SharpCpp edges do. Platform stays removed. Edges where the SDK did not remove it are untouched. -->
  <Target Name="RedBoltKeepConfigurationOnOutOfSolutionReferences"
          AfterTargets="_SplitProjectReferencesByFileExistence;RedBoltNormalizeSharpCppProjectReferences"
          BeforeTargets="_GetProjectReferenceTargetFrameworkProperties;ResolveProjectReferences">
    <ItemGroup>
      <_MSBuildProjectReferenceExistent Update="@(_MSBuildProjectReferenceExistent)"
          Condition="$([System.String]::Copy(';%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove);').Contains(';Configuration;'))">
        <GlobalPropertiesToRemove>$([System.String]::Copy(';%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove);').Replace(';Configuration;', ';'))</GlobalPropertiesToRemove>
        <SetConfiguration Condition="!$([System.String]::Copy(';%(_MSBuildProjectReferenceExistent.SetConfiguration)').Contains(';Configuration='))">%(_MSBuildProjectReferenceExistent.SetConfiguration);Configuration=$(Configuration)</SetConfiguration>
      </_MSBuildProjectReferenceExistent>
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(RedBoltPlatform)' == 'browser-wasm'">
    <ProjectReference Remove="$(RedBoltRoot)/src/RedBolt/Utility/RedBolt.Utility.csproj;$(RedBoltRoot)/src/RedBolt/Native/TinyGltf/RedBolt.Bindings.TinyGltf.csproj" />
    <ProjectReference Update="$(RedBoltRoot)/src/RedBolt/**/*.csproj">
      <AdditionalProperties>%(ProjectReference.AdditionalProperties);RedBoltPlatform=browser-wasm</AdditionalProperties>
      <SetTargetFramework>TargetFramework=net10.0;RedBoltPlatform=browser-wasm</SetTargetFramework>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <GlobalPropertiesToRemove>%(ProjectReference.GlobalPropertiesToRemove);RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishSelfContained</GlobalPropertiesToRemove>
    </ProjectReference>
    <ProjectReference Update="$(RedBoltMonorepoRoot)RedBolt.*/src/RedBolt/**/*.csproj" Condition="'$(RedBoltMonorepoRoot)' != ''">
      <AdditionalProperties>%(ProjectReference.AdditionalProperties);RedBoltPlatform=browser-wasm</AdditionalProperties>
      <SetTargetFramework>TargetFramework=net10.0;RedBoltPlatform=browser-wasm</SetTargetFramework>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <GlobalPropertiesToRemove>%(ProjectReference.GlobalPropertiesToRemove);RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishSelfContained</GlobalPropertiesToRemove>
    </ProjectReference>
    <ProjectReference Update="@(ProjectReference->WithMetadataValue('Filename', 'RedBolt.Generator.Dependencies'));@(ProjectReference->WithMetadataValue('Filename', 'RedBolt.Generator.Reflection'))">
      <AdditionalProperties></AdditionalProperties>
      <SetTargetFramework></SetTargetFramework>
      <SkipGetTargetFrameworkProperties>false</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <ProjectReference Update="@(ProjectReference->WithMetadataValue('Filename', 'RedBolt.PackageTool'))">
      <!-- The tool is a host project. Force it only when the host platform is not selected, or when
           RedBoltBuildPlatform makes it build for another platform: the flag is
           a global property of the tool and of everything below it, so with the host platform selected
           it would build them a second time beside the solution's own instances. -->
      <AdditionalProperties></AdditionalProperties>
      <AdditionalProperties Condition="('$(RedBoltBuildWindows)' != 'true' and '$(RedBoltLinuxX64Enabled)' != 'true') or '$(RedBoltBuildPlatform)' != ''">RedBoltIgnoreBuildSelection=true</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <Target Name="RedBoltComputeReferencePattern">
    <PropertyGroup>
      <!-- This repository's projects, and the projects of the modules beside it: for a module build, and for the monorepo aggregate build. -->
      <_RedBoltReferencePattern>^$([System.Text.RegularExpressions.Regex]::Escape('$(RedBoltRoot)'))[\\/]src[\\/]RedBolt[\\/]</_RedBoltReferencePattern>
      <_RedBoltReferencePattern Condition="'$(RedBoltExternalModuleRoot)' != ''">$(_RedBoltReferencePattern)|^$([System.Text.RegularExpressions.Regex]::Escape('$([System.IO.Path]::GetFullPath('$(RedBoltExternalModuleRoot)/..'))'))[\\/]RedBolt\.[^\\/]+[\\/]src[\\/]RedBolt[\\/]</_RedBoltReferencePattern>
      <_RedBoltReferencePattern Condition="'$(RedBoltMonorepoRoot)' != ''">$(_RedBoltReferencePattern)|^$([System.Text.RegularExpressions.Regex]::Escape('$([System.String]::Copy('$(RedBoltMonorepoRoot)').TrimEnd('/').TrimEnd('\'))'))[\\/]RedBolt\.[^\\/]+[\\/]src[\\/]RedBolt[\\/]</_RedBoltReferencePattern>
    </PropertyGroup>
  </Target>

  <!-- The item group above reaches only the references a project declares. The SDK adds the transitive
       ones after evaluation, and those would build the same wasm projects a second time without the
       TargetFramework global property. Give them the same edge. -->
  <Target Name="RedBoltNormalizeWasmTransitiveProjectReferences"
          Condition="'$(RedBoltPlatform)' == 'browser-wasm'"
          DependsOnTargets="RedBoltComputeReferencePattern"
          AfterTargets="_SplitProjectReferencesByFileExistence"
          BeforeTargets="_GetProjectReferenceTargetFrameworkProperties;ResolveProjectReferences">
    <ItemGroup>
      <_MSBuildProjectReferenceExistent Update="@(_MSBuildProjectReferenceExistent)"
          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_MSBuildProjectReferenceExistent.FullPath)', '$(_RedBoltReferencePattern)'))
                     and '%(_MSBuildProjectReferenceExistent.SkipGetTargetFrameworkProperties)' != 'true'
                     and !$([System.String]::Copy('%(_MSBuildProjectReferenceExistent.Filename)').Contains('.Generator.'))">
        <AdditionalProperties>%(_MSBuildProjectReferenceExistent.AdditionalProperties);RedBoltPlatform=browser-wasm</AdditionalProperties>
        <SetTargetFramework>TargetFramework=net10.0;RedBoltPlatform=browser-wasm</SetTargetFramework>
        <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
        <GlobalPropertiesToRemove>%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove);RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishSelfContained</GlobalPropertiesToRemove>
      </_MSBuildProjectReferenceExistent>
    </ItemGroup>
  </Target>

  <!-- Same for android: a reference would otherwise build the library project a second time with the
       host's RuntimeIdentifier global properties. An item definition also reaches the transitive
       references that the SDK adds after evaluation. -->
  <ItemDefinitionGroup Condition="$([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-'))">
    <ProjectReference>
      <GlobalPropertiesToRemove>$(RedBoltInnerBuildGlobalPropertiesToRemove)</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemDefinitionGroup>

  <!-- NuGet walks project paths without ProjectReference metadata. Preserve the entry project's
       platform so each restore graph writes to the asset directory used by its build graph. -->
  <Target Name="RedBoltConfigureRestoreGraph"
          BeforeTargets="_FilterRestoreGraphProjectInputItems;_GenerateRestoreProjectPathItemsPerFramework;_GenerateProjectRestoreGraphPerFramework">
    <PropertyGroup>
      <_GenerateRestoreGraphProjectEntryInputProperties>$(_GenerateRestoreGraphProjectEntryInputProperties);RedBoltPlatform=$(RedBoltPlatform);RedBoltTargetFramework=$(RedBoltTargetFramework);SharpCppBuildRoot=$(RedBoltBuildRoot);SharpCppOutputDir=$(SharpCppOutputDir);SharpCppIntermediateRoot=$(SharpCppIntermediateRoot);CustomAfterDirectoryBuildProps=$(RedBoltSharpCppRestoreProps)</_GenerateRestoreGraphProjectEntryInputProperties>
    </PropertyGroup>
  </Target>

  <!--
    Inline task that rewrites an application's deps.json so it consumes assemblies/native assets from
    the shared parent build output instead of building its own copy of every referenced project.
    For each referenced project (other than the main project itself) its project/reference/package
    entry is downgraded to a plain package entry pointing at the parent directory, and the native
    runtime assets for the modules selected by that dependency graph are injected into the
    "native" section of the appropriate runtime target. This is what makes executable/test projects
    work against the already-built core/extern buckets without re-linking them.
  -->
  <UsingTask TaskName="RedBoltUseParentRuntimeAssemblies"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs" Source="$(RedBoltRoot)/eng/RedBolt.ModuleBuild/Tasks/RedBoltUseParentRuntimeAssemblies.cs" />
    </Task>
  </UsingTask>

  <!-- Libraries are consumed via the parent deps.json, so they do not generate their own. -->
  <PropertyGroup Condition="'$(OutputType)' == 'Library'">
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <!-- PDBs are collected into a per-output bucket; dev .runtimeconfig.json files are only emitted
       for host executables and test projects. -->
  <PropertyGroup>
    <RedBoltGlobalAliasesFile>$(RedBoltRoot)/src/RedBolt/Core/GlobalAliases.cs</RedBoltGlobalAliasesFile>
    <RedBoltPdbOutputDir>$(RedBoltOutputDir)/pdb</RedBoltPdbOutputDir>
    <PdbFile>$(RedBoltPdbOutputDir)/$(AssemblyName).pdb</PdbFile>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <GenerateRuntimeConfigDevFile Condition="('$(RedBoltPlatform)' == 'tools' or '$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64') and ('$(OutputType)' == 'Exe' or '$(IsTestProject)' == 'true')">true</GenerateRuntimeConfigDevFile>
  </PropertyGroup>

  <!-- Host executables and tests probe the shared output buckets at runtime so they resolve the
       parent-built assemblies and native modules without copying them locally. -->
  <ItemGroup Condition="('$(RedBoltPlatform)' == 'tools' or '$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64') and ('$(OutputType)' == 'Exe' or '$(IsTestProject)' == 'true')">
    <AdditionalProbingPath Include="$(RedBoltCoreOutputDir)" />
    <AdditionalProbingPath Include="$(RedBoltExternOutputDir)" />
    <AdditionalProbingPath Include="$(RedBoltToolsOutputDir)" />
    <AdditionalProbingPath Include="$(RedBoltHostExternOutputDir)" />
    <AdditionalProbingPath Include="$(RedBoltHostToolsOutputDir)" />
  </ItemGroup>

  <!-- Guard against an unsupported platform being requested. -->
  <Target Name="RedBoltValidatePlatform" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(RedBoltPlatform)' != 'tools'
                      and '$(RedBoltPlatform)' != 'linux-x64'
                      and '$(RedBoltPlatform)' != 'win-x64'
                      and '$(RedBoltPlatform)' != 'browser-wasm'
                      and '$(RedBoltPlatform)' != 'android-x64'
                      and '$(RedBoltPlatform)' != 'android-arm64'"
           Text="Unsupported RedBolt platform '$(RedBoltPlatform)'." />
  </Target>

  <!-- The SDK target PrepareForBuild makes these directories and the output directory. -->
  <ItemGroup>
    <CreateDirectory Include="$(RedBoltPdbOutputDir);$(RedBoltOutputDir)/runtimes" />
  </ItemGroup>

  <!--
    On host builds, copy NuGet package runtime assets and external project outputs into the shared
    extern/ bucket (flattening managed libraries to their filename), then remove them from the local
    copy-local set. Centralizing these lets every executable resolve them via probing paths instead
    of duplicating per-project.
  -->
  <Target Name="RedBoltStageExternalRuntimeAssets"
          BeforeTargets="_CopyFilesMarkedCopyLocal"
          Condition="'$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64'">
    <ItemGroup>
      <_RedBoltExternalRuntimeAsset Include="@(ReferenceCopyLocalPaths)"
                                    Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' != 'ProjectReference' and '%(ReferenceCopyLocalPaths.PathInPackage)' != ''">
        <DestinationPath>$(RedBoltExternOutputDir)/%(ReferenceCopyLocalPaths.PathInPackage)</DestinationPath>
        <DestinationDirectory>$([System.IO.Path]::GetDirectoryName('$(RedBoltExternOutputDir)/%(ReferenceCopyLocalPaths.PathInPackage)'))</DestinationDirectory>
      </_RedBoltExternalRuntimeAsset>
      <_RedBoltExternalRuntimeAsset Condition="'%(_RedBoltExternalRuntimeAsset.Extension)' == '.dll' and !$([System.String]::Copy('%(_RedBoltExternalRuntimeAsset.Filename)').EndsWith('.resources')) and ($([System.String]::Copy('%(_RedBoltExternalRuntimeAsset.PathInPackage)').StartsWith('lib/')) or $([System.String]::Copy('%(_RedBoltExternalRuntimeAsset.PathInPackage)').Contains('/lib/')))">
        <DestinationPath>$(RedBoltExternOutputDir)/%(_RedBoltExternalRuntimeAsset.Filename)%(_RedBoltExternalRuntimeAsset.Extension)</DestinationPath>
        <DestinationDirectory>$(RedBoltExternOutputDir)</DestinationDirectory>
      </_RedBoltExternalRuntimeAsset>
      <_RedBoltExternalRuntimeAsset Include="@(ReferenceCopyLocalPaths)"
                                    Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' and !$([System.String]::Copy('%(ReferenceCopyLocalPaths.FullPath)').StartsWith('$(RedBoltBuildRoot)/'))">
        <DestinationPath>$(RedBoltExternOutputDir)/%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)</DestinationPath>
        <DestinationDirectory>$(RedBoltExternOutputDir)</DestinationDirectory>
      </_RedBoltExternalRuntimeAsset>
    </ItemGroup>
    <MakeDir Directories="@(_RedBoltExternalRuntimeAsset->'%(DestinationDirectory)')" />
    <Copy SourceFiles="@(_RedBoltExternalRuntimeAsset)"
          DestinationFiles="@(_RedBoltExternalRuntimeAsset->'%(DestinationPath)')"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
    </ItemGroup>
  </Target>

  <!-- Rewrite the generated deps.json (core solution, host executables/tests) to point at parent
       outputs and inject the selected native module assets. -->
  <Target Name="RedBoltConfigureRuntimeAssemblies"
          AfterTargets="GenerateBuildDependencyFile"
      Condition="$([System.String]::Copy('$(MSBuildProjectFullPath)').StartsWith('$(RedBoltRoot)/src/')) and ('$(RedBoltPlatform)' == 'tools' or '$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64') and ('$(OutputType)' == 'Exe' or '$(IsTestProject)' == 'true') and Exists('$(ProjectDepsFilePath)')">
    <RedBoltUseParentRuntimeAssemblies DependencyFile="$(ProjectDepsFilePath)"
                                       MainProjectName="$(AssemblyName)"
                                       NativeRuntimeDirectory="$(RedBoltNativeOutputRoot)"
                                       NativeModuleManifestDirectory="$(RedBoltNativeModuleManifestDirectory)"
                                       RuntimeIdentifier="$(RuntimeIdentifier)">
      <Output TaskParameter="NativeAssets" ItemName="_RedBoltNativeAssets" />
    </RedBoltUseParentRuntimeAssemblies>
  </Target>

  <!--
    Deletes a project's generated deps.json when it was produced for a different runtime identifier.
    deps.json files are keyed by RID; a stale file would keep the app resolving assemblies for the
    wrong platform.
  -->
  <Target Name="RedBoltInvalidateStaleRuntimeDependencyFile"
          BeforeTargets="GenerateBuildDependencyFile"
          Condition="'$(RuntimeIdentifier)' != '' and Exists('$(ProjectDepsFilePath)')">
    <Delete Files="$(ProjectDepsFilePath)"
            Condition="!$([System.IO.File]::ReadAllText('$(ProjectDepsFilePath)').Contains('/$(RuntimeIdentifier)&quot;: {'))" />
  </Target>

  <!--
    Makes the engine-wide GlobalAliases.cs available to any project that references RedBolt.Core
    (directly or via its resolved references). The file is injected as a hidden linked source so
    projects get the engine's type aliases without a shared source dependency.
  -->
  <Target Name="RedBoltIncludeGlobalAliases"
          BeforeTargets="CoreCompile"
          Condition="Exists('$(RedBoltGlobalAliasesFile)') and ('@(ProjectReference->WithMetadataValue(&quot;Filename&quot;, &quot;RedBolt.Core&quot;))' != '' or '@(ReferencePath->WithMetadataValue(&quot;Filename&quot;, &quot;RedBolt.Core&quot;))' != '')">
    <ItemGroup>
      <Compile Include="$(RedBoltGlobalAliasesFile)"
               Exclude="@(Compile)"
               Link="GlobalAliases.cs"
               Visible="false" />
    </ItemGroup>
  </Target>

  <!-- Core samples share the sample build content with the module samples. -->
  <Import Project="$(RedBoltRoot)/eng/RedBolt.ModuleBuild/Sample.targets"
          Condition="$([System.String]::Copy('$(MSBuildProjectFullPath)').StartsWith('$(RedBoltRoot)/src/RedBolt/Sample/'))" />
</Project>
