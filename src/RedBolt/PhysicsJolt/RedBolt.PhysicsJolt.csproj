<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RedBolt.PhysicsJolt</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Core/RedBolt.Core.csproj" />
    <ProjectReference Include="../Bindings/Jolt/RedBolt.Bindings.Jolt.csproj" />
    <ProjectReference Include="../Generator/Reflection/RedBolt.Generator.Reflection.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RedBoltPlatform;RedBoltNativePreset" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Core/GlobalUsings.cs" Link="GlobalUsings.cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj"
                      PrivateAssets="all"
                      AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
  </ItemGroup>
</Project>
