<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RedBolt</AssemblyName>
    <EnableLibraryImportGenerator>true</EnableLibraryImportGenerator>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <ProjectReference Include="../Bindings/Diligent/RedBolt.Bindings.Diligent.csproj" />
    <ProjectReference Include="../Bindings/Glslang/RedBolt.Bindings.Glslang.csproj" />
    <ProjectReference Include="../Bindings/ShaderCompiler/RedBolt.Bindings.ShaderCompiler.csproj" />
    <ProjectReference Include="../Bindings/Sdl/RedBolt.Bindings.Sdl.csproj" />
    <ProjectReference Include="../Bindings/SpirVCross/RedBolt.Bindings.SpirVCross.csproj" />
    <ProjectReference Include="../Bindings/SpirVTools/RedBolt.Bindings.SpirVTools.csproj" />
    <ProjectReference Include="../Bindings/Stb/RedBolt.Bindings.Stb.csproj" />
    <ProjectReference Include="../Bindings/Lz4/RedBolt.Bindings.Lz4.csproj" />
    <ProjectReference Include="../Bindings/WebP/RedBolt.Bindings.WebP.csproj" />
    <ProjectReference Include="../Generator/Reflection/RedBolt.Generator.Reflection.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RedBoltPlatform;RedBoltNativePreset" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj"
                      PrivateAssets="all"
                      AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
  </ItemGroup>
</Project>
