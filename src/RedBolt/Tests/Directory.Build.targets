<Project>
  <Import Project="$(MSBuildThisFileDirectory)../../Directory.Build.targets" />

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <AdditionalProbingPath Include="$(RedBoltOutputRoot)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <GenerateRuntimeConfigDevFile>true</GenerateRuntimeConfigDevFile>
  </PropertyGroup>

  <Target Name="RedBoltConfigureParentRuntimeAssemblies"
          AfterTargets="GenerateBuildDependencyFile"
          Condition="'$(RuntimeIdentifier)' == 'linux-x64' and Exists('$(ProjectDepsFilePath)')">
    <RedBoltUseParentRuntimeAssemblies DependencyFile="$(ProjectDepsFilePath)"
                                       MainProjectName="$(AssemblyName)"
                                       NativeRuntimeDirectory="$(RedBoltNativeOutputRoot)"
                                       RelocateAllProjectLibraries="false"
                                       RuntimeIdentifier="$(RuntimeIdentifier)" />
  </Target>

  <Target Name="RedBoltExcludeParentRuntimeAssemblies"
          BeforeTargets="_CopyFilesMarkedCopyLocal"
          Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
                               Condition="$([System.String]::Copy('%(ReferenceCopyLocalPaths.Filename)').StartsWith('RedBolt'))" />
    </ItemGroup>
  </Target>
</Project>
