<Project>
  <PropertyGroup>
    <RedBoltRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../..'))</RedBoltRoot>
    <RedBoltBuildRoot Condition="'$(RedBoltBuildRoot)' == '' and '$(SolutionDir)' != ''">$([System.IO.Path]::GetFullPath('$(SolutionDir)/build'))</RedBoltBuildRoot>
    <RedBoltBuildRoot Condition="'$(RedBoltBuildRoot)' == ''">$(RedBoltRoot)/build</RedBoltBuildRoot>
    <BaseOutputPath>$(RedBoltBuildRoot)/bin/tools/external-module-packaging/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(RedBoltBuildRoot)/obj/tools/external-module-packaging/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)restore/</MSBuildProjectExtensionsPath>
  </PropertyGroup>
</Project>
