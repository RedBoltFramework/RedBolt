<Project>
  <Import Project="$(RedBoltRoot)/src/RedBolt.ProjectEligibility.targets" />
  <PropertyGroup>
    <_RedBoltProjectModuleEnabled Condition="'$(RedBoltExternalModuleRoot)' != '' and $([System.String]::Copy('$(MSBuildProjectFullPath)').StartsWith('$(RedBoltExternalModuleRoot)/src/'))">$(RedBoltExternalModuleEnabled)</_RedBoltProjectModuleEnabled>
    <_RedBoltProjectModuleEnabled Condition="$([System.String]::Copy(';$(RedBoltExternalModuleProjectNames);').Contains(';$(MSBuildProjectName);'))">$(RedBoltExternalModuleEnabled)</_RedBoltProjectModuleEnabled>
    <RedBoltProjectBuildEnabled Condition="'$(_RedBoltProjectPlatformEnabled)' == 'true' and '$(_RedBoltProjectPlatformSupported)' == 'true' and '$(_RedBoltProjectModuleEnabled)' == 'true'">true</RedBoltProjectBuildEnabled>
    <RedBoltProjectBuildEnabled Condition="'$(RedBoltIgnoreBuildSelection)' == 'true'">true</RedBoltProjectBuildEnabled>
  </PropertyGroup>
</Project>
