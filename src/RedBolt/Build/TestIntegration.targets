<Project>
  <PropertyGroup>
    <RedBoltExternalTestIntegrationImported>true</RedBoltExternalTestIntegrationImported>
  </PropertyGroup>
  <Target Name="RedBoltExternalConfigureTestProbingPaths"
          BeforeTargets="RedBoltConfigureRuntimeAssemblies"
          Condition="('$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64') and '$(IsTestProject)' == 'true'">
    <ItemGroup>
      <AdditionalProbingPath Include="@(RedBoltExternalTestModule->'%(Identity)/build/bin/$(Configuration)/$(RedBoltPlatform)/core')" />
      <AdditionalProbingPath Include="@(RedBoltExternalTestModule->'%(Identity)/build/bin/$(Configuration)/$(RedBoltPlatform)/extern')" Condition="'%(RedBoltExternalTestModule.HasNative)' == 'true'" />
      <AdditionalProbingPath Include="@(RedBoltExternalTestModule->'%(Identity)/build/bin/$(Configuration)/host/extern')" Condition="'%(RedBoltExternalTestModule.HasNative)' == 'true'" />
      <AdditionalProbingPath Include="@(RedBoltExternalTestModule->'%(Identity)/build/bin/$(Configuration)/host/tools')" Condition="'%(RedBoltExternalTestModule.HasNative)' == 'true'" />
    </ItemGroup>
  </Target>
  <Target Name="RedBoltExternalConfigureTestRuntimeAssemblies"
          AfterTargets="RedBoltConfigureRuntimeAssemblies"
          Condition="('$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64') and '$(IsTestProject)' == 'true' and Exists('$(ProjectDepsFilePath)')">
    <RedBoltUseParentRuntimeAssemblies
        DependencyFile="$(ProjectDepsFilePath)"
        MainProjectName="$(AssemblyName)"
        NativeRuntimeDirectory="%(RedBoltExternalTestModule.Identity)/build/bin/$(Configuration)/$(RedBoltPlatform)/extern/runtimes/$(RedBoltPlatform)/native"
        NativeModuleManifestDirectory="%(RedBoltExternalTestModule.Identity)/build/native/$(RedBoltPlatform)/generated/native-modules/$(Configuration)"
        RuntimeIdentifier="$(RuntimeIdentifier)"
        Condition="'%(RedBoltExternalTestModule.HasNative)' == 'true'">
      <Output TaskParameter="NativeAssets" ItemName="_RedBoltNativeAssets" />
    </RedBoltUseParentRuntimeAssemblies>
  </Target>
</Project>
