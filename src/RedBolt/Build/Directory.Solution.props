<Project>
  <Import Project="$(RedBoltRoot)/Directory.Solution.props" />
  <PropertyGroup>
    <RedBoltTraversalProject>$(RedBoltExternalModuleRoot)/src/RedBolt/Build/$(RedBoltExternalModuleName).Build.csproj</RedBoltTraversalProject>
    <RedBoltSolutionBuildRoot>$(RedBoltExternalModuleRoot)/build</RedBoltSolutionBuildRoot>
    <RedBoltBuildConfigPath>$(RedBoltExternalModuleRoot)/build/BuildConfig.props</RedBoltBuildConfigPath>
  </PropertyGroup>
</Project>
