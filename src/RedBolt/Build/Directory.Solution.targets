<Project>
  <Import Project="$(RedBoltRoot)/Directory.Solution.targets" />
  <PropertyGroup>
    <RedBoltBuildMode Condition="'$(RedBoltBuildMode)' == ''">Module</RedBoltBuildMode>
    <RedBoltBuildModuleRoot Condition="'$(RedBoltExternalModuleRoot)' != ''">$([System.IO.Path]::GetFullPath('$(RedBoltExternalModuleRoot)'))</RedBoltBuildModuleRoot>
    <RedBoltBuildModuleRoot Condition="'$(RedBoltExternalModuleRoot)' == ''">$([System.IO.Path]::GetFullPath('$(RedBoltRoot)'))</RedBoltBuildModuleRoot>
    <RedBoltBuildConfigPath Condition="'$(RedBoltMonorepoRoot)' == ''">$([System.IO.Path]::GetFullPath('$(RedBoltBuildModuleRoot)/build/BuildConfig.props'))</RedBoltBuildConfigPath>
  </PropertyGroup>
</Project>
