<Project>
  <Import Project="$(RedBoltRoot)/src/Directory.Build.targets" />

  <Target Name="RedBoltConfigureExternalProjectReferences"
          BeforeTargets="AssignProjectConfiguration"
          DependsOnTargets="IncludeTransitiveProjectReferences"
          Condition="'$(RedBoltExternalModuleRoot)' != ''">
    <ItemGroup>
      <ProjectReference Update="@(ProjectReference)"
                        Condition="'$(RedBoltBuildPlatform)' == '' and '$(RedBoltPlatform)' == 'browser-wasm' and '%(ProjectReference.AdditionalProperties)' == '' and $([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(RedBoltExternalModuleRoot)/src/RedBolt/')) and '%(ProjectReference.Filename)' != '$(RedBoltExternalGeneratorProjectName)' and '%(ProjectReference.Filename)' != '$(RedBoltExternalNativeWebProjectName)'">
        <AdditionalProperties>RedBoltPlatform=browser-wasm;RedBoltNativePreset=browser-wasm</AdditionalProperties>
      </ProjectReference>
      <ProjectReference Update="@(ProjectReference)"
                        Condition="'$(RedBoltBuildPlatform)' == '' and $([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-')) and '%(ProjectReference.AdditionalProperties)' == '' and $([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(RedBoltExternalModuleRoot)/src/RedBolt/')) and '%(ProjectReference.Filename)' != '$(RedBoltExternalGeneratorProjectName)' and '%(ProjectReference.Filename)' != '$(RedBoltExternalNativeAndroidProjectName)'">
        <AdditionalProperties>RedBoltPlatform=$(RedBoltPlatform);RedBoltNativePreset=$(RedBoltNativePreset);RedBoltTargetFramework=$(RedBoltTargetFramework)</AdditionalProperties>
      </ProjectReference>
    </ItemGroup>
  </Target>

  <Target Name="RedBoltReusePreviouslyBuiltProjectReferences"
          BeforeTargets="AssignProjectConfiguration"
          DependsOnTargets="IncludeTransitiveProjectReferences"
          Condition="'$(RedBoltReuseCoreProjectReferences)' == 'true' or '$(RedBoltReuseNetworkProjectReferences)' == 'true'">
    <ItemGroup Condition="'$(RedBoltReuseCoreProjectReferences)' == 'true'">
      <_RedBoltCoreManagedProject Include="@(ProjectReference)"
                                  Condition="$([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(RedBoltRoot)/src/')) and !$([System.String]::Copy('%(ProjectReference.FullPath)').Replace('\', '/').Contains('/Native/')) and !$([System.String]::Copy('%(ProjectReference.FullPath)').Replace('\', '/').Contains('/Generator/')) and !$([System.String]::Copy('%(ProjectReference.FullPath)').Replace('\', '/').Contains('/Editor/'))" />
      <_RedBoltCoreEditorProject Include="@(ProjectReference)"
                                 Condition="$([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(RedBoltRoot)/src/')) and $([System.String]::Copy('%(ProjectReference.FullPath)').Replace('\', '/').Contains('/Editor/'))" />
      <_RedBoltCoreBindingProject Include="@(ProjectReference)"
                                  Condition="$([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(RedBoltRoot)/src/')) and $([System.String]::Copy('%(ProjectReference.FullPath)').Replace('\', '/').Contains('/Native/')) and $([System.String]::Copy('%(ProjectReference.Filename)').StartsWith('RedBolt.Bindings.'))" />
      <ProjectReference Remove="@(_RedBoltCoreManagedProject);@(_RedBoltCoreEditorProject);@(_RedBoltCoreBindingProject)" />
      <Reference Include="@(_RedBoltCoreManagedProject->'$(RedBoltRoot)/build/bin/$(Configuration)/$(RedBoltPlatform)/core/%(Filename).dll')"
                 Condition="'$(RedBoltPlatform)' != 'browser-wasm' and !$([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-'))">
        <ReferenceSourceTarget>ResolveAssemblyReference</ReferenceSourceTarget>
      </Reference>
      <Reference Include="@(_RedBoltCoreManagedProject->'$(RedBoltRoot)/build/obj/managed/$(RedBoltPlatform)/staging/%(Filename)/$(Configuration)/%(Filename).dll')"
                 Condition="'$(RedBoltPlatform)' == 'browser-wasm' or $([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-'))">
        <ReferenceSourceTarget>ResolveAssemblyReference</ReferenceSourceTarget>
      </Reference>
      <Reference Include="@(_RedBoltCoreEditorProject->'$(RedBoltRoot)/build/bin/$(Configuration)/$(RedBoltPlatform)/tools/%(Filename).dll')">
        <ReferenceSourceTarget>ResolveAssemblyReference</ReferenceSourceTarget>
      </Reference>
      <Reference Include="@(_RedBoltCoreBindingProject->'$(RedBoltRoot)/build/bin/$(Configuration)/$(RedBoltPlatform)/extern/%(Filename).dll')"
                 Condition="'$(RedBoltPlatform)' != 'browser-wasm' and !$([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-'))">
        <ReferenceSourceTarget>ResolveAssemblyReference</ReferenceSourceTarget>
      </Reference>
      <Reference Include="@(_RedBoltCoreBindingProject->'$(RedBoltRoot)/build/obj/managed/$(RedBoltPlatform)/staging/%(Filename)/$(Configuration)/%(Filename).dll')"
                 Condition="'$(RedBoltPlatform)' == 'browser-wasm' or $([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-'))">
        <ReferenceSourceTarget>ResolveAssemblyReference</ReferenceSourceTarget>
      </Reference>
    </ItemGroup>

    <ItemGroup Condition="'$(RedBoltReuseNetworkProjectReferences)' == 'true' and '$(RedBoltNetworkRoot)' != ''">
      <_RedBoltNetworkManagedProject Include="@(ProjectReference)"
                                     Condition="$([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(RedBoltNetworkRoot)/src/')) and !$([System.String]::Copy('%(ProjectReference.Filename)').StartsWith('RedBolt.Bindings.'))" />
      <_RedBoltNetworkBindingProject Include="@(ProjectReference)"
                                     Condition="$([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(RedBoltNetworkRoot)/src/')) and $([System.String]::Copy('%(ProjectReference.Filename)').StartsWith('RedBolt.Bindings.'))" />
      <ProjectReference Remove="@(_RedBoltNetworkManagedProject);@(_RedBoltNetworkBindingProject)" />
      <Reference Include="@(_RedBoltNetworkManagedProject->'$(RedBoltNetworkRoot)/build/bin/$(Configuration)/$(RedBoltPlatform)/core/%(Filename).dll')"
                 Condition="'$(RedBoltPlatform)' != 'browser-wasm' and !$([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-'))">
        <ReferenceSourceTarget>ResolveAssemblyReference</ReferenceSourceTarget>
      </Reference>
      <Reference Include="@(_RedBoltNetworkManagedProject->'$(RedBoltNetworkRoot)/build/obj/managed/$(RedBoltPlatform)/staging/%(Filename)/$(Configuration)/%(Filename).dll')"
                 Condition="'$(RedBoltPlatform)' == 'browser-wasm' or $([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-'))">
        <ReferenceSourceTarget>ResolveAssemblyReference</ReferenceSourceTarget>
      </Reference>
      <Reference Include="@(_RedBoltNetworkBindingProject->'$(RedBoltNetworkRoot)/build/bin/$(Configuration)/$(RedBoltPlatform)/extern/%(Filename).dll')"
                 Condition="'$(RedBoltPlatform)' != 'browser-wasm' and !$([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-'))">
        <ReferenceSourceTarget>ResolveAssemblyReference</ReferenceSourceTarget>
      </Reference>
      <Reference Include="@(_RedBoltNetworkBindingProject->'$(RedBoltNetworkRoot)/build/obj/managed/$(RedBoltPlatform)/staging/%(Filename)/$(Configuration)/%(Filename).dll')"
                 Condition="'$(RedBoltPlatform)' == 'browser-wasm' or $([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-'))">
        <ReferenceSourceTarget>ResolveAssemblyReference</ReferenceSourceTarget>
      </Reference>
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(RedBoltExternalModuleRoot)' != '' and ('$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64') and ('$(OutputType)' == 'Exe' or '$(IsTestProject)' == 'true')">
    <AdditionalProbingPath Include="$(RedBoltRoot)/build/bin/$(Configuration)/$(RedBoltPlatform)/core" />
    <AdditionalProbingPath Include="$(RedBoltRoot)/build/bin/$(Configuration)/$(RedBoltPlatform)/extern" />
    <AdditionalProbingPath Include="$(RedBoltRoot)/build/bin/$(Configuration)/host/extern" />
    <AdditionalProbingPath Include="$(RedBoltRoot)/build/bin/$(Configuration)/host/tools" />
    <AdditionalProbingPath Include="$(RedBoltExternalAdditionalProbingPaths)" Condition="'$(RedBoltExternalAdditionalProbingPaths)' != ''" />
  </ItemGroup>

  <Target Name="RedBoltExternalConfigureBaseRuntimeAssemblies"
          BeforeTargets="RedBoltConfigureRuntimeAssemblies"
      Condition="'$(RedBoltExternalModuleRoot)' != '' and ('$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64') and ('$(OutputType)' == 'Exe' or '$(IsTestProject)' == 'true') and Exists('$(ProjectDepsFilePath)')">
    <RedBoltUseParentRuntimeAssemblies
        DependencyFile="$(ProjectDepsFilePath)"
        MainProjectName="$(AssemblyName)"
        NativeRuntimeDirectory="$(RedBoltRuntimeNativeOutputRoot)"
        NativeModuleManifestDirectory="$(RedBoltRuntimeNativeModuleManifestDirectory)"
        RuntimeIdentifier="$(RuntimeIdentifier)">
      <Output TaskParameter="NativeAssets" ItemName="_RedBoltNativeAssets" />
    </RedBoltUseParentRuntimeAssemblies>
  </Target>

  <Target Name="RedBoltStageExternalNativeResources"
          Condition="'$(RedBoltExternalDesktopResourceRoot)' != '' and '$(RedBoltPlatform)' == 'linux-x64'">
    <MakeDir Directories="$(RedBoltOutputRoot)" />
    <Exec Condition="!Exists('$(RedBoltOutputRoot)/CoreData')" Command="cmake -E create_symlink &quot;$(RedBoltExternalDesktopResourceRoot)/bin/CoreData&quot; &quot;$(RedBoltOutputRoot)/CoreData&quot;" />
    <Exec Condition="!Exists('$(RedBoltOutputRoot)/Data')" Command="cmake -E create_symlink &quot;$(RedBoltExternalDesktopResourceRoot)/bin/Data&quot; &quot;$(RedBoltOutputRoot)/Data&quot;" />
    <Exec Condition="!Exists('$(RedBoltOutputRoot)/Base')" Command="cmake -E create_symlink &quot;$(RedBoltRoot)/build/bin/$(Configuration)/$(RedBoltPlatform)&quot; &quot;$(RedBoltOutputRoot)/Base&quot;" />
  </Target>

  <Target Name="RedBoltExternalStageDesktopResources"
          AfterTargets="Build"
          DependsOnTargets="RedBoltStageExternalNativeResources"
      Condition="'$(RedBoltExternalDesktopResourceRoot)' != '' and '$(RedBoltPlatform)' == 'linux-x64' and '$(OutputType)' == 'Exe' and '$(RedBoltProjectBuildEnabled)' == 'true'" />
</Project>
