<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <RedBoltTestsProject>$([System.IO.Path]::GetFullPath('$(RedBoltRoot)/../RedBolt.Tests/RedBolt.Tests.csproj'))</RedBoltTestsProject>
    <_RedBoltModuleProperties>RedBoltAudioEnabled=$(RedBoltAudioEnabled);RedBoltDearImGuiEnabled=$(RedBoltDearImGuiEnabled);RedBoltUtilityEnabled=$(RedBoltUtilityEnabled);RedBoltEditorEnabled=$(RedBoltEditorEnabled);RedBoltSamplesEnabled=$(RedBoltSamplesEnabled);RedBoltTestsEnabled=$(RedBoltTestsEnabled)</_RedBoltModuleProperties>
    <_RedBoltLinuxProperties>Configuration=$(Configuration);BuildProjectReferences=true;RedBoltPlatform=linux-x64;RedBoltNativePreset=linux-x64;$(_RedBoltModuleProperties)</_RedBoltLinuxProperties>
    <_RedBoltWindowsProperties>Configuration=$(Configuration);BuildProjectReferences=true;RedBoltPlatform=win-x64;RedBoltNativePreset=win-x64;$(_RedBoltModuleProperties)</_RedBoltWindowsProperties>
    <_RedBoltAndroidX64Properties>Configuration=$(Configuration);BuildProjectReferences=true;RedBoltPlatform=android-x64;RedBoltNativePreset=android-x64;RedBoltTargetFramework=net10.0-android;RedBoltBuildAllAndroidPackages=false;$(_RedBoltModuleProperties)</_RedBoltAndroidX64Properties>
    <_RedBoltAndroidArm64Properties>Configuration=$(Configuration);BuildProjectReferences=true;RedBoltPlatform=android-arm64;RedBoltNativePreset=android-arm64;RedBoltTargetFramework=net10.0-android;RedBoltBuildAllAndroidPackages=false;$(_RedBoltModuleProperties)</_RedBoltAndroidArm64Properties>
    <_RedBoltWebProperties>Configuration=$(Configuration);BuildProjectReferences=true;RedBoltPlatform=browser-wasm;RedBoltNativePreset=browser-wasm;$(_RedBoltModuleProperties)</_RedBoltWebProperties>
  </PropertyGroup>

  <ItemGroup>
    <_RedBoltCommonProject Include="../Core/RedBolt.Core.csproj" />
    <_RedBoltCommonProject Include="../Audio/RedBolt.Audio.csproj" Condition="'$(RedBoltAudioEnabled)' == 'true'" />
    <_RedBoltCommonProject Include="../DearImGui/RedBolt.DearImGui.csproj" Condition="'$(RedBoltDearImGuiEnabled)' == 'true'" />

    <_RedBoltDesktopProject Include="@(_RedBoltCommonProject)" />
    <_RedBoltDesktopProject Include="../Utility/RedBolt.Utility.csproj" Condition="'$(RedBoltUtilityEnabled)' == 'true'" />
    <_RedBoltDesktopProject Include="../Editor/RedBolt.Editor.csproj" Condition="'$(RedBoltEditorEnabled)' == 'true'" />
    <_RedBoltDesktopProject Include="../Sample/*/*.csproj" Exclude="../Sample/Android/*.csproj;../Sample/Web/*.csproj" Condition="'$(RedBoltSamplesEnabled)' == 'true'" />
    <_RedBoltDesktopProject Include="../UserCode/Desktop/RedBolt.UserCode.Desktop.csproj" Condition="'$(RedBoltSamplesEnabled)' == 'true' or '$(RedBoltEditorEnabled)' == 'true'" />
    <_RedBoltDesktopProject Include="$(RedBoltTestsProject)" Condition="'$(RedBoltTestsEnabled)' == 'true' and Exists('$(RedBoltTestsProject)')" />

    <_RedBoltAndroidProject Include="@(_RedBoltCommonProject)" />
    <_RedBoltAndroidProject Include="../Utility/RedBolt.Utility.csproj" Condition="'$(RedBoltUtilityEnabled)' == 'true'" />
    <_RedBoltAndroidProject Include="../Sample/Android/RedBolt.Sample.Android.csproj" Condition="'$(RedBoltSamplesEnabled)' == 'true'" />

    <_RedBoltWebProject Include="@(_RedBoltCommonProject)" />
    <_RedBoltWebProject Include="../Sample/Web/RedBolt.Sample.Web.csproj" Condition="'$(RedBoltSamplesEnabled)' == 'true'" />
  </ItemGroup>

  <Target Name="RedBoltValidateBuildConfiguration">
    <ItemGroup>
      <_RedBoltConfiguredPlatform Include="$(_RedBoltEnablePlatforms.Replace(',', ';'));$(_RedBoltDisablePlatforms.Replace(',', ';'))" />
      <_RedBoltConfiguredArchitecture Include="$(_RedBoltEnableArchitectures.Replace(',', ';'));$(_RedBoltDisableArchitectures.Replace(',', ';'))" />
      <_RedBoltConfiguredModule Include="$(_RedBoltEnableModules.Replace(',', ';'));$(_RedBoltDisableModules.Replace(',', ';'))" />
    </ItemGroup>
    <Error Condition="'%(_RedBoltConfiguredPlatform.Identity)' != '' and '%(_RedBoltConfiguredPlatform.Identity)' != 'all' and '%(_RedBoltConfiguredPlatform.Identity)' != 'linux' and '%(_RedBoltConfiguredPlatform.Identity)' != 'windows' and '%(_RedBoltConfiguredPlatform.Identity)' != 'android' and '%(_RedBoltConfiguredPlatform.Identity)' != 'web'"
           Text="Unknown RedBolt platform key '%(_RedBoltConfiguredPlatform.Identity)'." />
    <Error Condition="'%(_RedBoltConfiguredArchitecture.Identity)' != '' and '%(_RedBoltConfiguredArchitecture.Identity)' != 'all' and '%(_RedBoltConfiguredArchitecture.Identity)' != 'x64' and '%(_RedBoltConfiguredArchitecture.Identity)' != 'arm64'"
           Text="Unknown RedBolt architecture key '%(_RedBoltConfiguredArchitecture.Identity)'." />
    <Error Condition="'%(_RedBoltConfiguredModule.Identity)' != '' and '%(_RedBoltConfiguredModule.Identity)' != 'all' and '%(_RedBoltConfiguredModule.Identity)' != 'audio' and '%(_RedBoltConfiguredModule.Identity)' != 'dear-imgui' and '%(_RedBoltConfiguredModule.Identity)' != 'utility' and '%(_RedBoltConfiguredModule.Identity)' != 'editor' and '%(_RedBoltConfiguredModule.Identity)' != 'samples' and '%(_RedBoltConfiguredModule.Identity)' != 'tests'"
           Text="Unknown RedBolt module key '%(_RedBoltConfiguredModule.Identity)'." />
    <Error Condition="'$(RedBoltEditorEnabled)' == 'true' and ('$(RedBoltDearImGuiEnabled)' != 'true' or '$(RedBoltUtilityEnabled)' != 'true')"
           Text="The 'editor' module requires 'dear-imgui' and 'utility'." />
    <Error Condition="('$(RedBoltSamplesEnabled)' == 'true' or '$(RedBoltTestsEnabled)' == 'true') and ('$(RedBoltAudioEnabled)' != 'true' or '$(RedBoltDearImGuiEnabled)' != 'true' or '$(RedBoltUtilityEnabled)' != 'true')"
           Text="The 'samples' and 'tests' module sets require every core-repository module." />
    <Error Condition="'$(RedBoltTestsEnabled)' == 'true' and (('$(RedBoltLinuxEnabled)' == 'true' or '$(RedBoltWindowsEnabled)' == 'true') and '$(RedBoltX64Enabled)' == 'true') and !Exists('$(RedBoltTestsProject)')"
           Text="The 'tests' module is enabled, but '$(RedBoltTestsProject)' does not exist." />
  </Target>

  <Target Name="RedBoltRestoreSelectedProjects" DependsOnTargets="RedBoltValidateBuildConfiguration">
    <Message Importance="high" Text="Restoring selected RedBolt build variants." />
    <MSBuild Projects="@(_RedBoltDesktopProject)" Targets="Restore" BuildInParallel="false" Properties="$(_RedBoltLinuxProperties)" Condition="'$(RedBoltLinuxEnabled)' == 'true' and '$(RedBoltX64Enabled)' == 'true'" />
    <MSBuild Projects="@(_RedBoltDesktopProject)" Targets="Restore" BuildInParallel="false" Properties="$(_RedBoltWindowsProperties)" Condition="'$(RedBoltWindowsEnabled)' == 'true' and '$(RedBoltX64Enabled)' == 'true'" />
    <MSBuild Projects="@(_RedBoltAndroidProject)" Targets="Restore" BuildInParallel="false" Properties="$(_RedBoltAndroidX64Properties)" Condition="'$(RedBoltAndroidEnabled)' == 'true' and '$(RedBoltX64Enabled)' == 'true'" />
    <MSBuild Projects="@(_RedBoltAndroidProject)" Targets="Restore" BuildInParallel="false" Properties="$(_RedBoltAndroidArm64Properties)" Condition="'$(RedBoltAndroidEnabled)' == 'true' and '$(RedBoltArm64Enabled)' == 'true'" />
    <MSBuild Projects="@(_RedBoltWebProject)" Targets="Restore" BuildInParallel="false" Properties="$(_RedBoltWebProperties)" Condition="'$(RedBoltWebEnabled)' == 'true'" />
  </Target>

  <Target Name="RedBoltBuildSelectedProjects" DependsOnTargets="RedBoltValidateBuildConfiguration">
    <Message Importance="high" Text="Building selected RedBolt build variants." />
    <MSBuild Projects="@(_RedBoltDesktopProject)" Targets="Build" BuildInParallel="true" RemoveProperties="BuildProjectReferences;BuildingSolutionFile;CurrentSolutionConfigurationContents" Properties="$(_RedBoltLinuxProperties)" Condition="'$(RedBoltLinuxEnabled)' == 'true' and '$(RedBoltX64Enabled)' == 'true'" />
    <MSBuild Projects="@(_RedBoltDesktopProject)" Targets="Build" BuildInParallel="true" RemoveProperties="BuildProjectReferences;BuildingSolutionFile;CurrentSolutionConfigurationContents" Properties="$(_RedBoltWindowsProperties)" Condition="'$(RedBoltWindowsEnabled)' == 'true' and '$(RedBoltX64Enabled)' == 'true'" />
    <MSBuild Projects="@(_RedBoltAndroidProject)" Targets="Build" BuildInParallel="true" RemoveProperties="BuildProjectReferences;BuildingSolutionFile;CurrentSolutionConfigurationContents" Properties="$(_RedBoltAndroidX64Properties)" Condition="'$(RedBoltAndroidEnabled)' == 'true' and '$(RedBoltX64Enabled)' == 'true'" />
    <MSBuild Projects="@(_RedBoltAndroidProject)" Targets="Build" BuildInParallel="true" RemoveProperties="BuildProjectReferences;BuildingSolutionFile;CurrentSolutionConfigurationContents" Properties="$(_RedBoltAndroidArm64Properties)" Condition="'$(RedBoltAndroidEnabled)' == 'true' and '$(RedBoltArm64Enabled)' == 'true'" />
    <MSBuild Projects="@(_RedBoltWebProject)" Targets="Build" BuildInParallel="true" RemoveProperties="BuildProjectReferences;BuildingSolutionFile;CurrentSolutionConfigurationContents" Properties="$(_RedBoltWebProperties)" Condition="'$(RedBoltWebEnabled)' == 'true'" />
  </Target>

  <Target Name="RedBoltCleanSelectedProjects" DependsOnTargets="RedBoltValidateBuildConfiguration">
    <MSBuild Projects="../Native/RedBolt.Native.csproj;@(_RedBoltDesktopProject)" Targets="Clean" BuildInParallel="true" Properties="$(_RedBoltLinuxProperties)" Condition="'$(RedBoltLinuxEnabled)' == 'true' and '$(RedBoltX64Enabled)' == 'true'" />
    <MSBuild Projects="../Native/RedBolt.Native.csproj;@(_RedBoltDesktopProject)" Targets="Clean" BuildInParallel="true" Properties="$(_RedBoltWindowsProperties)" Condition="'$(RedBoltWindowsEnabled)' == 'true' and '$(RedBoltX64Enabled)' == 'true'" />
    <MSBuild Projects="../Native/RedBolt.Native.Android.csproj;@(_RedBoltAndroidProject)" Targets="Clean" BuildInParallel="true" Properties="$(_RedBoltAndroidX64Properties)" Condition="'$(RedBoltAndroidEnabled)' == 'true' and '$(RedBoltX64Enabled)' == 'true'" />
    <MSBuild Projects="../Native/RedBolt.Native.Android.csproj;@(_RedBoltAndroidProject)" Targets="Clean" BuildInParallel="true" Properties="$(_RedBoltAndroidArm64Properties)" Condition="'$(RedBoltAndroidEnabled)' == 'true' and '$(RedBoltArm64Enabled)' == 'true'" />
    <MSBuild Projects="../Native/RedBolt.Native.Web.csproj;@(_RedBoltWebProject)" Targets="Clean" BuildInParallel="true" Properties="$(_RedBoltWebProperties)" Condition="'$(RedBoltWebEnabled)' == 'true'" />
  </Target>
</Project>
