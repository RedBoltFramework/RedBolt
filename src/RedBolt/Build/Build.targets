<Project>
  <PropertyGroup>
    <RedBoltTestsProject>$([System.IO.Path]::GetFullPath('$(RedBoltExternalModuleRoot)/../RedBolt.Tests/RedBolt.Tests.csproj'))</RedBoltTestsProject>
    <_RedBoltModuleProperties>RedBoltActionsEnabled=$(RedBoltActionsEnabled);RedBoltAudioEnabled=$(RedBoltAudioEnabled);RedBoltDearImGuiEnabled=$(RedBoltDearImGuiEnabled);RedBoltGlowEnabled=$(RedBoltGlowEnabled);RedBoltNavigationEnabled=$(RedBoltNavigationEnabled);RedBoltNetworkEnabled=$(RedBoltNetworkEnabled);RedBoltParticlesEnabled=$(RedBoltParticlesEnabled);RedBoltRmlUIEnabled=$(RedBoltRmlUIEnabled);RedBoltUtilityEnabled=$(RedBoltUtilityEnabled);RedBoltEditorEnabled=$(RedBoltEditorEnabled);RedBoltSamplesEnabled=$(RedBoltSamplesEnabled);RedBoltTestsEnabled=$(RedBoltTestsEnabled);$(RedBoltExternalModuleBuildProperties)</_RedBoltModuleProperties>
    <_RedBoltLinuxProperties>Configuration=$(Configuration);RedBoltPlatform=linux-x64;RedBoltNativePreset=linux-x64;$(_RedBoltModuleProperties)</_RedBoltLinuxProperties>
    <_RedBoltWindowsProperties>Configuration=$(Configuration);RedBoltPlatform=win-x64;RedBoltNativePreset=win-x64;$(_RedBoltModuleProperties)</_RedBoltWindowsProperties>
    <_RedBoltAndroidX64Properties>Configuration=$(Configuration);RedBoltPlatform=android-x64;RedBoltNativePreset=android-x64;RedBoltTargetFramework=net10.0-android;RedBoltBuildAllAndroidPackages=false;$(_RedBoltModuleProperties)</_RedBoltAndroidX64Properties>
    <_RedBoltAndroidArm64Properties>Configuration=$(Configuration);RedBoltPlatform=android-arm64;RedBoltNativePreset=android-arm64;RedBoltTargetFramework=net10.0-android;RedBoltBuildAllAndroidPackages=false;$(_RedBoltModuleProperties)</_RedBoltAndroidArm64Properties>
    <_RedBoltWebProperties>Configuration=$(Configuration);RedBoltPlatform=browser-wasm;RedBoltNativePreset=browser-wasm;$(_RedBoltModuleProperties)</_RedBoltWebProperties>
  </PropertyGroup>

  <Target Name="RedBoltExternalValidateBuildConfiguration">
    <Error Condition="'$(RedBoltTestsEnabled)' == 'true' and !Exists('$(RedBoltTestsProject)')" Text="The tests module is enabled, but '$(RedBoltTestsProject)' does not exist." />
  </Target>
  <Target Name="RedBoltRestoreSelectedProjects" DependsOnTargets="RedBoltExternalValidateBuildConfiguration">
    <MSBuild Projects="@(_RedBoltExternalDesktopProject)" Targets="Restore" BuildInParallel="false" Properties="$(_RedBoltLinuxProperties)" Condition="'$(RedBoltLinuxEnabled)' == 'true' and '$(RedBoltX64Enabled)' == 'true'" />
    <MSBuild Projects="@(_RedBoltExternalDesktopProject)" Targets="Restore" BuildInParallel="false" Properties="$(_RedBoltWindowsProperties)" Condition="'$(RedBoltWindowsEnabled)' == 'true' and '$(RedBoltX64Enabled)' == 'true'" />
    <MSBuild Projects="@(_RedBoltExternalAndroidProject)" Targets="Restore" BuildInParallel="false" Properties="$(_RedBoltAndroidX64Properties)" Condition="'$(RedBoltAndroidEnabled)' == 'true' and '$(RedBoltX64Enabled)' == 'true'" />
    <MSBuild Projects="@(_RedBoltExternalAndroidProject)" Targets="Restore" BuildInParallel="false" Properties="$(_RedBoltAndroidArm64Properties)" Condition="'$(RedBoltAndroidEnabled)' == 'true' and '$(RedBoltArm64Enabled)' == 'true'" />
    <MSBuild Projects="@(_RedBoltExternalWebProject)" Targets="Restore" BuildInParallel="false" Properties="$(_RedBoltWebProperties)" Condition="'$(RedBoltWebEnabled)' == 'true'" />
  </Target>
  <Target Name="RedBoltBuildSelectedProjects" DependsOnTargets="RedBoltExternalValidateBuildConfiguration">
    <MSBuild Projects="@(_RedBoltExternalDesktopProject)" Targets="Build" BuildInParallel="false" RemoveProperties="BuildingSolutionFile;CurrentSolutionConfigurationContents" Properties="$(_RedBoltLinuxProperties)" Condition="'$(RedBoltLinuxEnabled)' == 'true' and '$(RedBoltX64Enabled)' == 'true'" />
    <MSBuild Projects="@(_RedBoltExternalDesktopProject)" Targets="Build" BuildInParallel="false" RemoveProperties="BuildingSolutionFile;CurrentSolutionConfigurationContents" Properties="$(_RedBoltWindowsProperties)" Condition="'$(RedBoltWindowsEnabled)' == 'true' and '$(RedBoltX64Enabled)' == 'true'" />
    <MSBuild Projects="@(_RedBoltExternalAndroidProject)" Targets="Build" BuildInParallel="false" RemoveProperties="BuildingSolutionFile;CurrentSolutionConfigurationContents" Properties="$(_RedBoltAndroidX64Properties)" Condition="'$(RedBoltAndroidEnabled)' == 'true' and '$(RedBoltX64Enabled)' == 'true'" />
    <MSBuild Projects="@(_RedBoltExternalAndroidProject)" Targets="Build" BuildInParallel="false" RemoveProperties="BuildingSolutionFile;CurrentSolutionConfigurationContents" Properties="$(_RedBoltAndroidArm64Properties)" Condition="'$(RedBoltAndroidEnabled)' == 'true' and '$(RedBoltArm64Enabled)' == 'true'" />
    <MSBuild Projects="@(_RedBoltExternalWebProject)" Targets="Build" BuildInParallel="false" RemoveProperties="BuildingSolutionFile;CurrentSolutionConfigurationContents" Properties="$(_RedBoltWebProperties)" Condition="'$(RedBoltWebEnabled)' == 'true'" />
  </Target>
  <Target Name="RedBoltCleanSelectedProjects">
    <MSBuild Projects="@(_RedBoltExternalDesktopProject);@(_RedBoltExternalAndroidProject);@(_RedBoltExternalWebProject)" Targets="Clean" BuildInParallel="true" />
  </Target>
</Project>
