<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RedBolt.Utility</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Core/RedBolt.Core.csproj" />
    <ProjectReference Include="../Native/TinyGltf/RedBolt.Bindings.TinyGltf.csproj" />
    <ProjectReference Include="../Generator/Reflection/RedBolt.Generator.Reflection.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RedBoltPlatform;RedBoltNativePreset" />
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Std/SharpCpp.Std.csproj"
                      AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
  </ItemGroup>
</Project>
