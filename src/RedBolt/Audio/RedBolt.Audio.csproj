<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RedBolt.Audio</AssemblyName>
    <EnableLibraryImportGenerator>true</EnableLibraryImportGenerator>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Native/Sdl/RedBolt.Bindings.Sdl.csproj" />
    <ProjectReference Include="../Native/Stb/RedBolt.Bindings.Stb.csproj" />
    <ProjectReference Include="../Core/RedBolt.Core.csproj" />
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj" PrivateAssets="all" AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
    <ProjectReference Include="../Generator/Reflection/RedBolt.Generator.Reflection.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RedBoltPlatform;RedBoltNativePreset" />
  </ItemGroup>
</Project>
