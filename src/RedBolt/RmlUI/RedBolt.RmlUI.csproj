<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RedBolt.RmlUI</AssemblyName>
    <EnableLibraryImportGenerator>true</EnableLibraryImportGenerator>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Audio/RedBolt.Audio.csproj" />
    <ProjectReference Include="../Bindings/RmlUi/RedBolt.Bindings.RmlUi.csproj" />
    <ProjectReference Include="../Bindings/Sdl/RedBolt.Bindings.Sdl.csproj" />
    <ProjectReference Include="../RedBolt/RedBolt.csproj" />
    <ProjectReference Include="../Generator/Reflection/RedBolt.Generator.Reflection.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RedBoltPlatform;RedBoltNativePreset" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RedBoltSharpCppRoot)/rbfx/SharpCpp.Ea/SharpCpp.Ea.csproj"
                      AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Std/SharpCpp.Std.csproj"
                      AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj"
                      PrivateAssets="all"
                      AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
  </ItemGroup>
</Project>
