<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RedBolt.Editor</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier Condition="'$(RedBoltPlatform)' == 'linux-x64'">linux-x64</RuntimeIdentifier>
    <GenerateRuntimeConfigDevFile Condition="'$(RuntimeIdentifier)' == 'linux-x64'">true</GenerateRuntimeConfigDevFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DearImGui/RedBolt.DearImGui.csproj" />
    <ProjectReference Include="../Glow/RedBolt.Glow.csproj" />
    <ProjectReference Include="../Platform/Linux/RedBolt.Platform.Linux.csproj" />
    <ProjectReference Include="../RedBolt/RedBolt.csproj" />
    <ProjectReference Include="../RmlUI/RedBolt.RmlUI.csproj" />
    <ProjectReference Include="../Utility/RedBolt.Utility.csproj" />
    <ProjectReference Include="../Generator/Reflection/RedBolt.Generator.Reflection.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RedBoltPlatform;RedBoltNativePreset" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj"
                      PrivateAssets="all"
                      AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <AdditionalProbingPath Include="$(RedBoltOutputRoot)" />
  </ItemGroup>

  <Target Name="RedBoltConfigureEditorRuntimeAssemblies"
          AfterTargets="GenerateBuildDependencyFile"
          Condition="'$(RuntimeIdentifier)' == 'linux-x64' and Exists('$(ProjectDepsFilePath)')">
    <RedBoltUseParentRuntimeAssemblies DependencyFile="$(ProjectDepsFilePath)"
                                       MainProjectName="$(AssemblyName)"
                                       NativeRuntimeDirectory="$(RedBoltNativeOutputRoot)"
                                       NativeModuleManifestDirectory="$(RedBoltNativeModuleManifestDirectory)"
                                       RelocateAllProjectLibraries="false"
                                       RuntimeIdentifier="$(RuntimeIdentifier)" />
  </Target>
</Project>
