<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RedBolt.Editor</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier Condition="'$(RedBoltPlatform)' == 'linux-x64'">linux-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RedBoltPlatform)' == 'win-x64'">win-x64</RuntimeIdentifier>
    <GenerateRuntimeConfigDevFile Condition="'$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == 'win-x64'">true</GenerateRuntimeConfigDevFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Audio/RedBolt.Audio.csproj" />
    <ProjectReference Include="../DearImGui/RedBolt.DearImGui.csproj" />
    <ProjectReference Include="../Core/RedBolt.Core.csproj" />
    <ProjectReference Include="../Utility/RedBolt.Utility.csproj" />
    <ProjectReference Include="../UserCode/Desktop/RedBolt.UserCode.Desktop.csproj" />
    <ProjectReference Include="../Generator/Reflection/RedBolt.Generator.Reflection.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RedBoltPlatform" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj"
                      PrivateAssets="all"
                      AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
  </ItemGroup>

</Project>
