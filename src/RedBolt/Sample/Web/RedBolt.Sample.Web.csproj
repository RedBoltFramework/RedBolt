<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <StartupObject>RedBolt.Sample.Web.WebProgram</StartupObject>
    <CompressionEnabled>false</CompressionEnabled>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <EmccExtraLDFlags>-sFULL_ES3 -sDEFAULT_LIBRARY_FUNCS_TO_INCLUDE=$dynCall -lidbfs.js -sEXPORTED_RUNTIME_METHODS+=FS -sEXPORTED_RUNTIME_METHODS+=addRunDependency -sEXPORTED_RUNTIME_METHODS+=removeRunDependency</EmccExtraLDFlags>
    <EmccLinkOptimizationFlag>-O0</EmccLinkOptimizationFlag>
    <PublishTrimmed>true</PublishTrimmed>
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
    <RunAOTCompilation Condition="'$(Configuration)' != 'Release'">false</RunAOTCompilation>
    <WasmBuildNative>true</WasmBuildNative>
    <WasmNativeStrip>false</WasmNativeStrip>
    <WasmRunWasmOpt>false</WasmRunWasmOpt>
    <WasmStripILAfterAOT Condition="'$(Configuration)' == 'Release'">true</WasmStripILAfterAOT>
    <PublishDir>$(RedBoltWebOutputDir)/</PublishDir>
    <RedBoltWebEngineArchive Condition="'$(RedBoltWebEngineArchive)' == ''">$(RedBoltNativeBuildDir)/lib/Release/wasm/RedBolt.Native.Web.a</RedBoltWebEngineArchive>
    <RedBoltWebResourcesManifest Condition="'$(RedBoltWebResourcesManifest)' == ''">$(RedBoltNativeBuildDir)/generated/web/resources.manifest.json</RedBoltWebResourcesManifest>
    <RedBoltWebPackageDirectory>$(RedBoltIntermediateRoot)/packages</RedBoltWebPackageDirectory>
    <RedBoltWebCoreDataPackage>$(RedBoltWebPackageDirectory)/CoreData.pak</RedBoltWebCoreDataPackage>
    <RedBoltWebDataPackage>$(RedBoltWebPackageDirectory)/Data.pak</RedBoltWebDataPackage>
    <RedBoltPackageToolProject>$(RedBoltRoot)/src/RedBolt/Tools/PackageTool/RedBolt.PackageTool.csproj</RedBoltPackageToolProject>
    <RedBoltPackageToolAssembly>$(RedBoltHostToolsOutputDir)/RedBolt.PackageTool.dll</RedBoltPackageToolAssembly>
    <RedBoltPackageToolNativeOutput>$(RedBoltArtifactsRoot)/linux-x64/extern/runtimes/linux-x64/native</RedBoltPackageToolNativeOutput>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="$(AssemblyName)" />
    <NativeFileReference Include="$(RedBoltWebEngineArchive)" />
    <ProjectReference Include="../../Core/RedBolt.Core.csproj" />
    <ProjectReference Include="../../Actions/RedBolt.Actions.csproj" />
    <ProjectReference Include="../../Audio/RedBolt.Audio.csproj" />
    <ProjectReference Include="../../IK/RedBolt.IK.csproj" />
    <ProjectReference Include="../../PhysicsJolt/RedBolt.PhysicsJolt.csproj" />
    <ProjectReference Include="../../Navigation/RedBolt.Navigation.csproj" />
    <ProjectReference Include="../../Network/RedBolt.Network.csproj" />
    <ProjectReference Include="../../DearImGui/RedBolt.DearImGui.csproj" />
    <ProjectReference Include="../../RmlUI/RedBolt.RmlUI.csproj" />
    <ProjectReference Include="../../Generator/Reflection/RedBolt.Generator.Reflection.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RedBoltPlatform;RedBoltNativePreset" />
    <ProjectReference Include="../../Native/RedBolt.Native.Web.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      PrivateAssets="all" />
    <Compile Include="../**/*.cs"
             Exclude="../Android/**/*.cs;../Web/**/*.cs;../WebRTCSTUN/**/*.cs"
             Link="Samples/%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj"
                      PrivateAssets="all"
                      AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
  </ItemGroup>

  <ItemGroup>
    <RedBoltWebCoreDataResource Include="../../../../bin/CoreData/**/*" />
    <RedBoltWebDataResource Include="../../../../bin/Data/**/*" />
    <Content Include="$(RedBoltWebCoreDataPackage)" Link="wwwroot/resources/CoreData.pak" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RedBoltWebDataPackage)" Link="wwwroot/resources/Data.pak" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RedBoltWebResourcesManifest)" Link="wwwroot/resources.manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RedBoltCreateWebPackages"
          BeforeTargets="ResolveProjectStaticWebAssets;GetCopyToOutputDirectoryItems"
          Inputs="@(RedBoltWebCoreDataResource);@(RedBoltWebDataResource);$(RedBoltPackageToolAssembly)"
          Outputs="$(RedBoltWebCoreDataPackage);$(RedBoltWebDataPackage)">
    <MSBuild Projects="$(RedBoltPackageToolProject)"
             Targets="Build"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);RedBoltPlatform=linux-x64;RedBoltNativePreset=linux-x64"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSelfContained" />
    <MakeDir Directories="$(RedBoltWebPackageDirectory)" />
    <Exec Command="dotnet &quot;$(RedBoltPackageToolAssembly)&quot; &quot;$(RedBoltRoot)/bin/CoreData&quot; &quot;$(RedBoltWebCoreDataPackage)&quot; -q -c"
          EnvironmentVariables="LD_LIBRARY_PATH=$(RedBoltPackageToolNativeOutput)" />
    <Exec Command="dotnet &quot;$(RedBoltPackageToolAssembly)&quot; &quot;$(RedBoltRoot)/bin/Data&quot; &quot;$(RedBoltWebDataPackage)&quot; -q -c"
          EnvironmentVariables="LD_LIBRARY_PATH=$(RedBoltPackageToolNativeOutput)" />
  </Target>

  <Target Name="RedBoltExcludeBuildToolsFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(RelativePath)' == 'RedBolt.Generator.Dependencies.deps.json' or '%(RelativePath)' == 'RedBolt.Generator.Dependencies.runtimeconfig.json'" />
    </ItemGroup>
  </Target>

  <Target Name="RedBoltConfigureWebPInvokeModules" BeforeTargets="_GenerateManagedToNative">
    <ItemGroup>
      <_WasmPInvokeModules Include="RedBolt.Native.Sdl;RedBolt.Native.Diligent;RedBolt.Native.DearImGui;RedBolt.Native.Stb;RedBolt.Native.TinyGltf;RedBolt.Native.Lz4;RedBolt.Native.HarfBuzz;RedBolt.Native.RmlUi;RedBolt.Native.WebP;RedBolt.Native.Glslang;RedBolt.Native.SpirVCross;RedBolt.Native.SpirVTools;RedBolt.Native.ShaderCompiler;RedBolt.Native.Jolt" />
    </ItemGroup>
  </Target>

  <Target Name="RedBoltPublishWebAfterBuild"
          AfterTargets="Build"
          Inputs="$(TargetPath);$(RedBoltWebEngineArchive);@(ReferenceCopyLocalPaths);@(Content);$(RedBoltWebCoreDataPackage);$(RedBoltWebDataPackage)"
          Outputs="$(RedBoltWebOutputDir)/wwwroot/index.html"
          Condition="'$(RedBoltPublishWebAfterBuild)' != 'false' and '$(RedBoltPublishWebInProgress)' != 'true'">
    <RemoveDir Directories="$(RedBoltWebOutputDir)" />
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Publish"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=browser-wasm;RedBoltPublishWebInProgress=true;BuildProjectReferences=false" />
    <Touch Files="$(RedBoltWebOutputDir)/wwwroot/index.html" />
  </Target>

  <Target Name="RedBoltPrepareWebOutputDirectories"
          AfterTargets="RedBoltPublishWebAfterBuild">
    <MakeDir Directories="$(RedBoltWebOutputDir)/pdb;$(RedBoltWebOutputDir)/runtimes" />
  </Target>
</Project>
