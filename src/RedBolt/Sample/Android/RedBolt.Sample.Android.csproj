<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RedBolt.Sample.Android</AssemblyName>
    <ApplicationId>org.redbolt.samples</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidStripNativeLibraries>true</AndroidStripNativeLibraries>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <OutputType>Exe</OutputType>
    <RedBoltTargetFramework>net10.0-android</RedBoltTargetFramework>
    <TargetFramework>$(RedBoltTargetFramework)</TargetFramework>
    <RedBoltAndroidRuntimeIdentifiers Condition="'$(RedBoltAndroidRuntimeIdentifiers)' == ''">android-arm64;android-x64</RedBoltAndroidRuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(RedBoltPlatform)</RuntimeIdentifier>
    <RuntimeIdentifiers>$(RuntimeIdentifier)</RuntimeIdentifiers>
    <RedBoltBuildAllAndroidPackages Condition="'$(RedBoltBuildAllAndroidPackages)' == ''">true</RedBoltBuildAllAndroidPackages>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <TrimMode>partial</TrimMode>
    <RedBoltAndroidNativeOutput>$(RedBoltNativeOutputRoot)</RedBoltAndroidNativeOutput>
    <RedBoltAndroidNdkTriple Condition="'$(RedBoltPlatform)' == 'android-arm64'">aarch64-linux-android</RedBoltAndroidNdkTriple>
    <RedBoltAndroidNdkTriple Condition="'$(RedBoltPlatform)' == 'android-x64'">x86_64-linux-android</RedBoltAndroidNdkTriple>
    <RedBoltAndroidJavaDirectory>$(RedBoltBuildRoot)/native/$(RedBoltPlatform)/generated/android/java</RedBoltAndroidJavaDirectory>
    <RedBoltAndroidPackageOutputDirectory>$(RedBoltOutputRoot)/app</RedBoltAndroidPackageOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Core/RedBolt.Core.csproj" />
    <ProjectReference Include="../../Actions/RedBolt.Actions.csproj" />
    <ProjectReference Include="../../Audio/RedBolt.Audio.csproj" />
    <ProjectReference Include="../../IK/RedBolt.IK.csproj" />
    <ProjectReference Include="../../PhysicsJolt/RedBolt.PhysicsJolt.csproj" />
    <ProjectReference Include="../../Navigation/RedBolt.Navigation.csproj" />
    <ProjectReference Include="../../Network/RedBolt.Network.csproj" />
    <ProjectReference Include="../../DearImGui/RedBolt.DearImGui.csproj" />
    <ProjectReference Include="../../RmlUI/RedBolt.RmlUI.csproj" />
    <ProjectReference Include="../../Generator/Reflection/RedBolt.Generator.Reflection.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RedBoltPlatform;RedBoltNativePreset;RedBoltTargetFramework" />
    <Compile Include="../**/*.cs"
             Exclude="../Android/**/*.cs;../Web/**/*.cs;../WebRTCSTUN/**/*.cs;../WindowSettings/**/*.cs"
             Link="Samples/%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj"
                      PrivateAssets="all"
                      AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
  </ItemGroup>

  <Target Name="RedBoltConfigureAndroidRuntimeRestore"
          BeforeTargets="_FilterRestoreGraphProjectInputItems;_GenerateRestoreProjectPathItemsPerFramework;_GenerateProjectRestoreGraphPerFramework">
    <PropertyGroup>
      <RuntimeIdentifiers>$(RedBoltAndroidRuntimeIdentifiers)</RuntimeIdentifiers>
    </PropertyGroup>
  </Target>

  <Target Name="RedBoltPrepareAndroidRuntime"
          BeforeTargets="_CollectJavaSourceForBinding">
    <MSBuild Projects="$(RedBoltRoot)/src/RedBolt/Native/RedBolt.Native.Android.csproj"
             Targets="Build"
             BuildInParallel="false"
             Condition="'$(RedBoltBuildAndroidNative)' != 'false'"
             Properties="Configuration=$(Configuration);RedBoltPlatform=$(RedBoltPlatform);RedBoltNativePreset=$(RedBoltPlatform);RedBoltTargetFramework=$(RedBoltTargetFramework);AndroidSdkDirectory=$(AndroidSdkDirectory);AndroidNdkDirectory=$(AndroidNdkDirectory);JavaSdkDirectory=$(JavaSdkDirectory)" />
    <Error Condition="'$(RedBoltAndroidNdkTriple)' == ''"
           Text="Unsupported Android platform '$(RedBoltPlatform)'." />
    <Copy SourceFiles="$(AndroidNdkDirectory)/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/$(RedBoltAndroidNdkTriple)/libc++_shared.so"
          DestinationFiles="$(RedBoltAndroidNativeOutput)/libc++_shared.so"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <AndroidJavaSource Include="$(RedBoltAndroidJavaDirectory)/**/*.java" Bind="false" />
      <AndroidJavaSource Update="$(RedBoltAndroidJavaDirectory)/org/libsdl/app/SDLActivity.java" Bind="true" />
    </ItemGroup>
  </Target>

  <Target Name="RedBoltCollectAndroidNativeLibraries"
          BeforeTargets="_BuildApkEmbed;_BuildApkFastDev"
          DependsOnTargets="RedBoltPrepareAndroidRuntime">
    <ItemGroup>
      <AndroidNativeLibrary Include="$(RedBoltAndroidNativeOutput)/*.so" />
    </ItemGroup>
  </Target>

  <Target Name="RedBoltFinalizeAndroidPackage" AfterTargets="Build">
    <PropertyGroup>
      <_RedBoltSignedApk>$(RedBoltOutputDir)/$(ApplicationId)-Signed.apk</_RedBoltSignedApk>
      <_RedBoltPackagedApk>$(RedBoltAndroidPackageOutputDirectory)/RedBolt.Sample.Android.apk</_RedBoltPackagedApk>
    </PropertyGroup>
    <Error Condition="!Exists('$(_RedBoltSignedApk)')"
           Text="Android package was not produced at '$(_RedBoltSignedApk)'." />
    <MakeDir Directories="$(RedBoltAndroidPackageOutputDirectory)" />
    <Copy SourceFiles="$(_RedBoltSignedApk)"
          DestinationFiles="$(_RedBoltPackagedApk)"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Android package: $(_RedBoltPackagedApk)" />
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Build"
             BuildInParallel="false"
             Condition="'$(BuildingSolutionFile)' != 'true' and '$(RedBoltPlatform)' == 'android-x64' and '$(RedBoltBuildAllAndroidPackages)' == 'true' and '$(RedBoltAndroidPackageInnerBuild)' != 'true'"
             Properties="Configuration=$(Configuration);RedBoltPlatform=android-arm64;RedBoltNativePreset=android-arm64;RedBoltBuildAllAndroidPackages=false;RedBoltAndroidPackageInnerBuild=true" />
  </Target>

  <ItemGroup>
    <AndroidAsset Include="../../../../bin/CoreData/**/*"
                  Link="CoreData/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="../../../../bin/Data/**/*"
                  Link="Data/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
