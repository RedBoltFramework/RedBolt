<Project>
  <Import Project="$(MSBuildThisFileDirectory)../../Directory.Build.targets" />

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/Platform/Linux/RedBolt.Platform.Linux.csproj" />
  </ItemGroup>

  <Target Name="RedBoltAddNativeFilesToPublish"
          AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="RedBoltConfigureRuntimeAssemblies"
          Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_RedBoltNativeAssets)">
        <RelativePath>runtimes/$(RuntimeIdentifier)/native/%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Compile Include="$(RedBoltRoot)/src/RedBolt/RedBolt/GlobalAliases.cs"
             Link="GlobalAliases.cs"
             Visible="false" />
  </ItemGroup>
</Project>
