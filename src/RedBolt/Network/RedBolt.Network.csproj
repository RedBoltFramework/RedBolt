<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RedBolt.Network</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Core/RedBolt.Core.csproj" />
    <ProjectReference Include="../Native/LibDataChannel/RedBolt.Bindings.LibDataChannel.csproj"
                      Condition="'$(RedBoltPlatform)' != 'browser-wasm'" />
    <ProjectReference Include="../Generator/Reflection/RedBolt.Generator.Reflection.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RedBoltPlatform;RedBoltNativePreset" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Core/GlobalUsings.cs" Link="GlobalUsings.cs" Visible="false" />
    <Compile Remove="Network/Transport/DataChannel/DataChannelConnection.cs;Network/Transport/DataChannel/DataChannelInterop.cs;Network/Transport/DataChannel/DataChannelServer.cs"
             Condition="'$(RedBoltPlatform)' == 'browser-wasm'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj"
                      PrivateAssets="all"
                      AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
  </ItemGroup>
</Project>
