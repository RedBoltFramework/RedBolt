<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RedBolt.DearImGui</AssemblyName>
    <EnableLibraryImportGenerator>true</EnableLibraryImportGenerator>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Core/RedBolt.Core.csproj" />
    <ProjectReference Include="../Native/DearImGui/RedBolt.Bindings.DearImGui.csproj" />
    <ProjectReference Include="../Native/Sdl/RedBolt.Bindings.Sdl.csproj" />
    <ProjectReference Include="../Utility/RedBolt.Utility.csproj" Condition="'$(RedBoltPlatform)' != 'browser-wasm' and !$([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-'))" />
    <ProjectReference Include="../Generator/Reflection/RedBolt.Generator.Reflection.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RedBoltPlatform" />
  </ItemGroup>

  <ItemGroup Condition="'$(RedBoltPlatform)' == 'browser-wasm' or $([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-'))">
    <Compile Remove="SystemUI/**/*.cs" />
    <Compile Include="SystemUI/ImGui.cs" />
    <Compile Include="SystemUI/Widgets.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj" PrivateAssets="all" AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
  </ItemGroup>
</Project>
