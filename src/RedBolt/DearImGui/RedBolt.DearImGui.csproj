<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RedBolt.DearImGui</AssemblyName>
    <EnableLibraryImportGenerator>true</EnableLibraryImportGenerator>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../RedBolt/RedBolt.csproj" />
    <ProjectReference Include="../Bindings/DearImGui/RedBolt.Bindings.DearImGui.csproj" />
    <ProjectReference Include="../Bindings/Sdl/RedBolt.Bindings.Sdl.csproj" />
    <ProjectReference Include="../Utility/RedBolt.Utility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj"
                      PrivateAssets="all"
                      AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
  </ItemGroup>
</Project>
