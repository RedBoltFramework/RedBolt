<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RedBolt</AssemblyName>
    <EnableLibraryImportGenerator>true</EnableLibraryImportGenerator>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <ProjectReference Include="../RedBolt.Bindings.Diligent/RedBolt.Bindings.Diligent.csproj" />
    <ProjectReference Include="../RedBolt.Bindings.Glslang/RedBolt.Bindings.Glslang.csproj" />
    <ProjectReference Include="../RedBolt.Bindings.ShaderCompiler/RedBolt.Bindings.ShaderCompiler.csproj" />
    <ProjectReference Include="../RedBolt.Bindings.Sdl/RedBolt.Bindings.Sdl.csproj" />
    <ProjectReference Include="../RedBolt.Bindings.SpirVCross/RedBolt.Bindings.SpirVCross.csproj" />
    <ProjectReference Include="../RedBolt.Bindings.SpirVTools/RedBolt.Bindings.SpirVTools.csproj" />
    <ProjectReference Include="../RedBolt.Bindings.Stb/RedBolt.Bindings.Stb.csproj" />
    <ProjectReference Include="../RedBolt.Bindings.Lz4/RedBolt.Bindings.Lz4.csproj" />
    <ProjectReference Include="../RedBolt.Bindings.WebP/RedBolt.Bindings.WebP.csproj" />
    <ProjectReference Include="../../generators/RedBolt.Reflection.Generator/RedBolt.Reflection.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      RedBoltProperties="Configuration=$(Configuration);RedBoltPlatform=tools;RedBoltNativePreset=" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj"
                      PrivateAssets="all"
                      RedBoltProperties="$(RedBoltSharpCppManagedProperties)" />
  </ItemGroup>
</Project>
