<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>RedBolt.Glow</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Bindings/XAtlas/RedBolt.Bindings.XAtlas.csproj" />
    <ProjectReference Include="../Bindings/Embree/RedBolt.Bindings.Embree.csproj" />
    <ProjectReference Include="../RedBolt/RedBolt.csproj" />
    <ProjectReference Include="../Generator/Reflection/RedBolt.Generator.Reflection.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RedBoltPlatform;RedBoltNativePreset" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj"
                      PrivateAssets="all"
                      AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
  </ItemGroup>
</Project>
