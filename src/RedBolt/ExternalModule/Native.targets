<Project>
  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('RedBolt.Bindings.'))">
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Std/SharpCpp.Std.csproj" PrivateAssets="all" AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj" PrivateAssets="all" AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
    <ProjectReference Include="$(RedBoltExternalModuleRoot)/src/RedBolt/Native/$(RedBoltExternalModuleName).Native.csproj"
                      Condition="'$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64'" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="$(RedBoltExternalModuleRoot)/src/RedBolt/Native/$(RedBoltExternalModuleName).Native.Web.csproj"
                      Condition="'$(RedBoltPlatform)' == 'browser-wasm'" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="$(RedBoltExternalModuleRoot)/src/RedBolt/Native/$(RedBoltExternalModuleName).Native.Android.csproj"
                      Condition="$([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-'))"
                      ReferenceOutputAssembly="false" PrivateAssets="all"
                      AdditionalProperties="RedBoltPlatform=$(RedBoltPlatform);RedBoltNativePreset=$(RedBoltNativePreset);RedBoltTargetFramework=$(RedBoltTargetFramework);AndroidSdkDirectory=$(AndroidSdkDirectory);AndroidNdkDirectory=$(AndroidNdkDirectory);JavaSdkDirectory=$(JavaSdkDirectory)" />
  </ItemGroup>
  <Target Name="RedBoltExternalIncludeGeneratedBindings" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Include="$(RedBoltGeneratedBindingsDir)/$(RedBoltExternalBindingsSubdirectory)/**/*.g.cs"
               Exclude="@(Compile)" LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == '$(RedBoltExternalBindingsProjectName)'" />
    </ItemGroup>
  </Target>
</Project>
