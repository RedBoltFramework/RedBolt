<Project>
  <Import Project="$(MSBuildThisFileDirectory)../../Directory.Build.targets" />
  <Import Project="$(RedBoltRoot)/src/RedBolt/Native/RedBolt.Native.targets" />

  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('RedBolt.Bindings.'))">
    <!-- Shared standard-library wrappers live outside generated modules. Every
         binding module gets the contracts/types so generated provider glue can
         register against the process-wide registry. -->
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Std/SharpCpp.Std.csproj"
                      PrivateAssets="all"
                      AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj"
                      PrivateAssets="all"
                      AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/Native/RedBolt.Native.csproj"
                      Condition="'$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64'"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/Native/RedBolt.Native.Web.csproj"
                      Condition="'$(RedBoltPlatform)' == 'browser-wasm'"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/Native/RedBolt.Native.Android.csproj"
                      Condition="$([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-'))"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      AdditionalProperties="RedBoltPlatform=$(RedBoltPlatform);RedBoltNativePreset=$(RedBoltNativePreset);RedBoltTargetFramework=$(RedBoltTargetFramework);AndroidSdkDirectory=$(AndroidSdkDirectory);AndroidNdkDirectory=$(AndroidNdkDirectory);JavaSdkDirectory=$(JavaSdkDirectory)" />
  </ItemGroup>

  <Target Name="RedBoltBuildNativeLibrary"
          DependsOnTargets="ResolveReferences;RedBoltStageNativeResources;RedBoltBuildCMakeTarget"
          Condition="'$(RedBoltProjectBuildEnabled)' == 'true'
                     and '$(RedBoltCMakeTarget)' != ''" />
  <Target Name="RedBoltBuildNativeSdl"
          BeforeTargets="CoreCompile"
          DependsOnTargets="RedBoltBuildNativeLibrary"
          Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.Sdl'" />
  <Target Name="RedBoltBuildNativeDiligent"
          BeforeTargets="CoreCompile"
          DependsOnTargets="RedBoltBuildNativeLibrary"
          Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.Diligent'" />
  <Target Name="RedBoltBuildNativeDearImGui"
          BeforeTargets="CoreCompile"
          DependsOnTargets="RedBoltBuildNativeLibrary"
          Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.DearImGui'" />
  <Target Name="RedBoltBuildNativeStb"
          BeforeTargets="CoreCompile"
          DependsOnTargets="RedBoltBuildNativeLibrary"
          Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.Stb'" />
  <Target Name="RedBoltBuildNativeTinyGltf"
          BeforeTargets="CoreCompile"
          DependsOnTargets="RedBoltBuildNativeLibrary"
          Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.TinyGltf'" />
  <Target Name="RedBoltBuildNativeLz4"
          BeforeTargets="CoreCompile"
          DependsOnTargets="RedBoltBuildNativeLibrary"
          Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.Lz4'" />
  <Target Name="RedBoltBuildNativeHarfBuzz"
          BeforeTargets="CoreCompile"
          DependsOnTargets="RedBoltBuildNativeLibrary"
          Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.HarfBuzz'" />
  <Target Name="RedBoltBuildNativeWebP"
          BeforeTargets="CoreCompile"
          DependsOnTargets="RedBoltBuildNativeLibrary"
          Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.WebP'" />
  <Target Name="RedBoltBuildNativeGlslang"
          BeforeTargets="CoreCompile"
          DependsOnTargets="RedBoltBuildNativeLibrary"
          Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.Glslang'" />
  <Target Name="RedBoltBuildNativeSpirVCross"
          BeforeTargets="CoreCompile"
          DependsOnTargets="RedBoltBuildNativeLibrary"
          Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.SpirVCross'" />
  <Target Name="RedBoltBuildNativeSpirVTools"
          BeforeTargets="CoreCompile"
          DependsOnTargets="RedBoltBuildNativeLibrary"
          Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.SpirVTools'" />
  <Target Name="RedBoltBuildNativeShaderCompiler"
          BeforeTargets="CoreCompile"
          DependsOnTargets="RedBoltBuildNativeLibrary"
          Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.ShaderCompiler'" />

        <Target Name="RedBoltIncludeGeneratedBindings"
                                        BeforeTargets="CoreCompile"
                                        DependsOnTargets="RedBoltBuildNativeLibrary"
                                        Condition="'$(RedBoltNativeModuleName)' != ''">
    <ItemGroup>
                        <Compile Include="$(RedBoltGeneratedBindingsDir)/$(RedBoltNativeModuleName)/**/*.g.cs"
               Exclude="@(Compile)"
                                                         LinkBase="Generated" />
    </ItemGroup>
  </Target>
</Project>
