<Project>
  <Import Project="$(MSBuildThisFileDirectory)../../Directory.Build.targets" />
  <Import Project="$(RedBoltRoot)/src/RedBolt/Native/NativeBuild.targets" />

  <!--
    Binding projects reference the SharpCpp runtime contracts (needed by all generated binding code)
    and the RedBolt.Native hub. The hub runs the CMake configure step and builds the native libraries
    of the platform one time, so a binding project only resolves its references.
  -->
  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('RedBolt.Bindings.'))">
    <!-- Shared standard-library wrappers live outside generated modules. Every
         binding module gets the contracts/types so generated provider glue can
         register against the process-wide registry. -->
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Std/SharpCpp.Std.csproj"
                      PrivateAssets="all"
                      AdditionalProperties="$(RedBoltSharpCppManagedProperties)"
                      GlobalPropertiesToRemove="$(RedBoltHostProjectGlobalPropertiesToRemove)" />
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj"
                      PrivateAssets="all"
                      AdditionalProperties="$(RedBoltSharpCppManagedProperties)"
                      GlobalPropertiesToRemove="$(RedBoltHostProjectGlobalPropertiesToRemove)" />
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/Native/RedBolt.Native.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      PrivateAssets="all"
                      AdditionalProperties="RedBoltPlatform=$(RedBoltPlatform)"
                      GlobalPropertiesToRemove="$(RedBoltInnerBuildGlobalPropertiesToRemove)" />
  </ItemGroup>

  <!-- Adds the generated bindings that the hub's CMake build produces. -->
  <Target Name="RedBoltIncludeGeneratedBindings"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveReferences"
          Condition="'$(RedBoltNativeModuleName)' != ''">
    <ItemGroup>
      <Compile Include="$(RedBoltGeneratedBindingsDir)/$(RedBoltNativeModuleName)/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated" />
    </ItemGroup>
  </Target>
</Project>
