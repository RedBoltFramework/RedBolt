<Project>
  <Import Project="$(MSBuildThisFileDirectory)../../Directory.Build.targets" />

  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('RedBolt.Bindings.'))">
    <!-- Shared standard-library wrappers live outside generated modules. Every
         binding module gets the contracts/types so generated provider glue can
         register against the process-wide registry. -->
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Std/SharpCpp.Std.csproj"
                      PrivateAssets="all"
                      AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj"
                      PrivateAssets="all"
                      AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/Native/RedBolt.Native.csproj"
                      Condition="'$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64'"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/Native/RedBolt.Native.Web.csproj"
                      Condition="'$(RedBoltPlatform)' == 'browser-wasm'"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/Native/RedBolt.Native.Android.csproj"
                      Condition="$([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-'))"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      AdditionalProperties="RedBoltPlatform=$(RedBoltPlatform);RedBoltNativePreset=$(RedBoltNativePreset);RedBoltTargetFramework=$(RedBoltTargetFramework);AndroidSdkDirectory=$(AndroidSdkDirectory);AndroidNdkDirectory=$(AndroidNdkDirectory);JavaSdkDirectory=$(JavaSdkDirectory)" />
  </ItemGroup>

  <Target Name="RedBoltIncludeGeneratedBindings" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Include="$(RedBoltGeneratedBindingsDir)/sdl/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.Sdl'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/diligent/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.Diligent'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/dearimgui/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.DearImGui'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/stb/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.Stb'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/tinygltf/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.TinyGltf'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/lz4/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.Lz4'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/harfbuzz/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.HarfBuzz'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/rmlui/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.RmlUi'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/webp/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.WebP'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/xatlas/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.XAtlas'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/embree/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.Embree'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/glslang/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.Glslang'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/spirv-cross/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.SpirVCross'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/spirv-tools/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.SpirVTools'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/shader-compiler/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.ShaderCompiler'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/box2d/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.Box2D'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/jolt/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.Jolt'" />
      <Compile Include="$(RedBoltGeneratedBindingsDir)/libdatachannel/**/*.g.cs"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Condition="'$(MSBuildProjectName)' == 'RedBolt.Bindings.LibDataChannel'" />
    </ItemGroup>
  </Target>
</Project>
