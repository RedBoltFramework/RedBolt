<Project>
  <PropertyGroup>
    <RedBoltCMakeTarget Condition="'$(RedBoltPlatform)' == 'linux-x64'">redbolt-native-all</RedBoltCMakeTarget>
    <RedBoltCMakeTarget Condition="'$(RedBoltPlatform)' == 'win-x64'">redbolt-native-all</RedBoltCMakeTarget>
    <RedBoltCMakeTarget Condition="'$(RedBoltPlatform)' == 'browser-wasm'">redbolt-wasm-native</RedBoltCMakeTarget>
    <RedBoltCMakeTarget Condition="$([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-'))">redbolt-android-native</RedBoltCMakeTarget>
    <RedBoltCMakeConfigurationArguments Condition="'$(RedBoltPlatform)' == 'linux-x64'">--config &quot;$(Configuration)&quot;</RedBoltCMakeConfigurationArguments>
    <RedBoltCMakeConfigurationArguments Condition="'$(RedBoltPlatform)' == 'win-x64'">--config &quot;$(Configuration)&quot;</RedBoltCMakeConfigurationArguments>
    <RedBoltAndroidNdkTriple Condition="'$(RedBoltPlatform)' == 'android-arm64'">aarch64-linux-android</RedBoltAndroidNdkTriple>
    <RedBoltAndroidNdkTriple Condition="'$(RedBoltPlatform)' == 'android-x64'">x86_64-linux-android</RedBoltAndroidNdkTriple>
  </PropertyGroup>

  <Target Name="RedBoltBuildNative" AfterTargets="Build" Condition="'$(RedBoltProjectBuildEnabled)' == 'true'">
    <Error Condition="'$(RedBoltNativePreset)' == ''"
           Text="No native preset is configured for '$(RedBoltPlatform)'." />
    <Error Condition="'$(RedBoltCMakeTarget)' == ''"
           Text="No CMake target is configured for '$(RedBoltPlatform)'." />
    <Error Condition="!Exists('$(RedBoltSharpCppRoot)')"
           Text="SharpCpp was not found at '$(RedBoltSharpCppRoot)'." />
    <Error Condition="!Exists('$(RedBoltHostToolsOutputDir)/RedBolt.Generator.Dependencies.dll')"
           Text="The RedBolt dependency generator was not built at '$(RedBoltHostToolsOutputDir)/RedBolt.Generator.Dependencies.dll'." />
    <MakeDir Directories="$(RedBoltBuildRoot);$(RedBoltOutputDir);$(RedBoltIntermediateRoot)" />
    <MakeDir Condition="'$(RedBoltPlatform)' != 'browser-wasm'"
             Directories="$(RedBoltNativeOutputRoot)" />
    <Error Condition="$([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-')) and '$(RedBoltAndroidNdkTriple)' == ''"
           Text="Unsupported Android platform '$(RedBoltPlatform)'." />
    <Copy Condition="$([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-'))"
          SourceFiles="$(AndroidNdkDirectory)/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/$(RedBoltAndroidNdkTriple)/libc++_shared.so"
          DestinationFiles="$(RedBoltNativeOutputRoot)/libc++_shared.so"
          SkipUnchangedFiles="true" />
    <Exec WorkingDirectory="$(RedBoltRoot)"
          IgnoreStandardErrorWarningFormat="true"
          Command="cmake -E env ANDROID_NDK_ROOT=&quot;$(AndroidNdkDirectory)&quot; cmake -DREDBOLT_SOURCE_DIR=&quot;$(RedBoltRoot)&quot; -DREDBOLT_NATIVE_PRESET=&quot;$(RedBoltNativePreset)&quot; -DREDBOLT_NATIVE_BUILD_DIR=&quot;$(RedBoltNativeBuildDir)&quot; -DREDBOLT_NATIVE_TARGET=&quot;$(RedBoltCMakeTarget)&quot; -DREDBOLT_CONFIGURATION=&quot;$(Configuration)&quot; -DREDBOLT_ENABLED_NATIVE_MODULES=&quot;$(RedBoltEnabledNativeModules)&quot; -DREDBOLT_SHARPCPP_ROOT=&quot;$(RedBoltSharpCppRoot)&quot; -DREDBOLT_GENERATOR_DLL=&quot;$(RedBoltHostToolsOutputDir)/RedBolt.Generator.Dependencies.dll&quot; -DREDBOLT_RUNTIME_OUTPUT_DIR=&quot;$(RedBoltNativeOutputRoot)&quot; -DREDBOLT_PDB_OUTPUT_DIR=&quot;$(RedBoltNativePdbOutputRoot)&quot; -P &quot;$(MSBuildThisFileDirectory)BuildNative.cmake&quot;" />
    <Exec Condition="'$(RedBoltPlatform)' == 'linux-x64' and !Exists('$(RedBoltOutputRoot)/CoreData')"
          Command="cmake -E create_symlink &quot;$(RedBoltRoot)/bin/CoreData&quot; &quot;$(RedBoltOutputRoot)/CoreData&quot;" />
    <Exec Condition="'$(RedBoltPlatform)' == 'linux-x64' and !Exists('$(RedBoltOutputRoot)/Data')"
          Command="cmake -E create_symlink &quot;$(RedBoltRoot)/bin/Data&quot; &quot;$(RedBoltOutputRoot)/Data&quot;" />
    <Exec Condition="'$(RedBoltPlatform)' == 'linux-x64' and !Exists('$(RedBoltOutputRoot)/EditorData')"
          Command="cmake -E create_symlink &quot;$(RedBoltRoot)/bin/EditorData&quot; &quot;$(RedBoltOutputRoot)/EditorData&quot;" />
  </Target>

  <Target Name="RedBoltCleanNative" AfterTargets="Clean">
    <Exec WorkingDirectory="$(RedBoltRoot)"
          Condition="Exists('$(RedBoltNativeBuildDir)/CMakeCache.txt')"
          Command="cmake -E env REDBOLT_MSBUILD_BUILD=1 cmake --build &quot;$(RedBoltNativeBuildDir)&quot; $(RedBoltCMakeConfigurationArguments) --target clean" />
  </Target>
</Project>
