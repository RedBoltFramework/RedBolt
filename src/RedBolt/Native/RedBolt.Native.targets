<Project>
  <PropertyGroup>
    <RedBoltCMakeConfigurationArguments Condition="'$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64'">--config &quot;$(Configuration)&quot;</RedBoltCMakeConfigurationArguments>
    <RedBoltAndroidNdkTriple Condition="'$(RedBoltPlatform)' == 'android-arm64'">aarch64-linux-android</RedBoltAndroidNdkTriple>
    <RedBoltAndroidNdkTriple Condition="'$(RedBoltPlatform)' == 'android-x64'">x86_64-linux-android</RedBoltAndroidNdkTriple>
    <RedBoltNativeModuleTargetSuffix Condition="'$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64'">-module</RedBoltNativeModuleTargetSuffix>
    <RedBoltCMakeTarget Condition="'$(MSBuildProjectName)' == 'RedBolt.Native.Web'">redbolt-wasm-native</RedBoltCMakeTarget>
    <RedBoltCMakeTarget Condition="'$(MSBuildProjectName)' == 'RedBolt.Native.Android'">redbolt-android-native</RedBoltCMakeTarget>
        <RedBoltCMakeTarget Condition="'$(RedBoltCMakeTarget)' == '' and '$(RedBoltNativeModuleName)' != ''">redbolt-native-$(RedBoltNativeModuleName)$(RedBoltNativeModuleTargetSuffix)</RedBoltCMakeTarget>
  </PropertyGroup>

  <Target Name="RedBoltConfigureNative" AfterTargets="Build"
          Condition="'$(RedBoltProjectBuildEnabled)' == 'true'
                     and ('$(MSBuildProjectName)' == 'RedBolt.Native'
                          or '$(MSBuildProjectName)' == 'RedBolt.Native.Web'
                          or '$(MSBuildProjectName)' == 'RedBolt.Native.Android')">
    <Error Condition="'$(RedBoltNativePreset)' == ''" Text="No native preset is configured for '$(RedBoltPlatform)'." />
    <Error Condition="!Exists('$(RedBoltSharpCppRoot)')" Text="SharpCpp was not found at '$(RedBoltSharpCppRoot)'." />
    <Error Condition="!Exists('$(RedBoltHostToolsOutputDir)/RedBolt.Generator.Dependencies.dll')" Text="The RedBolt dependency generator was not built at '$(RedBoltHostToolsOutputDir)/RedBolt.Generator.Dependencies.dll'." />
    <MakeDir Directories="$(RedBoltBuildRoot);$(RedBoltOutputDir);$(RedBoltIntermediateRoot);$(RedBoltNativeOutputRoot)" />
    <Error Condition="$([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-')) and '$(RedBoltAndroidNdkTriple)' == ''" Text="Unsupported Android platform '$(RedBoltPlatform)'." />
    <Copy Condition="$([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-'))"
          SourceFiles="$(AndroidNdkDirectory)/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/$(RedBoltAndroidNdkTriple)/libc++_shared.so"
          DestinationFiles="$(RedBoltNativeOutputRoot)/libc++_shared.so"
          SkipUnchangedFiles="true" />
    <Exec WorkingDirectory="$(RedBoltRoot)"
          IgnoreStandardErrorWarningFormat="true"
          Command="cmake -E env ANDROID_NDK_ROOT=&quot;$(AndroidNdkDirectory)&quot; cmake -DREDBOLT_SOURCE_DIR=&quot;$(RedBoltRoot)&quot; -DREDBOLT_NATIVE_PRESET=&quot;$(RedBoltNativePreset)&quot; -DREDBOLT_NATIVE_BUILD_DIR=&quot;$(RedBoltNativeBuildDir)&quot; -DREDBOLT_CONFIGURATION=&quot;$(Configuration)&quot; -DREDBOLT_ENABLED_NATIVE_MODULES=&quot;$(RedBoltEnabledNativeModules)&quot; -DREDBOLT_ENABLE_OPENXR=&quot;$(RedBoltOpenXREnabled)&quot; -DREDBOLT_SHARPCPP_ROOT=&quot;$(RedBoltSharpCppRoot)&quot; -DREDBOLT_GENERATOR_DLL=&quot;$(RedBoltHostToolsOutputDir)/RedBolt.Generator.Dependencies.dll&quot; -DREDBOLT_RUNTIME_OUTPUT_DIR=&quot;$(RedBoltNativeOutputRoot)&quot; -DREDBOLT_PDB_OUTPUT_DIR=&quot;$(RedBoltNativePdbOutputRoot)&quot; -P &quot;$(MSBuildThisFileDirectory)ConfigureNative.cmake&quot;" />
  </Target>

  <Target Name="RedBoltBuildCMakeTarget">
    <Error Condition="'$(RedBoltCMakeTarget)' == ''" Text="No CMake target was provided for '$(RedBoltPlatform)'." />
    <Error Condition="!Exists('$(RedBoltNativeBuildDir)/CMakeCache.txt')" Text="The native build directory was not configured at '$(RedBoltNativeBuildDir)'." />
        <Message Importance="High"
                         Text="Building native library target '$(RedBoltCMakeTarget)' for $(MSBuildProjectName)." />
    <Exec WorkingDirectory="$(RedBoltRoot)"
          IgnoreStandardErrorWarningFormat="true"
          Command="cmake -E env ANDROID_NDK_ROOT=&quot;$(AndroidNdkDirectory)&quot; cmake -DREDBOLT_SOURCE_DIR=&quot;$(RedBoltRoot)&quot; -DREDBOLT_NATIVE_PRESET=&quot;$(RedBoltNativePreset)&quot; -DREDBOLT_NATIVE_BUILD_DIR=&quot;$(RedBoltNativeBuildDir)&quot; -DREDBOLT_NATIVE_TARGET=&quot;$(RedBoltCMakeTarget)&quot; -DREDBOLT_CONFIGURATION=&quot;$(Configuration)&quot; -DREDBOLT_PARALLELIZATION=&quot;$(RedBoltParallelization)&quot; -P &quot;$(MSBuildThisFileDirectory)BuildNative.cmake&quot;" />
  </Target>

  <Target Name="RedBoltStageNativeResources">
    <Exec Condition="'$(RedBoltPlatform)' == 'linux-x64' and !Exists('$(RedBoltOutputRoot)/CoreData')" Command="cmake -E create_symlink &quot;$(RedBoltRoot)/bin/CoreData&quot; &quot;$(RedBoltOutputRoot)/CoreData&quot;" />
    <Exec Condition="'$(RedBoltPlatform)' == 'linux-x64' and !Exists('$(RedBoltOutputRoot)/Data')" Command="cmake -E create_symlink &quot;$(RedBoltRoot)/bin/Data&quot; &quot;$(RedBoltOutputRoot)/Data&quot;" />
    <Exec Condition="'$(RedBoltPlatform)' == 'linux-x64' and !Exists('$(RedBoltOutputRoot)/EditorData')" Command="cmake -E create_symlink &quot;$(RedBoltRoot)/bin/EditorData&quot; &quot;$(RedBoltOutputRoot)/EditorData&quot;" />
  </Target>

  <Target Name="RedBoltBuildNativeWebArchive"
          DependsOnTargets="Build;RedBoltBuildCMakeTarget" />
  <Target Name="RedBoltBuildNativeAndroidRuntime"
          DependsOnTargets="Build;RedBoltBuildCMakeTarget"
          Condition="'$(RedBoltProjectBuildEnabled)' == 'true'" />

  <Target Name="RedBoltCleanNative" AfterTargets="Clean"
          Condition="'$(MSBuildProjectName)' == 'RedBolt.Native'
                     or '$(MSBuildProjectName)' == 'RedBolt.Native.Web'
                     or '$(MSBuildProjectName)' == 'RedBolt.Native.Android'">
    <Exec WorkingDirectory="$(RedBoltRoot)"
          Condition="Exists('$(RedBoltNativeBuildDir)/CMakeCache.txt')"
          Command="cmake -E env REDBOLT_MSBUILD_BUILD=1 cmake --build &quot;$(RedBoltNativeBuildDir)&quot; $(RedBoltCMakeConfigurationArguments) --target clean" />
  </Target>
</Project>
